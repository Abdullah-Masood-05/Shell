{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (Slint from source, static, no runtime DLLs)",
      "inherits": "x64-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "SETTINGS_SLINT_FROM_SOURCE": "ON"
      }
    },
    {
      "name": "x64-release-prebuilt",
      "displayName": "x64 Release (prebuilt Slint SDK: needs slint_cpp.dll and the VC++ runtime)",
      "inherits": "x64-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "SETTINGS_SLINT_FROM_SOURCE": "OFF"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (prebuilt Slint SDK)",
      "inherits": "x64-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "SETTINGS_SLINT_FROM_SOURCE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release"
    },
    {
      "name": "x64-release-prebuilt",
      "configurePreset": "x64-release-prebuilt",
      "configuration": "Release"
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug"
    }
  ]
}
