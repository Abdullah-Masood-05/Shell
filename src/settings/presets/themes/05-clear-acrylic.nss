// Preset: Clear acrylic
// Tags: Acrylic, No tint
// About: Modern with plain acrylic and no background colour.
// Source: moudey, Nilesoft Shell issue #348
// https://github.com/moudey/Shell/issues/348, verbatim.
theme
{
	name="modern"
	dark=auto
	background
	{
		color=auto
		opacity=0
		effect=3
	}
}
