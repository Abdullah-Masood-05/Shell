// Preset: Shell 1.8
// Tags: Modern, Opaque
// About: The 2023 default: modern, without the blur effect.
// Source: Nilesoft Shell 1.8, config/shell.nss
// Verbatim from the theme block of config/shell.nss, upstream commit 26b7dfd
// (2023-01-19), where it sat inside shell { set { ... } }.
theme
{
	name="modern"
	background
	{
		//opacity=95
		effect=0
	}
	
	image
	{
		align=2
	}
	
	item.prefix=auto
}
