// Preset: Accent outline
// Tags: Border, Accent
// About: A 1 px accent-coloured border and accent icons.
// Source: moudey, Nilesoft Shell issue #162
// https://github.com/moudey/Shell/issues/162, verbatim.
theme
{
    image.color=[color.accent, color.accent_dark3]
    border
    {
        enabled = 1
        size = 1
        color =  color.accent
        opacity = 100
    }
}
