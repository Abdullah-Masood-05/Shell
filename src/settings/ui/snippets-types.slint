// Snippets page data shared with C++ (src/SnippetsController.cpp).

import { CodeLine } from "editor-types.slint";

// One snippet of the catalog, as the page lists it.
export struct SnippetRow {
    id: string,
    title: string,
    description: string,       // one line
    author: string,
    author-url: string,        // the "by ..." link, "" for none
    remote: bool,              // downloaded when turned on (RubicBG's)
    category: string,          // the category's label
    enabled: bool,             // turned on in the config
    available: bool,           // its requirements are met: the switch works
    needs: string,             // "Needs 7-Zip" when not available, else ""
    risk: string,              // admin | network | ""
    note: string,              // the user's copy: edited, missing, ...
    expanded: bool,            // showing its code
    code: [CodeLine],          // the .nss, highlighted (only while expanded)
    code-columns: int,
    code-status: string,       // a remote snippet's code: downloading, or why it couldn't be
}

export global SnippetsState {
    in property <bool> loaded;
    in property <string> load-error;
    in property <bool> shared-config;   // the install folder's config: read-only here
    in property <bool> busy;            // a switch is being checked and saved
    in property <string> busy-id;
    in property <[SnippetRow]> rows;    // the ones the search and the category let through
    in property <[string]> categories;  // "All" first
    in property <int> category;
    in property <string> summary;       // "3 of 12 on"
    in property <string> empty-text;    // when no row matches

    callback activated();
    callback search(text: string);
    callback set-category(index: int);
    callback toggle(id: string, on: bool);
    callback toggle-code(id: string);
    callback create-user-config();
}
