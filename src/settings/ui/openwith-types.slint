// The "Open with" page's data shared with C++ (src/OpenWithController.cpp).

import { CodeLine } from "editor-types.slint";

// One app in the list: a preset (VS Code, Zed, ...) or one the user added.
export struct OpenWithRow {
    name: string,
    detail: string,            // the program's path, or why it's missing
    found: bool,               // the program exists
    enabled: bool,
    custom: bool,
    icon: image,
    has-icon: bool,
    problem: string,           // why it stays out of the menu, or ""
    own: string,               // "Also hides: PowerShell 7 ›" (the app's own menu entries), or ""
}

// The selected app, for the editor under its row.
export struct OpenWithForm {
    name: string,
    exe: string,
    args: string,
    icon: string,
    scope: int,                // 0 everything the menu shows on, 1 files, 2 folders, 3 extensions
    extensions: string,
    admin: bool,
    custom: bool,
    keep-own: bool,            // switched off, its own menu entries stay
    own: string,               // their titles, "" when it has none
}

// One line of the Test result: "A file" -> the command line.
export struct OpenWithTestLine {
    label: string,
    command: string,
}

// One row of the preview menu.
export struct OpenWithPreviewRow {
    kind: string,              // menu | item | native (Explorer's own, dimmed) | native-menu | sep
    title: string,
    icon: image,
    has-icon: bool,
    open: bool,                // the submenu whose flyout is shown
}

// Another program's own item in the menu (Git, VLC, 7-Zip...), from the registry.
export struct OtherAppRow {
    title: string,             // as the menu shows it; a shell extension's is a guess
    detail: string,            // where it shows and which program adds it
    tag: string,               // "Shift only", "Shell extension", or ""
    shown: bool,               // false: a remove() rule hides it
    extension: bool,           // a shell extension: the app sets its title
    hide-title: string,        // the title the rule matches (shell extensions, while hidden)
    problem: string,           // why the rule can't match, or ""
    gone: bool,                // hidden, but no longer in the registry
    leftover: bool,            // its program or DLL is gone: left behind by an uninstaller
    section: string,           // a heading to show above this row, or ""
    icon: image,
    has-icon: bool,
}

export global OpenWithState {
    in property <bool> loaded;
    in property <string> load-error;
    in property <bool> shared-config;
    in property <string> notice;           // lines of the file that were not understood
    in property <bool> import-off;         // imported, but the line is commented out
    in property <bool> first-run;          // no file yet: found apps are on, not saved
    in property <int> found-count;
    in property <int> preset-count;

    in property <[OpenWithRow]> rows;
    in property <int> selected: -1;
    in property <OpenWithForm> form;
    in property <int> form-serial;         // bumped when the editor must reload its fields
    in property <bool> can-up;
    in property <bool> can-down;
    in property <int> missing-count;       // presets not found on this PC (listed last)
    in-out property <bool> show-missing;   // list them too

    // The menu
    in property <bool> submenu: false;
    in property <string> title;
    in property <bool> show-files;
    in property <bool> show-folders;
    in property <bool> show-background;
    in property <bool> show-desktop;
    in property <int> options-serial;
    in property <string> options-problem;

    // Test (the selected app)
    in property <bool> test-shown;
    in property <[OpenWithTestLine]> test-lines;
    in property <string> test-note;

    // Preview and the generated file
    in-out property <int> preview-kind;    // 0 a file, 1 a folder, 2 folder background
    in property <[OpenWithPreviewRow]> preview;
    in property <[OpenWithPreviewRow]> flyout;
    in property <string> preview-empty;
    in property <[CodeLine]> code;
    in property <int> code-columns: 60;
    in property <string> file-label;

    // develop.nss: the Develop > Editors submenu
    in property <bool> develop-found;
    in property <bool> develop-hidden;
    in property <bool> develop-locked;

    // Other apps' menu items
    in property <bool> others-loaded;
    in property <[OtherAppRow]> others;
    in property <int> others-hidden;       // switched off
    in property <int> others-leftovers;    // leftovers of uninstalled programs still shown

    in property <bool> dirty;
    in property <bool> saving;

    callback activated();
    callback select(index: int);
    callback toggle(index: int, on: bool);
    callback locate(index: int);
    callback move-up();
    callback move-down();
    callback add-custom();
    callback remove();
    callback browse-program();
    callback browse-icon();
    callback set-text(field: string, value: string);
    callback set-choice(field: string, value: int);
    callback set-flag(field: string, value: bool);
    callback set-preview-kind(kind: int);
    callback test();
    callback save();
    callback discard();
    callback create-user-config();
    callback open-context-menus();
    callback other-toggle(index: int, shown: bool);
    callback hide-leftovers();
    callback other-title(index: int, title: string);
}
