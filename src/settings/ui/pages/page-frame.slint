import { ScrollView } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";

// Scrollable page body that fades in when the page is created.
export component PageFrame inherits Rectangle {
    property <float> appear: 0;
    init => { root.appear = 1; }
    animate appear { duration: 180ms; easing: ease-out; }
    opacity: root.appear;

    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding-left: Tokens.s8 + Tokens.s1;
            padding-right: Tokens.s8 + Tokens.s1;
            padding-top: Tokens.s6 + Tokens.s1;
            padding-bottom: Tokens.s8;
            spacing: Tokens.s4;
            alignment: start;
            @children
        }
    }
}
