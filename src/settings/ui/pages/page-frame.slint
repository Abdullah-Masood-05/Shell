import { Tokens } from "../theme/tokens.slint";
import { ScrollColumn } from "../components/scroll-column.slint";

// Scrollable page body that fades in when the page is created.
export component PageFrame inherits Rectangle {
    property <float> appear: 0;
    init => { root.appear = 1; }
    animate appear { duration: 180ms; easing: ease-out; }
    opacity: root.appear;

    ScrollColumn {
        width: 100%;
        height: 100%;
        inset-left: Tokens.s8 + Tokens.s1;
        inset-right: Tokens.s8 + Tokens.s1;
        inset-top: Tokens.s6 + Tokens.s1;
        inset-bottom: Tokens.s8;
        spacing: Tokens.s4;
        @children
    }
}
