import { Spinner } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Pages } from "../types.slint";
import { SaveState } from "../save-state.slint";
import { AppButton, Link } from "../components/controls.slint";
import { ThemePicker } from "../components/theme-picker.slint";
import { Toggle } from "../components/toggle.slint";
import { AppearanceState, ThemeField, K } from "appearance-state.slint";
import { PresetsState } from "presets-state.slint";

component StepDot inherits HorizontalLayout {
    in property <int> index;
    in property <string> label;
    in property <int> current;
    in property <bool> done;
    spacing: Tokens.s2;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: root.index <= root.current || root.done ? Tokens.accent : transparent;
            border-width: root.index <= root.current || root.done ? 0px : 1px;
            border-color: Tokens.stroke-strong;
            animate background { duration: Tokens.normal; }
            if root.done && root.index != root.current: Image {
                source: Icons.check;
                width: 14px;
                height: 14px;
                colorize: Tokens.on-accent;
            }
            if !(root.done && root.index != root.current): Text {
                text: root.index + 1;
                font-size: Tokens.caption;
                font-weight: 600;
                color: root.index <= root.current ? Tokens.on-accent : Tokens.text-2;
            }
        }
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: Tokens.caption + 1px;
        font-weight: root.index == root.current ? 600 : 400;
        color: root.index == root.current ? Tokens.text : Tokens.text-2;
    }
}

// A one-line state under a step: done (green), working (spinner) or failed (red).
component StateRow inherits Rectangle {
    in property <string> kind: "ok"; // ok | busy | error
    in property <string> text;
    height: row.preferred-height;
    border-radius: Tokens.radius-sm;
    background: root.kind == "ok" ? Tokens.success-bg : root.kind == "error" ? Tokens.danger-bg : Tokens.layer-2;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding: Tokens.s3;
        spacing: Tokens.s2;
        if root.kind == "busy": VerticalLayout {
            alignment: center;
            Spinner {
                width: 16px;
                height: 16px;
                indeterminate: true;
            }
        }
        if root.kind != "busy": Image {
            source: root.kind == "ok" ? Icons.ok : Icons.error;
            width: 16px;
            height: 16px;
            colorize: root.kind == "ok" ? Tokens.success : Tokens.danger;
        }
        Text {
            text: root.text;
            horizontal-stretch: 1;
            color: Tokens.text;
            wrap: word-wrap;
            min-height: self.preferred-height;
            vertical-alignment: center;
        }
    }
}

component StepTitle inherits Text {
    font-size: Tokens.body-large;
    font-weight: 600;
    color: Tokens.text;
}

component StepText inherits Text {
    color: Tokens.text-2;
    wrap: word-wrap;
    min-height: self.preferred-height;
}

// First-run setup: personal config, enable for this user, pick a look.
// Esc and "Skip setup" close it without saving; Finish saves the theme picked in step 3.
export component Onboarding inherits Rectangle {
    property <int> step: AppState.onboarding-step;
    // A custom path set in the registry counts as the user's own config too.
    property <bool> config-done: AppState.status.config-source == "appdata" || AppState.status.config-source == "registry";
    property <bool> enabled-done: AppState.status.user-registered || AppState.status.machine-registered;
    property <bool> machine-only: AppState.status.machine-registered && !AppState.status.user-registered;
    // Registering for this account on top of all users shadows the all-users copy: only on request.
    property <bool> also-for-me;
    property <bool> offer-register: AppState.status.loaded && !AppState.status.user-registered && (!AppState.status.machine-registered || root.also-for-me);
    property <bool> working: AppState.busy || AppState.onboarding-saving;
    property <ThemeField> theme: AppearanceState.fields[K.name];
    property <[string]> theme-names: [@tr("Theme name" => "Auto"), @tr("Theme name" => "Modern"), @tr("Theme name" => "Classic"), @tr("Theme name" => "White"), @tr("Theme name" => "Black")];

    pure function last-error(id: string) -> string {
        return AppState.action-id == id && !AppState.busy ? AppState.action-error : "";
    }

    background: Tokens.scrim;
    TouchArea { } // modal: nothing behind it is clickable

    // Every control is inside this scope, so Esc works wherever the focus is.
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (!root.working) {
                    AppState.dismiss-onboarding();
                }
                return accept;
            }
            return reject;
        }

        card := Rectangle {
            width: min(680px, root.width - 48px);
            height: body.preferred-height;
            x: (root.width - self.width) / 2;
            y: max(Tokens.s4, (root.height - self.height) / 2);
            border-radius: Tokens.radius-lg;
            background: Tokens.layer;
            border-width: 1px;
            border-color: Tokens.stroke-strong;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: Tokens.shadow;
            accessible-role: groupbox;
            accessible-label: @tr("Set up Nilesoft Shell Pro");

            body := VerticalLayout {
                padding: Tokens.s8;
                spacing: Tokens.s5;

                HorizontalLayout {
                    spacing: Tokens.s3;
                    Image {
                        source: Icons.logo;
                        width: 40px;
                        height: 40px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: @tr("Welcome to Nilesoft Shell Pro");
                            font-size: Tokens.subtitle;
                            font-weight: 600;
                            color: Tokens.text;
                        }
                        Text {
                            text: @tr("Three steps to set up your context menu.");
                            color: Tokens.text-2;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Tokens.s5;
                    alignment: start;
                    StepDot { index: 0; label: @tr("Personal config"); current: root.step; done: root.config-done; }
                    StepDot { index: 1; label: @tr("Setup step" => "Enable"); current: root.step; done: root.enabled-done; }
                    StepDot { index: 2; label: @tr("Setup step" => "Look"); current: root.step; done: false; }
                }

                Rectangle {
                    height: 1px;
                    background: Tokens.stroke;
                }

                if !AppState.cli-available: StateRow {
                    kind: "error";
                    text: @tr("shell.exe wasn't found next to this app, so setup can't run. Reinstall Nilesoft Shell.");
                }

                // Step 1
                if root.step == 0: VerticalLayout {
                    spacing: Tokens.s3;
                    StepTitle { text: @tr("Create your personal config"); }
                    StepText {
                        text: @tr("Shell builds its menu from shell.nss. A personal copy in %APPDATA%\\Nilesoft\\Shell is yours to change, needs no administrator rights, and is kept when Shell is updated.");
                    }
                    if root.config-done: StateRow {
                        kind: "ok";
                        text: AppState.status.config-source == "registry" ? @tr("Using the config at {}", AppState.status.config-path) : @tr("Using your personal config: {}", AppState.status.config-path);
                    }
                    if !root.config-done && AppState.busy && AppState.action-id == "config-init": StateRow {
                        kind: "busy";
                        text: AppState.busy-label;
                    }
                    if !root.config-done && root.last-error("config-init") != "": StateRow {
                        kind: "error";
                        text: @tr("Couldn't create it: {}", root.last-error("config-init"));
                    }
                    if !root.config-done: HorizontalLayout {
                        alignment: start;
                        AppButton {
                            text: root.last-error("config-init") != "" ? @tr("Try again") : @tr("Create personal config");
                            primary: true;
                            enabled: !root.working && AppState.cli-available && AppState.status.loaded;
                            clicked => { AppState.action("config-init"); }
                        }
                    }
                }

                // Step 2
                if root.step == 1: VerticalLayout {
                    spacing: Tokens.s3;
                    StepTitle { text: @tr("Enable Shell for you"); }
                    StepText {
                        text: root.machine-only
                            ? @tr("Shell is already enabled for all users on this PC, which includes your account. There's nothing to do here.")
                            : @tr("Adds Shell's menu to File Explorer for your Windows account. No administrator rights are needed. To enable it for everyone on this PC, use Preferences.");
                    }
                    if AppState.status.user-registered: StateRow {
                        kind: "ok";
                        text: AppState.status.reg-text;
                    }
                    if root.machine-only: StateRow {
                        kind: "ok";
                        text: @tr("Enabled for all users");
                    }
                    if root.machine-only && !root.also-for-me: HorizontalLayout {
                        alignment: start;
                        Link {
                            text: @tr("Register it for my account as well");
                            font-size: Tokens.caption + 1px;
                            activated => { root.also-for-me = true; }
                        }
                    }
                    if root.machine-only && root.also-for-me: StepText {
                        text: @tr("Your own registration takes priority over the all-users one, so this account stops using the all-users copy and its updates until you unregister it on Home.");
                        font-size: Tokens.caption + 1px;
                    }
                    if root.offer-register && AppState.status.win11-applicable: HorizontalLayout {
                        spacing: Tokens.s3;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                on: AppState.classic-menu-option;
                                label: classic-label.text;
                                enabled: !root.working;
                                toggled(v) => { AppState.classic-menu-option = v; }
                            }
                        }
                        classic-label := Text {
                            text: @tr("Use the classic context menu on Windows 11");
                            color: root.working ? Tokens.text-3 : Tokens.text;
                            vertical-alignment: center;
                        }
                    }
                    if root.offer-register && AppState.busy && AppState.action-id == "register-user": StateRow {
                        kind: "busy";
                        text: AppState.busy-label;
                    }
                    if root.offer-register && root.last-error("register-user") != "": StateRow {
                        kind: "error";
                        text: @tr("Couldn't enable it: {}", root.last-error("register-user"));
                    }
                    if root.offer-register: HorizontalLayout {
                        alignment: start;
                        AppButton {
                            text: root.also-for-me ? @tr("Enable for my account too") : @tr("Enable for me");
                            primary: true;
                            icon: Icons.person-add;
                            colorize-icon: true;
                            enabled: !root.working && AppState.cli-available;
                            clicked => { AppState.action("register-user"); }
                        }
                    }
                    if root.enabled-done && AppState.status.win11-applicable: StepText {
                        text: @tr("Windows 11 menu: {}", AppState.status.win11-text);
                        font-size: Tokens.caption + 1px;
                    }
                }

                // Step 3
                if root.step == 2: VerticalLayout {
                    spacing: Tokens.s3;
                    StepTitle { text: @tr("Pick a look"); }
                    StepText {
                        text: @tr("Auto follows the Windows menu style. Colours, fonts and corners are on the Appearance page.");
                    }
                    ThemePicker {
                        one-row: true;
                        selected: AppearanceState.loaded ? root.theme.index : -1;
                        enabled: AppearanceState.loaded && !root.theme.locked && !root.working;
                        picked(i) => { AppState.onboarding-theme(i); }
                    }
                    if AppState.onboarding-saving: StateRow {
                        kind: "busy";
                        text: SaveState.saving-label;
                    }
                    if !AppState.onboarding-saving && AppState.onboarding-error != "": StateRow {
                        kind: "error";
                        text: AppState.onboarding-error;
                    }
                    if !AppState.onboarding-saving && AppState.onboarding-error == "": StepText {
                        font-size: Tokens.caption + 1px;
                        text: !AppearanceState.loaded
                            ? (AppearanceState.load-error != "" ? @tr("Create your personal config in step 1 to choose a theme.") : @tr("Reading your config…"))
                            : root.theme.locked
                            ? @tr("Your config sets the theme with an expression, so it can't be changed here. Edit it in the Config Editor.")
                            : root.theme.pending
                            ? (root.config-done
                                ? @tr("{} is saved when you press Finish, after shell.exe checks the config.", root.theme-names[root.theme.index])
                                : @tr("Finish creates your personal config, then saves {} there.", root.theme-names[root.theme.index]))
                            : @tr("In use: {0} · {1}", root.theme-names[root.theme.index], root.theme.origin);
                    }
                    // The theme presets are on the Appearance page: the link finishes (saving
                    // a theme picked above) and opens that page behind the dialog.
                    if PresetsState.presets.length > 0: Link {
                        text: @tr("More themes on the Appearance page");
                        font-size: Tokens.caption + 1px;
                        activated => {
                            if (!root.working) {
                                AppState.page = Pages.appearance;
                                AppState.finish-onboarding();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Tokens.s3;
                        AppButton {
                            text: @tr("Restart Explorer");
                            icon: Icons.restart;
                            colorize-icon: true;
                            enabled: !root.working && AppState.cli-available;
                            clicked => { AppState.action("restart"); }
                        }
                        StepText {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            font-size: Tokens.caption + 1px;
                            text: AppState.busy && AppState.action-id == "restart"
                                ? AppState.busy-label
                                : root.last-error("restart") != ""
                                ? @tr("Explorer didn't restart: {}", root.last-error("restart"))
                                : @tr("Do this once after enabling Shell. Theme changes show on the next right-click.");
                            color: root.last-error("restart") != "" ? Tokens.danger : Tokens.text-2;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Tokens.s2;
                    padding-top: Tokens.s2;
                    AppButton {
                        text: @tr("Skip setup");
                        enabled: !root.working;
                        clicked => { AppState.dismiss-onboarding(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.step > 0: AppButton {
                        text: @tr("Back");
                        enabled: !root.working;
                        clicked => { AppState.onboarding-step -= 1; }
                    }
                    if root.step < 2: AppButton {
                        text: @tr("Next");
                        primary: true;
                        enabled: !AppState.onboarding-saving;
                        clicked => { AppState.onboarding-step += 1; }
                    }
                    if root.step == 2: AppButton {
                        text: AppState.onboarding-saving ? @tr("Saving…") : @tr("Finish");
                        primary: true;
                        enabled: !root.working;
                        clicked => { AppState.finish-onboarding(); }
                    }
                }
            }
        }
    }
}
