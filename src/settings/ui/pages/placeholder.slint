import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState } from "../types.slint";
import { PageHeader } from "../components/page-header.slint";
import { PageFrame } from "page-frame.slint";

// "Coming soon" page for sections that later milestones fill in.
export component PlaceholderPage inherits PageFrame {
    in property <string> title;
    in property <string> description;
    in property <image> icon;
    in property <string> milestone;
    in property <[string]> planned;

    PageHeader {
        title: root.title;
        description: root.description;
        busy: AppState.busy;
        busy-label: AppState.busy-label;
    }

    Rectangle {
        border-radius: Tokens.radius-card;
        border-width: 1px;
        border-color: Tokens.stroke;
        background: @linear-gradient(135deg, Tokens.accent-soft 0%, Tokens.layer 55%);

        HorizontalLayout {
            padding: Tokens.s8;
            spacing: Tokens.s8;

            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 88px;
                    height: 88px;
                    border-radius: 20px;
                    background: Tokens.accent-soft;
                    border-width: 1px;
                    border-color: Tokens.accent.with-alpha(0.3);
                    Image {
                        source: root.icon;
                        width: 44px;
                        height: 44px;
                        colorize: Tokens.accent;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Tokens.s3;
                alignment: start;

                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 24px;
                        width: chip.preferred-width + 20px;
                        border-radius: 12px;
                        background: Tokens.accent;
                        chip := Text {
                            text: "Coming in " + root.milestone;
                            font-size: Tokens.caption;
                            font-weight: 600;
                            color: Tokens.on-accent;
                        }
                    }
                }
                Text {
                    text: "This page is on its way";
                    font-size: Tokens.subtitle;
                    font-weight: 600;
                    color: Tokens.text;
                }
                Text {
                    text: "Until then, edit shell.nss directly; the menu reloads as soon as the file is saved.";
                    font-size: Tokens.body;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                }
                Rectangle { height: Tokens.s1; }
                for item in root.planned: HorizontalLayout {
                    spacing: Tokens.s2;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 2px;
                        Image {
                            source: Icons.check;
                            width: 16px;
                            height: 16px;
                            colorize: Tokens.accent;
                        }
                    }
                    Text {
                        text: item;
                        horizontal-stretch: 1;
                        font-size: Tokens.body;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
