import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Pages } from "../types.slint";
import { EditorState } from "../editor-types.slint";
import { Card, KeyValue, SectionTitle } from "../components/card.slint";
import { Banner } from "../components/banner.slint";
import { PageHeader } from "../components/page-header.slint";
import { StatusPill } from "../components/status-pill.slint";
import { AppButton, ActionTile, Link } from "../components/controls.slint";
import { PageFrame } from "page-frame.slint";
import { UpdateState } from "../update-state.slint";
import { UpdateBanner } from "../components/update-banner.slint";
import { ConfigUpdateState } from "../config-update-state.slint";
import { KeptFilesNotice } from "../components/config-update.slint";

component DiagnosticRow inherits Rectangle {
    in property <string> level;
    in property <string> time;
    in property <string> message;
    in property <string> file;
    in property <int> line;
    in property <int> column;
    callback open();

    property <string> kind: root.level == "error" ? "error" : root.level == "warning" ? "warning" : "info";
    height: row.preferred-height;
    border-radius: Tokens.radius-sm;
    background: ta.has-hover && root.file != "" ? Tokens.hover : transparent;
    animate background { duration: Tokens.fast; }

    ta := TouchArea {
        mouse-cursor: root.file != "" ? pointer : default;
        clicked => {
            if (root.file != "") {
                root.open();
            }
        }
    }

    row := HorizontalLayout {
        padding: Tokens.s2;
        spacing: Tokens.s3;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Image {
                source: Icons.status(root.kind);
                width: 16px;
                height: 16px;
                colorize: Tokens.status-color(root.kind);
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.message;
                color: Tokens.text;
                font-size: Tokens.body;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            HorizontalLayout {
                spacing: Tokens.s2;
                alignment: start;
                Text {
                    text: root.time;
                    color: Tokens.text-3;
                    font-size: Tokens.caption;
                }
                if root.line > 0: Rectangle {
                    height: 16px;
                    width: pos.preferred-width + 10px;
                    border-radius: Tokens.radius-xs;
                    background: Tokens.selected;
                    pos := Text {
                        text: @tr("line {}, column {}", root.line, root.column);
                        font-size: 11px;
                        color: Tokens.text-2;
                    }
                }
            }
        }
    }
}

export component HomePage inherits PageFrame {
    // Too narrow for four quick actions in a row.
    property <bool> narrow: root.width - 2 * (Tokens.s8 + Tokens.s1) < 680px;
    PageHeader {
        title: @tr("Home");
        description: @tr("Nilesoft Shell at a glance: registration, the active config and recent diagnostics.");
        busy: AppState.busy;
        busy-label: AppState.busy-label;
        AppButton {
            text: @tr("Refresh");
            icon: Icons.refresh;
            colorize-icon: true;
            enabled: !AppState.busy;
            clicked => { AppState.refresh(); }
        }
    }

    // After an update: what the helper did (and, for a portable copy, the Explorer restart
    // that loads the new shell.dll).
    if UpdateState.notice-shown: Banner {
        kind: UpdateState.notice-kind;
        title: UpdateState.notice-title;
        text: UpdateState.notice-text;
        action-label: UpdateState.notice-action == "restart" ? @tr("Restart Explorer") : "";
        action-enabled: !AppState.busy && AppState.cli-available;
        closable: true;
        action => {
            AppState.action("restart");
            UpdateState.dismiss-notice();
        }
        close => { UpdateState.dismiss-notice(); }
    }

    if UpdateState.offered && !UpdateState.deferred: UpdateBanner {
        narrow: root.width - 2 * (Tokens.s8 + Tokens.s1) < 820px;
    }

    // After an update: the menu files brought up to this version, and the ones the user
    // changed, which were kept (src/ConfigUpdateController.cpp).
    if ConfigUpdateState.updated-shown: Banner {
        kind: "ok";
        title: ConfigUpdateState.updated-title;
        text: ConfigUpdateState.updated-text;
        action-label: @tr("Open Backups");
        closable: true;
        action => { AppState.page = Pages.backups; }
        close => { ConfigUpdateState.dismiss-updated(); }
    }

    if ConfigUpdateState.kept-shown: KeptFilesNotice { }

    for issue in AppState.issues: Banner {
        kind: issue.kind;
        title: issue.title;
        text: issue.message;
        action-label: issue.action-label;
        action-enabled: !AppState.busy;
        action => { AppState.action(issue.action); }
    }

    HorizontalLayout {
        spacing: Tokens.s4;

        // Health. Both cards get the same preferred width so they split the row evenly.
        Card {
            horizontal-stretch: 1;
            min-width: 250px;
            preferred-width: 320px;
            HorizontalLayout {
                spacing: Tokens.s3;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Tokens.status-bg(AppState.status.health-kind);
                    animate background { duration: Tokens.normal; }
                    Image {
                        source: Icons.status(AppState.status.health-kind);
                        width: 22px;
                        height: 22px;
                        colorize: Tokens.status-color(AppState.status.health-kind);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: AppState.status.loaded ? AppState.status.health-title : @tr("Checking status…");
                        font-size: Tokens.body-large;
                        font-weight: 600;
                        color: Tokens.text;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                    Text {
                        text: AppState.status.health-detail;
                        font-size: Tokens.body;
                        color: Tokens.text-2;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Tokens.stroke;
            }
            KeyValue {
                key: @tr("Registration");
                value: AppState.status.reg-text;
            }
            KeyValue {
                key: @tr("Windows 11 menu");
                value: AppState.status.win11-text;
            }
            KeyValue {
                key: @tr("Shell DLL");
                value: AppState.status.active-dll;
                mono: true;
                value-color: AppState.status.active-dll-exists ? Tokens.text : Tokens.danger;
            }
            KeyValue {
                key: @tr("Version");
                // After an app update for this user, the app is newer than the installed Shell core: both.
                property <string> shown: AppState.app-version != "" && AppState.status.version != AppState.app-version
                    ? @tr("Shell core {}  ·  app {}", AppState.status.version, AppState.app-version) : AppState.status.version;
                value: AppState.status.version == "" ? "—" : AppState.status.elevated ? @tr("{}  (running as administrator)", self.shown) : self.shown;
            }
            Rectangle { vertical-stretch: 1; }
        }

        // Active config
        Card {
            horizontal-stretch: 1;
            min-width: 250px;
            preferred-width: 320px;
            icon: Icons.document;
            heading: @tr("Active config");
            description: @tr("The shell.nss Shell builds its menu from, and the files it imports.");
            HorizontalLayout {
                alignment: start;
                StatusPill {
                    kind: AppState.status.config-source == "appdata" ? "ok" : AppState.status.config-source == "" ? "neutral" : "info";
                    text: AppState.status.source-text;
                }
            }
            Rectangle {
                height: path-text.preferred-height + Tokens.s3 * 2;
                border-radius: Tokens.radius-sm;
                background: Tokens.layer-2;
                border-width: 1px;
                border-color: Tokens.stroke;
                path-text := Text {
                    x: Tokens.s3;
                    width: parent.width - Tokens.s3 * 2;
                    text: AppState.status.config-path == "" ? "—" : AppState.status.config-path;
                    font-family: Tokens.mono;
                    font-size: Tokens.caption + 1px;
                    color: AppState.status.config-exists ? Tokens.text : Tokens.danger;
                    wrap: char-wrap;
                    min-height: self.preferred-height;
                }
            }
            if AppState.status.loaded && AppState.status.config-source != "appdata": Text {
                text: @tr("This is the shared config from the install folder. A personal copy in %APPDATA% is kept per user and survives updates.");
                font-size: Tokens.caption + 1px;
                color: Tokens.text-2;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: Tokens.s2;
                alignment: start;
                if AppState.status.loaded && AppState.status.config-source != "appdata": AppButton {
                    text: @tr("Use per-user config");
                    primary: true;
                    enabled: !AppState.busy;
                    clicked => { AppState.action("config-init"); }
                }
                AppButton {
                    text: @tr("Open folder");
                    icon: Icons.folder;
                    colorize-icon: true;
                    enabled: !AppState.busy && AppState.status.config-path != "";
                    clicked => { AppState.action("open-config-folder"); }
                }
            }
        }
    }

    SectionTitle {
        text: @tr("Quick actions");
    }
    HorizontalLayout {
        spacing: Tokens.s3;
        ActionTile {
            horizontal-stretch: 1;
            icon: Icons.restart;
            title: @tr("Restart Explorer");
            caption: @tr("Reload the shell and the menu");
            enabled: !AppState.busy && AppState.cli-available;
            clicked => { AppState.action("restart"); }
        }
        ActionTile {
            horizontal-stretch: 1;
            icon: AppState.status.user-registered ? Icons.person-remove : Icons.person-add;
            title: AppState.status.user-registered ? @tr("Unregister for me") : AppState.status.machine-registered ? @tr("Also register for me") : @tr("Register for me");
            // On top of the all-users registration, a per-user one takes priority over it.
            caption: AppState.status.user-registered ? @tr("Remove it from your account") : AppState.status.machine-registered ? @tr("Overrides the all-users copy") : @tr("No administrator rights needed");
            enabled: !AppState.busy && AppState.cli-available && AppState.status.loaded;
            clicked => { AppState.action(AppState.status.user-registered ? "unregister-user" : "register-user"); }
        }
        if !root.narrow: ActionTile {
            horizontal-stretch: 1;
            icon: Icons.folder;
            title: @tr("Open config folder");
            caption: @tr("Show shell.nss in Explorer");
            enabled: !AppState.busy && AppState.status.config-path != "";
            clicked => { AppState.action("open-config-folder"); }
        }
        if !root.narrow: ActionTile {
            horizontal-stretch: 1;
            icon: Icons.refresh;
            title: @tr("Refresh");
            caption: @tr("Check the status again");
            enabled: !AppState.busy;
            clicked => { AppState.refresh(); }
        }
    }
    // A narrow window: two rows of two.
    if root.narrow: HorizontalLayout {
        spacing: Tokens.s3;
        ActionTile {
            horizontal-stretch: 1;
            icon: Icons.folder;
            title: @tr("Open config folder");
            caption: @tr("Show shell.nss in Explorer");
            enabled: !AppState.busy && AppState.status.config-path != "";
            clicked => { AppState.action("open-config-folder"); }
        }
        ActionTile {
            horizontal-stretch: 1;
            icon: Icons.refresh;
            title: @tr("Refresh");
            caption: @tr("Check the status again");
            enabled: !AppState.busy;
            clicked => { AppState.refresh(); }
        }
    }

    HorizontalLayout {
        spacing: Tokens.s2;
        SectionTitle {
            text: @tr("Diagnostics");
            vertical-alignment: center;
        }
        Text {
            text: @tr("· newest first, from shell.log");
            font-size: Tokens.caption + 1px;
            color: Tokens.text-3;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if AppState.log-path != "": Link {
            text: @tr("Open shell.log");
            activated => { AppState.open-path(AppState.log-path); }
        }
    }
    Card {
        inner-padding: Tokens.s2;
        inner-spacing: 0px;
        if AppState.diagnostics.length == 0: HorizontalLayout {
            padding: Tokens.s3;
            spacing: Tokens.s3;
            Image {
                source: Icons.ok;
                width: 16px;
                height: 16px;
                colorize: Tokens.success;
            }
            Text {
                text: AppState.log-path == "" ? @tr("No shell.log found next to the active shell.dll.") : @tr("No errors or warnings in shell.log.");
                color: Tokens.text-2;
                vertical-alignment: center;
            }
        }
        for d in AppState.diagnostics: DiagnosticRow {
            level: d.level;
            time: d.time;
            message: d.message;
            file: d.file;
            line: d.line;
            column: d.column;
            // Show the line in the Config Editor.
            open => {
                EditorState.open-at(d.file, d.line);
                AppState.page = Pages.editor;
            }
        }
    }

    HorizontalLayout {
        alignment: start;
        Link {
            text: @tr("Run first-time setup again");
            activated => {
                AppState.onboarding-step = 0;
                AppState.onboarding-shown = true;
            }
        }
    }
}
