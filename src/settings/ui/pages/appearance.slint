// Appearance: the theme, then its colours, type, effects and the advanced keys in
// tabs, with a live preview on the right. Values go to SaveService as pending
// changes; the footer saves.

import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, Pages } from "../types.slint";
import { Card } from "../components/card.slint";
import { ScrollColumn } from "../components/scroll-column.slint";
import { Banner } from "../components/banner.slint";
import { PageHeader } from "../components/page-header.slint";
import { AppButton, Link, Segmented, Tabs } from "../components/controls.slint";
import { SettingRow, SettingBlock, RowDivider, ChipGroup, RadiusSteps, ValueSlider, BoxField, ColorField, FontPicker, ToggleSwitch, PaletteSwatch } from "../components/theme-controls.slint";
import { ThemePicker, ThemeInfo } from "../components/theme-picker.slint";
import { PreviewPane, MiniMenu } from "../preview/menu-preview.slint";
import { AppearanceState, ThemeField, K } from "appearance-state.slint";
import { PresetGallery, PresetConfirm } from "../components/preset-gallery.slint";
import { PresetsState } from "presets-state.slint";
import { ActionHeader } from "../components/action-header.slint";

export { AppearanceState, K }

// The colour palette of the Colors tab: each entry is one real theme key.
struct PaletteEntry {
    label: string,
    index: int,      // into AppearanceState.fields (K)
    alpha: bool,
}

// A small heading inside a tab.
component TabSection inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: Tokens.body;
        font-weight: 600;
        color: Tokens.text;
    }
    if root.description != "": Text {
        text: root.description;
        font-size: Tokens.caption;
        color: Tokens.text-2;
        wrap: word-wrap;
        min-height: self.preferred-height;
    }
}

// The live preview: Desktop or File Explorer, light or dark.
component PreviewCard inherits Rectangle {
    in property <length> pane-height: 280px;

    background: Tokens.layer;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.stroke;
    VerticalLayout {
        padding: Tokens.s4;
        spacing: Tokens.s3;
        HorizontalLayout {
            spacing: Tokens.s3;
            VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.eye;
                    width: 20px;
                    height: 20px;
                    colorize: Tokens.text-2;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: @tr("Live preview");
                font-size: Tokens.heading;
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: Tokens.s2;
            Segmented {
                horizontal-stretch: 1;
                min-option-width: 88px;
                options: [@tr("Desktop"), @tr("Preview tab" => "File Explorer")];
                selected: AppearanceState.preview-context;
                changed(i) => { AppearanceState.preview-context = i; }
            }
            Segmented {
                horizontal-stretch: 0;
                width: 116px;
                min-option-width: 52px;
                options: [@tr("Light"), @tr("Dark")];
                selected: AppearanceState.preview-dark ? 1 : 0;
                changed(i) => { AppearanceState.set-preview-dark(i == 1); }
            }
        }
        PreviewPane {
            vertical-stretch: 1;
            min-height: root.pane-height;
            t: AppearanceState.preview;
            context: AppearanceState.preview-context;
            menu: AppearanceState.preview-context == 0 ? AppearanceState.menu-desktop : AppearanceState.menu-explorer;
            subs: AppearanceState.preview-context == 0 ? AppearanceState.subs-desktop : AppearanceState.subs-explorer;
            wallpaper: AppearanceState.wallpaper;
            blurred: AppearanceState.wallpaper-blurred;
            icon-font: AppearanceState.icon-font;
            dark: AppearanceState.preview-dark;
        }
        Text {
            text: @tr("This is how your theme will look in the shell, approximately. Right-click the desktop to see the real menu.");
            font-size: Tokens.caption;
            color: Tokens.text-2;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }
}

// Where to go for the keys this page doesn't have. The button goes under the text
// when the card is narrow.
component FurtherCard inherits Rectangle {
    background: Tokens.layer;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.stroke;
    VerticalLayout {
        padding: Tokens.s4;
        ActionHeader {
            icon: Icons.editor;
            icon-color: Tokens.accent;
            title: @tr("Want to go further?");
            title-size: Tokens.body;
            description: @tr("Gradients, image colours and per-item rules are in shell.nss and its imports.");
            min-text-width: 200px;
            AppButton {
                text: @tr("Config Editor");
                icon: Icons.arrow-right;
                icon-after: true;
                colorize-icon: true;
                clicked => { AppState.page = Pages.editor; }
            }
        }
    }
}

export component AppearancePage inherits Rectangle {
    property <[ThemeField]> f: AppearanceState.fields;
    property <bool> ready: AppearanceState.loaded && f.length > K.image-gap;
    // The width inside the page's padding.
    property <length> inner-width: root.width - 2 * (Tokens.s8 + Tokens.s1);
    // Settings and preview side by side only when the settings keep a sensible width
    // next to the preview; otherwise one column, with the preview in it.
    property <bool> stacked: root.inner-width < 440px + Tokens.s4 + 300px;
    property <length> preview-width: clamp((root.width - 72px) * 0.4, 300px, 520px);
    // The left column's inner width (page padding, gap, scroll gutter, card padding).
    property <length> body-width: root.inner-width - (root.stacked ? 0px : Tokens.s4 + root.preview-width) - Tokens.s3 - 2 * Tokens.s5;
    property <int> swatch;   // the palette entry the row under the palette edits
    property <int> theme-index: f.length > K.name ? clamp(f[K.name].index, 0, 4) : 0;

    // Background, text, highlight, highlighted text, disabled text and border: the
    // keys that decide most of how a menu looks (see DESIGN.md, Appearance).
    property <[PaletteEntry]> palette: [
        { label: @tr("Background"), index: K.bg-color, alpha: false },
        { label: @tr("Text"), index: K.text-normal, alpha: true },
        { label: @tr("Highlight"), index: K.back-select, alpha: true },
        { label: @tr("Highlighted text"), index: K.text-select, alpha: true },
        { label: @tr("Disabled text"), index: K.text-disabled, alpha: true },
        { label: @tr("Border"), index: K.border-color, alpha: true },
    ];
    property <int> palette-columns: root.body-width >= 720px ? 6 : 3;

    property <float> appear: 0;
    init => {
        root.appear = 1;
        AppearanceState.reload(); // the Config Editor may have changed the files
    }
    animate appear { duration: 180ms; easing: ease-out; }
    opacity: root.appear;

    VerticalLayout {
        padding-left: Tokens.s8 + Tokens.s1;
        padding-right: Tokens.s8 + Tokens.s1;
        padding-top: Tokens.s6 + Tokens.s1;
        spacing: Tokens.s5;

        PageHeader {
            title: @tr("Appearance");
            description: @tr("The theme, colours, font and effects of Shell's menus. The preview updates as you change them.");
            busy: AppState.busy;
            busy-label: AppState.busy-label;
        }

        if AppearanceState.load-error != "": Banner {
            kind: "error";
            title: @tr("Couldn't read your config");
            text: AppearanceState.load-error;
            action-label: @tr("Try again");
            action => { AppearanceState.reload(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: Tokens.s4;

            left := ScrollColumn {
                horizontal-stretch: 1;
                // Vertical scrolling only: the column is as wide as the view.
                fit-width: true;
                inset-right: Tokens.s3;
                inset-bottom: Tokens.s6;
                spacing: Tokens.s4;

                // Themes: the presets gallery (src/PresetsController.cpp). It draws its own header.
                Card {
                    PresetGallery { }
                }

                // The base theme the keys below apply on top of.
                Card {
                    icon: Icons.palette;
                    heading: @tr("Base theme");
                    description: @tr("The built-in style under every preset: colours, corners and effects. What you change below applies on top of it.");
                    ThemePicker {
                        selected: root.f[K.name].index;
                        enabled: root.ready;
                        picked(i) => { AppearanceState.set-index(K.name, i); }
                    }
                }

                // A narrow window: the preview above the keys it shows.
                if root.stacked: PreviewCard {
                    pane-height: 300px;
                }

                // The theme in use and its keys, by tab.
                Rectangle {
                    background: Tokens.layer;
                    border-radius: Tokens.radius-lg;
                    border-width: 1px;
                    border-color: Tokens.stroke;

                    VerticalLayout {
                        padding: Tokens.s5;
                        padding-bottom: Tokens.s4;
                        spacing: Tokens.s4;

                        HorizontalLayout {
                            spacing: Tokens.s4;
                            // The current look, with every change on this page.
                            Rectangle {
                                width: 112px;
                                height: 76px;
                                border-radius: Tokens.radius-sm;
                                border-width: 1px;
                                border-color: Tokens.stroke;
                                clip: true;
                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: AppearanceState.wallpaper;
                                    image-fit: cover;
                                }
                                MiniMenu {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    t: AppearanceState.preview;
                                    icon-font: AppearanceState.icon-font;
                                    blurred: AppearanceState.wallpaper-blurred;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: Tokens.s1;
                                HorizontalLayout {
                                    spacing: Tokens.s2;
                                    alignment: start;
                                    Text {
                                        text: ThemeInfo.names[root.theme-index];
                                        font-size: Tokens.body-large;
                                        font-weight: 600;
                                        color: Tokens.text;
                                        vertical-alignment: center;
                                    }
                                    // Saved and in use, or picked here and waiting for Save.
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 20px;
                                            width: chip-row.preferred-width + 16px;
                                            border-radius: Tokens.radius-xs;
                                            background: root.f[K.name].pending ? Tokens.warning-bg : Tokens.success-bg;
                                            chip-row := HorizontalLayout {
                                                alignment: center;
                                                spacing: 5px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 6px;
                                                        height: 6px;
                                                        border-radius: 3px;
                                                        background: root.f[K.name].pending ? Tokens.warning : Tokens.success;
                                                    }
                                                }
                                                Text {
                                                    text: root.f[K.name].pending ? @tr("Not saved yet") : @tr("In use");
                                                    font-size: 11px;
                                                    color: Tokens.text;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: ThemeInfo.about[root.theme-index];
                                    font-size: Tokens.caption + 1px;
                                    color: Tokens.text-2;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                                // Where the theme is set, and a way back to the file's value.
                                HorizontalLayout {
                                    spacing: Tokens.s3;
                                    alignment: start;
                                    Text {
                                        text: root.f[K.name].locked ? @tr("Set by an expression ({}). Changing it here overrides it.", root.f[K.name].origin) : root.f[K.name].origin;
                                        font-size: Tokens.caption;
                                        color: Tokens.text-3;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if (root.f[K.name].overridden || root.f[K.name].pending) && !root.f[K.name].locked: Link {
                                        text: @tr("Reset");
                                        font-size: Tokens.caption;
                                        activated => { AppearanceState.reset(K.name); }
                                    }
                                }
                            }
                        }

                        Tabs {
                            tabs: [
                                { label: @tr("Colors"), icon: Icons.palette },
                                { label: @tr("Typography"), icon: Icons.typography },
                                { label: @tr("Effects"), icon: Icons.effects },
                                { label: @tr("Advanced"), icon: Icons.preferences },
                            ];
                            selected: AppearanceState.tab;
                            changed(i) => { AppearanceState.tab = i; }
                        }

                        // Colors
                        if AppearanceState.tab == 0: VerticalLayout {
                            spacing: Tokens.s3;
                            TabSection {
                                title: @tr("Colour palette");
                                description: @tr("The main colours of the menu. Pick one to change it; the row under the palette has its hex value and where it's set.");
                            }
                            HorizontalLayout {
                                spacing: Tokens.s1;
                                for i in root.palette-columns: PaletteSwatch {
                                    horizontal-stretch: 1;
                                    label: root.palette[i].label;
                                    field: root.f[root.palette[i].index];
                                    show-alpha: root.palette[i].alpha;
                                    enabled: root.ready;
                                    current: root.swatch == i;
                                    picked => { root.swatch = i; }
                                    changed(c) => { AppearanceState.set-color(root.palette[i].index, c); }
                                }
                            }
                            if root.palette-columns == 3: HorizontalLayout {
                                spacing: Tokens.s1;
                                for i in 3: PaletteSwatch {
                                    horizontal-stretch: 1;
                                    label: root.palette[i + 3].label;
                                    field: root.f[root.palette[i + 3].index];
                                    show-alpha: root.palette[i + 3].alpha;
                                    enabled: root.ready;
                                    current: root.swatch == i + 3;
                                    picked => { root.swatch = i + 3; }
                                    changed(c) => { AppearanceState.set-color(root.palette[i + 3].index, c); }
                                }
                            }
                            Rectangle {
                                border-radius: Tokens.radius-sm;
                                background: Tokens.layer-2;
                                VerticalLayout {
                                    padding-left: Tokens.s4;
                                    padding-right: Tokens.s3;
                                    padding-top: Tokens.s2;
                                    padding-bottom: Tokens.s2;
                                    SettingRow {
                                        label: root.palette[root.swatch].label;
                                        field: root.f[root.palette[root.swatch].index];
                                        reset => { AppearanceState.reset(root.palette[root.swatch].index); }
                                        ColorField {
                                            value: root.f[root.palette[root.swatch].index].color;
                                            hex: root.f[root.palette[root.swatch].index].display;
                                            show-alpha: root.palette[root.swatch].alpha;
                                            enabled: root.ready;
                                            changed(c) => { AppearanceState.set-color(root.palette[root.swatch].index, c); }
                                            hex-entered(t) => { AppearanceState.set-text(root.palette[root.swatch].index, t); }
                                        }
                                    }
                                }
                            }
                            RowDivider { }
                            SettingRow {
                                label: @tr("Dark mode");
                                field: root.f[K.dark];
                                hint: root.f[K.dark].index == 0 ? @tr("Auto follows the Windows app mode · {}", root.f[K.dark].origin) : root.f[K.dark].origin;
                                control-width: 168px;
                                reset => { AppearanceState.reset(K.dark); }
                                ChipGroup {
                                    options: [@tr("Setting value" => "Auto"), @tr("Setting value" => "On"), @tr("Setting value" => "Off")];
                                    selected: root.f[K.dark].index;
                                    enabled: root.ready;
                                    changed(i) => { AppearanceState.set-index(K.dark, i); }
                                }
                            }
                        }

                        // Typography
                        if AppearanceState.tab == 1: VerticalLayout {
                            spacing: Tokens.s3;
                            TabSection {
                                title: @tr("Typography");
                                description: @tr("A size other than the default scales the whole menu, like the core does.");
                            }
                            SettingBlock {
                                label: @tr("Font");
                                field: root.f[K.font-name];
                                reset => { AppearanceState.reset(K.font-name); }
                                FontPicker {
                                    value: root.f[K.font-name].display;
                                    fonts: AppearanceState.fonts;
                                    enabled: root.ready;
                                    filter(t) => { AppearanceState.filter-fonts(t); }
                                    picked(name) => { AppearanceState.set-text(K.font-name, name); }
                                }
                            }
                            RowDivider { }
                            SettingBlock {
                                label: @tr("Size");
                                field: root.f[K.font-size];
                                reset => { AppearanceState.reset(K.font-size); }
                                ValueSlider {
                                    value: root.f[K.font-size].number;
                                    auto-value: root.f[K.font-size].is-auto;
                                    minimum: 6;
                                    maximum: 32;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.font-size, v); }
                                }
                            }
                            RowDivider { }
                            SettingBlock {
                                label: @tr("Weight");
                                field: root.f[K.font-weight];
                                reset => { AppearanceState.reset(K.font-weight); }
                                ValueSlider {
                                    value: root.f[K.font-weight].number;
                                    auto-value: root.f[K.font-weight].is-auto;
                                    minimum: 1;
                                    maximum: 9;
                                    unit: "00";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.font-weight, v); }
                                }
                            }
                            RowDivider { }
                            SettingBlock {
                                label: @tr("Density");
                                field: root.f[K.view];
                                reset => { AppearanceState.reset(K.view); }
                                ChipGroup {
                                    options: [@tr("Setting value" => "Auto"), @tr("Menu density" => "Compact"), @tr("Menu density" => "Small"), @tr("Menu density" => "Medium"), @tr("Menu density" => "Large"), @tr("Menu density" => "Wide")];
                                    selected: root.f[K.view].index;
                                    enabled: root.ready;
                                    changed(i) => { AppearanceState.set-index(K.view, i); }
                                }
                            }
                        }

                        // Effects
                        if AppearanceState.tab == 2: VerticalLayout {
                            spacing: Tokens.s3;
                            TabSection {
                                title: @tr("Background");
                                description: @tr("What shows behind the menu, and how much.");
                            }
                            SettingBlock {
                                label: @tr("Effect");
                                hint: AppearanceState.effect-note == "" ? root.f[K.effect].origin : AppearanceState.effect-note + " · " + root.f[K.effect].origin;
                                field: root.f[K.effect];
                                reset => { AppearanceState.reset(K.effect); }
                                ChipGroup {
                                    options: [@tr("Setting value" => "Auto"), @tr("None"), @tr("Transparent"), @tr("Blur"), @tr("Acrylic")];
                                    selected: root.f[K.effect].index;
                                    enabled: root.ready;
                                    changed(i) => { AppearanceState.set-index(K.effect, i); }
                                }
                            }
                            if root.f[K.effect].index == 0 || root.f[K.effect].index >= 3: SettingRow {
                                label: @tr("Tint");
                                hint: AppearanceState.tint-note + " · " + root.f[K.tint].origin;
                                field: root.f[K.tint];
                                reset => { AppearanceState.reset(K.tint); }
                                ColorField {
                                    value: root.f[K.tint].color;
                                    hex: root.f[K.tint].display;
                                    show-alpha: true;
                                    enabled: root.ready;
                                    changed(c) => { AppearanceState.set-color(K.tint, c); }
                                    hex-entered(t) => { AppearanceState.set-text(K.tint, t); }
                                }
                            }
                            SettingBlock {
                                label: @tr("Opacity");
                                hint: AppearanceState.opacity-note + " · " + root.f[K.bg-opacity].origin;
                                field: root.f[K.bg-opacity];
                                reset => { AppearanceState.reset(K.bg-opacity); }
                                ValueSlider {
                                    value: root.f[K.bg-opacity].number;
                                    auto-value: root.f[K.bg-opacity].is-auto;
                                    maximum: 100;
                                    unit: " %";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.bg-opacity, v); }
                                }
                            }
                            RowDivider { }
                            TabSection {
                                title: @tr("Shape");
                                description: @tr("Corners and border. The border's colour is in Colors.");
                            }
                            SettingBlock {
                                label: @tr("Menu corners");
                                field: root.f[K.menu-radius];
                                reset => { AppearanceState.reset(K.menu-radius); }
                                RadiusSteps {
                                    selected: root.f[K.menu-radius].number;
                                    enabled: root.ready;
                                    changed(i) => { AppearanceState.set-number(K.menu-radius, i); }
                                }
                            }
                            SettingBlock {
                                label: @tr("Item corners");
                                field: root.f[K.item-radius];
                                reset => { AppearanceState.reset(K.item-radius); }
                                RadiusSteps {
                                    selected: root.f[K.item-radius].number;
                                    enabled: root.ready;
                                    changed(i) => { AppearanceState.set-number(K.item-radius, i); }
                                }
                            }
                            SettingBlock {
                                label: @tr("Border");
                                field: root.f[K.border-size];
                                reset => { AppearanceState.reset(K.border-size); }
                                ValueSlider {
                                    value: root.f[K.border-size].number;
                                    auto-value: root.f[K.border-size].is-auto;
                                    maximum: 10;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.border-size, v); }
                                }
                            }
                            RowDivider { }
                            SettingRow {
                                label: @tr("Shadow");
                                field: root.f[K.shadow];
                                reset => { AppearanceState.reset(K.shadow); }
                                control-width: 80px;
                                ToggleSwitch {
                                    on: root.f[K.shadow].number > 0.5;
                                    label: @tr("Shadow");
                                    enabled: root.ready;
                                    toggled(on) => { AppearanceState.set-number(K.shadow, on ? 1 : 0); }
                                }
                            }
                            if root.f[K.shadow].number > 0.5: SettingBlock {
                                label: @tr("Shadow size");
                                field: root.f[K.shadow-size];
                                reset => { AppearanceState.reset(K.shadow-size); }
                                ValueSlider {
                                    value: root.f[K.shadow-size].number;
                                    auto-value: root.f[K.shadow-size].is-auto;
                                    maximum: 30;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.shadow-size, v); }
                                }
                            }
                            if root.f[K.shadow].number > 0.5: SettingBlock {
                                label: @tr("Shadow offset");
                                field: root.f[K.shadow-offset];
                                reset => { AppearanceState.reset(K.shadow-offset); }
                                ValueSlider {
                                    value: root.f[K.shadow-offset].number;
                                    auto-value: root.f[K.shadow-offset].is-auto;
                                    maximum: 30;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.shadow-offset, v); }
                                }
                            }
                            if root.f[K.shadow].number > 0.5: SettingBlock {
                                label: @tr("Shadow opacity");
                                field: root.f[K.shadow-opacity];
                                reset => { AppearanceState.reset(K.shadow-opacity); }
                                ValueSlider {
                                    value: root.f[K.shadow-opacity].number;
                                    auto-value: root.f[K.shadow-opacity].is-auto;
                                    maximum: 100;
                                    unit: " %";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.shadow-opacity, v); }
                                }
                            }
                        }

                        // Advanced
                        if AppearanceState.tab == 3: VerticalLayout {
                            spacing: Tokens.s3;
                            TabSection {
                                title: @tr("Items");
                                description: @tr("Spacing inside and around each item, and its icon.");
                            }
                            SettingRow {
                                label: @tr("Item padding");
                                field: root.f[K.item-padding];
                                reset => { AppearanceState.reset(K.item-padding); }
                                control-width: 250px;
                                BoxField {
                                    horizontal: root.f[K.item-padding].number;
                                    vertical: root.f[K.item-padding].number2;
                                    enabled: root.ready;
                                    changed(h, v) => { AppearanceState.set-box(K.item-padding, h, v); }
                                }
                            }
                            SettingRow {
                                label: @tr("Item margin");
                                field: root.f[K.item-margin];
                                reset => { AppearanceState.reset(K.item-margin); }
                                control-width: 250px;
                                BoxField {
                                    horizontal: root.f[K.item-margin].number;
                                    vertical: root.f[K.item-margin].number2;
                                    enabled: root.ready;
                                    changed(h, v) => { AppearanceState.set-box(K.item-margin, h, v); }
                                }
                            }
                            SettingBlock {
                                label: @tr("Image size");
                                field: root.f[K.image-size];
                                reset => { AppearanceState.reset(K.image-size); }
                                ValueSlider {
                                    value: root.f[K.image-size].number;
                                    auto-value: root.f[K.image-size].is-auto;
                                    minimum: 8;
                                    maximum: 48;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.image-size, v); }
                                }
                            }
                            SettingBlock {
                                label: @tr("Image gap");
                                field: root.f[K.image-gap];
                                reset => { AppearanceState.reset(K.image-gap); }
                                ValueSlider {
                                    value: root.f[K.image-gap].number;
                                    auto-value: root.f[K.image-gap].is-auto;
                                    maximum: 40;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.image-gap, v); }
                                }
                            }
                            SettingRow {
                                label: @tr("Highlight, disabled item");
                                field: root.f[K.back-disabled];
                                reset => { AppearanceState.reset(K.back-disabled); }
                                ColorField {
                                    value: root.f[K.back-disabled].color;
                                    hex: root.f[K.back-disabled].display;
                                    show-alpha: true;
                                    enabled: root.ready;
                                    changed(c) => { AppearanceState.set-color(K.back-disabled, c); }
                                    hex-entered(t) => { AppearanceState.set-text(K.back-disabled, t); }
                                }
                            }
                            RowDivider { }
                            TabSection {
                                title: @tr("Separators");
                            }
                            SettingBlock {
                                label: @tr("Separator size");
                                field: root.f[K.sep-size];
                                reset => { AppearanceState.reset(K.sep-size); }
                                ValueSlider {
                                    value: root.f[K.sep-size].number;
                                    auto-value: root.f[K.sep-size].is-auto;
                                    maximum: 40;
                                    unit: " px";
                                    enabled: root.ready;
                                    changed(v) => { AppearanceState.set-number(K.sep-size, v); }
                                }
                            }
                            SettingRow {
                                label: @tr("Separator colour");
                                field: root.f[K.sep-color];
                                reset => { AppearanceState.reset(K.sep-color); }
                                ColorField {
                                    value: root.f[K.sep-color].color;
                                    hex: root.f[K.sep-color].display;
                                    show-alpha: true;
                                    enabled: root.ready;
                                    changed(c) => { AppearanceState.set-color(K.sep-color, c); }
                                    hex-entered(t) => { AppearanceState.set-text(K.sep-color, t); }
                                }
                            }
                            SettingRow {
                                label: @tr("Separator margin");
                                field: root.f[K.sep-margin];
                                reset => { AppearanceState.reset(K.sep-margin); }
                                control-width: 250px;
                                BoxField {
                                    horizontal: root.f[K.sep-margin].number;
                                    vertical: root.f[K.sep-margin].number2;
                                    enabled: root.ready;
                                    changed(h, v) => { AppearanceState.set-box(K.sep-margin, h, v); }
                                }
                            }
                        }
                    }
                }

                if root.stacked: FurtherCard { }
            }

            // Live preview, and where to go for the keys this page doesn't have. In a
            // narrow window they are in the column above instead.
            if !root.stacked: VerticalLayout {
                width: root.preview-width;
                padding-bottom: Tokens.s6;
                spacing: Tokens.s4;
                PreviewCard {
                    vertical-stretch: 1;
                }
                FurtherCard { }
            }
        }
    }
    if PresetsState.confirm >= 0: PresetConfirm { }
}
