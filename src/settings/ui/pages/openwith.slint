import { Button, CheckBox, ComboBox, ListView } from "std-widgets.slint";
import { AppLineEdit as LineEdit } from "../components/line-edit.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState } from "../types.slint";
import { EditorState } from "../editor-types.slint";
import { OpenWithState, OpenWithRow, OpenWithPreviewRow, OtherAppRow } from "../openwith-types.slint";
import { Banner } from "../components/banner.slint";
import { PageHeader } from "../components/page-header.slint";
import { ActionHeader } from "../components/action-header.slint";
import { Link, Segmented } from "../components/controls.slint";
import { Toggle } from "../components/toggle.slint";
import { CodeColors, CodeRow } from "../components/code.slint";
import { PageFrame } from "page-frame.slint";

global Mdl {
    // Segoe MDL2 Assets (on every Windows 10/11)
    out property <string> family: "Segoe MDL2 Assets";
    out property <string> app: "\u{E7AC}";      // OpenWith
    out property <string> chevron: "\u{E76C}";
}

component SectionHead inherits ActionHeader {
    in property <string> caption;
    title-size: Tokens.body-large;
    description: root.caption;
    description-size: Tokens.caption + 1px;
    actions-align: 2;
    pad-top: Tokens.s2;
}

component ListSurface inherits Rectangle {
    background: Tokens.layer;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.stroke;
    VerticalLayout {
        padding-top: Tokens.s1;
        padding-bottom: Tokens.s1;
        @children
    }
}

component Hairline inherits Rectangle {
    height: 1px;
    background: Tokens.stroke;
}

// The program's icon, or a neutral glyph when it has none we can read.
component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> dim;
    width: 20px;
    height: 20px;
    if root.has-icon: Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        opacity: root.dim ? 0.45 : 1;
    }
    if !root.has-icon: Text {
        text: Mdl.app;
        font-family: Mdl.family;
        font-size: 16px;
        color: root.dim ? Tokens.text-3 : Tokens.text-2;
    }
}

// Label on the left, control on the right.
component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> hint-warning;
    spacing: Tokens.s3;
    VerticalLayout {
        width: 112px;
        alignment: start;
        padding-top: 7px;
        Text {
            text: root.label;
            color: Tokens.text-2;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        @children
        if root.hint != "": Text {
            text: root.hint;
            font-size: Tokens.caption;
            color: root.hint-warning ? Tokens.warning : Tokens.text-3;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }
}

// Fields reload from the model only when `serial` changes (a new selection),
// so typing is never fought by the round trip to C++.
component TextField inherits LineEdit {
    in property <string> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.text = root.value; }
    init => { self.text = root.value; }
    edited(t) => { OpenWithState.set-text(root.field, t); }
}

component FlagField inherits CheckBox {
    in property <bool> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.checked = root.value; }
    init => { self.checked = root.value; }
    toggled => { OpenWithState.set-flag(root.field, self.checked); }
}

component ChoiceField inherits ComboBox {
    in property <int> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.current-index = root.value; }
    init => { self.current-index = root.value; }
    selected => { OpenWithState.set-choice(root.field, self.current-index); }
}

component Mono inherits Text {
    font-family: EditorState.mono-font;
    font-size: Tokens.caption + 1px;
}

// One app: icon, name, where the program is; Locate… when it's missing,
// else the on/off switch. Clicking the row opens its editor below.
component AppItem inherits Rectangle {
    in property <OpenWithRow> entry;
    in property <bool> selected;
    in property <bool> locked;
    callback clicked();
    callback toggled(on: bool);
    callback locate();

    height: root.entry.own != "" ? 68px : 52px;
    background: root.selected ? Tokens.selected : ta.has-hover ? Tokens.hover : transparent;
    animate background { duration: Tokens.fast; }
    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-description: root.entry.detail;
    accessible-item-selected: root.selected;

    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: Tokens.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Tokens.s4;
        padding-right: Tokens.s4;
        spacing: Tokens.s3;
        VerticalLayout {
            alignment: center;
            AppIcon {
                icon: root.entry.icon;
                has-icon: root.entry.has-icon;
                dim: !root.entry.found;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: Tokens.s2;
                Text {
                    text: root.entry.name;
                    font-weight: 600;
                    color: root.entry.found ? Tokens.text : Tokens.text-3;
                    overflow: elide;
                }
                if root.entry.custom: Text {
                    text: @tr("Added by you");
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.entry.problem != "" && root.entry.found: Text {
                text: root.entry.problem;
                font-size: Tokens.caption;
                color: Tokens.warning;
                overflow: elide;
            }
            if root.entry.problem == "" || !root.entry.found: Mono {
                text: root.entry.detail;
                font-size: Tokens.caption;
                color: Tokens.text-3;
                overflow: elide;
            }
            // The app's own entries in the menu, which its switch hides too.
            if root.entry.own != "": Text {
                text: root.entry.own;
                font-size: Tokens.caption;
                color: Tokens.text-2;
                overflow: elide;
            }
        }
        if !root.entry.found: VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Locate…");
                enabled: !root.locked;
                clicked => { root.locate(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on: root.entry.enabled;
                enabled: !root.locked && root.entry.found;
                label: @tr("Show {} in the menu", root.entry.name);
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

// The selected app's settings, under its row.
component AppEditor inherits Rectangle {
    in property <bool> locked;
    background: Tokens.layer-2;

    VerticalLayout {
        padding-left: Tokens.s4 + 20px + Tokens.s3;
        padding-right: Tokens.s4;
        padding-top: Tokens.s3;
        padding-bottom: Tokens.s4;
        spacing: Tokens.s3;

        FormRow {
            label: @tr("Name");
            hint: OpenWithState.submenu ? @tr("Shown in the submenu as is.") : @tr("Shown as \"Open in {}\".", OpenWithState.form.name);
            TextField {
                field: "name";
                value: OpenWithState.form.name;
                serial: OpenWithState.form-serial;
                enabled: !root.locked;
                placeholder-text: "Zed";
            }
        }
        FormRow {
            label: @tr("Program");
            HorizontalLayout {
                spacing: Tokens.s2;
                TextField {
                    horizontal-stretch: 1;
                    field: "exe";
                    value: OpenWithState.form.exe;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: "C:\\Program Files\\App\\app.exe";
                }
                Button {
                    text: @tr("Browse…");
                    enabled: !root.locked;
                    clicked => { OpenWithState.browse-program(); }
                }
            }
        }
        FormRow {
            label: @tr("Arguments");
            hint: @tr("{{path}} the selected item, quoted · {{paths}} every selected item · {{dir}} its folder · {{name}} its name");
            TextField {
                field: "args";
                value: OpenWithState.form.args;
                serial: OpenWithState.form-serial;
                enabled: !root.locked;
                placeholder-text: "{path}";
            }
        }
        FormRow {
            label: @tr("Icon");
            HorizontalLayout {
                spacing: Tokens.s2;
                TextField {
                    horizontal-stretch: 1;
                    field: "icon";
                    value: OpenWithState.form.icon;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: @tr("The program's own icon");
                }
                Button {
                    text: @tr("Browse…");
                    enabled: !root.locked;
                    clicked => { OpenWithState.browse-icon(); }
                }
            }
        }
        FormRow {
            label: @tr("Shows for");
            HorizontalLayout {
                spacing: Tokens.s2;
                ChoiceField {
                    width: 260px;
                    enabled: !root.locked;
                    model: [@tr("Everything the menu shows on"), @tr("Files only"), @tr("Folders only"), @tr("Files with these extensions")];
                    field: "scope";
                    value: OpenWithState.form.scope;
                    serial: OpenWithState.form-serial;
                }
                if OpenWithState.form.scope == 3: TextField {
                    horizontal-stretch: 1;
                    field: "extensions";
                    value: OpenWithState.form.extensions;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: ".py .js .md";
                }
            }
        }
        if OpenWithState.form.own != "": FormRow {
            label: @tr("Its own items");
            hint: @tr("Switched off, the app also hides {}. Tick this to hide only the item this page adds.", OpenWithState.form.own);
            FlagField {
                text: @tr("Keep the app's own menu items when it's off");
                enabled: !root.locked;
                field: "keep-own";
                value: OpenWithState.form.keep-own;
                serial: OpenWithState.form-serial;
            }
        }
        FormRow {
            label: "";
            FlagField {
                text: @tr("Run as administrator");
                enabled: !root.locked;
                field: "admin";
                value: OpenWithState.form.admin;
                serial: OpenWithState.form-serial;
            }
        }

        // Test: the exact command line, nothing is started.
        HorizontalLayout {
            spacing: Tokens.s2;
            padding-left: 112px + Tokens.s3;
            Button {
                text: @tr("Button" => "Test");
                clicked => { OpenWithState.test(); }
            }
            Button {
                text: @tr("Move up");
                enabled: OpenWithState.can-up && !root.locked;
                clicked => { OpenWithState.move-up(); }
            }
            Button {
                text: @tr("Move down");
                enabled: OpenWithState.can-down && !root.locked;
                clicked => { OpenWithState.move-down(); }
            }
            if OpenWithState.form.custom: Button {
                text: @tr("Remove");
                enabled: !root.locked;
                clicked => { OpenWithState.remove(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if OpenWithState.test-shown: Rectangle {
            border-radius: Tokens.radius-sm;
            background: Tokens.layer;
            border-width: 1px;
            border-color: Tokens.stroke;
            VerticalLayout {
                padding: Tokens.s3;
                spacing: Tokens.s2;
                Text {
                    text: @tr("Clicking the item would run (nothing was started):");
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                }
                for line in OpenWithState.test-lines: VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: line.label;
                        font-size: Tokens.caption;
                        font-weight: 600;
                        color: Tokens.text-3;
                    }
                    Mono {
                        text: line.command;
                        color: Tokens.text;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
                if OpenWithState.test-note != "": Text {
                    text: OpenWithState.test-note;
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }
        }
    }
}

// Another program's own menu item: on (shown, the default) or off (a rule hides it).
// A shell extension's title is the app's own, so while it's off the title to
// hide can be corrected right there.
component OtherItem inherits Rectangle {
    in property <OtherAppRow> entry;
    in property <int> index;
    in property <bool> locked;

    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-description: root.entry.detail;

    VerticalLayout {
        padding-left: Tokens.s4;
        padding-right: Tokens.s4;
        padding-top: Tokens.s2 + 2px;
        padding-bottom: Tokens.s2 + 2px;
        spacing: Tokens.s2;
        HorizontalLayout {
            spacing: Tokens.s3;
            VerticalLayout {
                alignment: center;
                AppIcon {
                    icon: root.entry.icon;
                    has-icon: root.entry.has-icon;
                    dim: !root.entry.shown;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: Tokens.s2;
                    Text {
                        text: root.entry.title;
                        font-weight: 600;
                        color: root.entry.shown ? Tokens.text : Tokens.text-3;
                        overflow: elide;
                    }
                    if root.entry.tag != "": Text {
                        text: root.entry.tag;
                        font-size: Tokens.caption;
                        color: Tokens.text-3;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.entry.detail;
                    font-size: Tokens.caption;
                    color: root.entry.leftover && root.entry.shown ? Tokens.warning : Tokens.text-3;
                    overflow: elide;
                }
            }
            // A leftover of an uninstalled program: hiding it is the one thing to do.
            if root.entry.leftover && root.entry.shown: VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("Hide");
                    enabled: !root.locked;
                    clicked => { OpenWithState.other-toggle(root.index, false); }
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    on: root.entry.shown;
                    enabled: !root.locked;
                    label: @tr("Show {} in the menu", root.entry.title);
                    toggled(on) => { OpenWithState.other-toggle(root.index, on); }
                }
            }
        }
        if !root.entry.shown && root.entry.extension: HorizontalLayout {
            padding-left: 20px + Tokens.s3;
            spacing: Tokens.s3;
            Text {
                vertical-alignment: center;
                text: @tr("Title to hide");
                color: Tokens.text-2;
            }
            LineEdit {
                horizontal-stretch: 1;
                enabled: !root.locked;
                placeholder-text: @tr("Exactly as the menu shows it");
                init => { self.text = root.entry.hide-title; }
                edited(t) => { OpenWithState.other-title(root.index, t); }
            }
        }
        if !root.entry.shown && root.entry.problem != "": HorizontalLayout {
            padding-left: 20px + Tokens.s3;
            Text {
                text: root.entry.problem;
                font-size: Tokens.caption;
                color: Tokens.warning;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
        }
    }
}

// One row of the preview menu, sized like Shell's default theme.
component PreviewItem inherits Rectangle {
    in property <OpenWithPreviewRow> entry;
    property <bool> native: root.entry.kind == "native" || root.entry.kind == "native-menu";
    height: root.entry.kind == "sep" ? 9px : 32px;
    if root.entry.kind == "sep": Rectangle {
        x: 12px;
        y: 4px;
        width: root.width - 24px;
        height: 1px;
        background: Tokens.stroke-strong;
    }
    if root.entry.kind != "sep": Rectangle {
        x: 4px;
        width: root.width - 8px;
        height: root.height - 2px;
        border-radius: Tokens.radius-sm;
        background: root.entry.open ? Tokens.hover.with-alpha(Tokens.dark ? 0.12 : 0.07) : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                if root.entry.kind == "menu": Image {
                    source: Icons.open-with;
                    width: 16px;
                    height: 16px;
                    colorize: Tokens.text;
                }
                if root.entry.kind != "menu": Rectangle {
                    width: 16px;
                    height: 16px;
                    if root.entry.has-icon: Image {
                        source: root.entry.icon;
                        width: 16px;
                        height: 16px;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.entry.title;
                overflow: elide;
                color: root.native ? Tokens.text-3 : Tokens.text;
            }
            if root.entry.kind == "menu" || root.entry.kind == "native-menu": Text {
                vertical-alignment: center;
                text: Mdl.chevron;
                font-family: Mdl.family;
                font-size: 10px;
                color: Tokens.text-2;
            }
        }
    }
}

component PreviewMenu inherits Rectangle {
    in property <[OpenWithPreviewRow]> rows;
    width: 220px;
    height: list.preferred-height;
    background: Tokens.dark ? #2C2C2C : #F9F9F9;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.stroke-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    list := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        for r in root.rows: PreviewItem {
            entry: r;
        }
    }
}

export component OpenWithPage inherits PageFrame {
    property <bool> locked: OpenWithState.shared-config || !OpenWithState.loaded;
    property <int> bottom-tab: 0;
    // A narrow window (or a long translation): rows of options wrap.
    property <bool> narrow: root.width < 820px;
    init => { OpenWithState.activated(); }

    PageHeader {
        title: @tr("Open with");
        description: @tr("Open the selected file or folder in your editor or terminal from the right-click menu.");
        busy: OpenWithState.saving;
        busy-label: @tr("Checking and saving…");
        Button {
            text: @tr("Discard");
            enabled: OpenWithState.dirty && !OpenWithState.saving;
            clicked => { OpenWithState.discard(); }
        }
        Button {
            text: @tr("Save");
            primary: true;
            enabled: OpenWithState.dirty && !OpenWithState.saving && !root.locked;
            clicked => { OpenWithState.save(); }
        }
    }

    if OpenWithState.shared-config: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "info";
        title: @tr("This is the shared config in the install folder");
        text: @tr("It's read-only here, and Program Files is never written to. Create a personal copy in %APPDATA% to add apps to the menu.");
        action-label: @tr("Create personal config");
        action-enabled: !AppState.busy && AppState.cli-available;
        action => { OpenWithState.create-user-config(); }
    }
    if OpenWithState.import-off: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "warning";
        title: @tr("These items are turned off");
        text: @tr("shell.nss imports this file, but the line is commented out. Turn \"Open with\" back on in Context Menus to see them.");
        action-label: @tr("Open Context Menus");
        action => { OpenWithState.open-context-menus(); }
    }
    if OpenWithState.first-run && OpenWithState.loaded && !OpenWithState.shared-config: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "info";
        title: @tr("Not in your menu yet");
        text: OpenWithState.found-count == 0 ? @tr("None of the listed apps were found on this PC. Use Locate… or Add app, then Save.") : @tr("The editors found on this PC are switched on below; terminals and Notepad are off because the Terminal and Develop menus have them. Save to add them to the menu.");
    }
    if OpenWithState.notice != "": Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "warning";
        title: @tr("Part of the file can't be shown here");
        text: OpenWithState.notice;
    }
    if OpenWithState.load-error != "": Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "error";
        title: @tr("Couldn't read the Open with items");
        text: OpenWithState.load-error;
    }

    SectionHead {
        title: @tr("Apps");
        caption: !OpenWithState.loaded ? @tr("Looking for installed apps…") : @tr("Found {0} of {1} known apps on this PC. An item stays hidden while its program is missing.", OpenWithState.found-count, OpenWithState.preset-count);
        Button {
            text: @tr("Add app");
            enabled: !root.locked;
            clicked => { OpenWithState.add-custom(); }
        }
    }
    ListSurface {
        if OpenWithState.rows.length == 0: Text {
            height: 52px;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: OpenWithState.loaded ? @tr("No apps.") : @tr("Looking for installed apps…");
            color: Tokens.text-3;
        }
        // Presets that weren't found stay folded away until asked for (or selected).
        for r[i] in OpenWithState.rows: row := VerticalLayout {
            property <bool> folded: !r.found && !r.custom && !OpenWithState.show-missing && i != OpenWithState.selected;
            if i > 0 && !row.folded: Hairline { }
            if !row.folded: AppItem {
                entry: r;
                selected: i == OpenWithState.selected;
                locked: root.locked;
                clicked => { OpenWithState.select(i == OpenWithState.selected ? -1 : i); }
                toggled(on) => { OpenWithState.toggle(i, on); }
                locate => { OpenWithState.locate(i); }
            }
            if i == OpenWithState.selected: AppEditor {
                locked: root.locked;
            }
        }
        if OpenWithState.missing-count > 0: VerticalLayout {
            Hairline { }
            HorizontalLayout {
                padding-left: Tokens.s4;
                padding-top: Tokens.s3;
                padding-bottom: Tokens.s2;
                Link {
                    font-size: Tokens.caption + 1px;
                    text: OpenWithState.show-missing ? @tr("Hide the apps that weren't found") : @tr("Show {n} more app that wasn't found on this PC" | "Show {n} more apps that weren't found on this PC" % OpenWithState.missing-count);
                    activated => { OpenWithState.show-missing = !OpenWithState.show-missing; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    SectionHead {
        title: @tr("In the menu");
        caption: OpenWithState.options-problem != "" ? OpenWithState.options-problem : @tr("Where the items show, and whether they're grouped in a submenu.");
    }
    ListSurface {
        VerticalLayout {
            padding-left: Tokens.s4;
            padding-right: Tokens.s4;
            padding-top: Tokens.s3;
            padding-bottom: Tokens.s3;
            spacing: Tokens.s3;
            FormRow {
                label: @tr("Layout");
                hint: OpenWithState.submenu ? @tr("One submenu with each app inside it, right under WinRAR; without WinRAR, under \"Open in new window\"; otherwise at the top of the menu.") : @tr("Each app is its own \"Open in …\" item, in this order, right under WinRAR; without WinRAR, under \"Open in new window\"; otherwise at the top of the menu.");
                FlagField {
                    text: @tr("Group in an \"Open in\" submenu");
                    enabled: !root.locked;
                    field: "submenu";
                    value: OpenWithState.submenu;
                    serial: OpenWithState.options-serial;
                }
            }
            if OpenWithState.submenu: FormRow {
                label: @tr("Submenu title");
                hint: @tr("Windows already has an \"Open with\" item on files, so a different title tells them apart.");
                TextField {
                    field: "title";
                    value: OpenWithState.title;
                    serial: OpenWithState.options-serial;
                    enabled: !root.locked;
                    placeholder-text: "Open in";
                }
            }
            FormRow {
                label: @tr("Shows on");
                // Four in a row, or two rows of two in a narrow window.
                HorizontalLayout {
                    spacing: Tokens.s4;
                    FlagField {
                        text: @tr("Files");
                        enabled: !root.locked;
                        field: "files";
                        value: OpenWithState.show-files;
                        serial: OpenWithState.options-serial;
                    }
                    FlagField {
                        text: @tr("Folders");
                        enabled: !root.locked;
                        field: "folders";
                        value: OpenWithState.show-folders;
                        serial: OpenWithState.options-serial;
                    }
                    if !root.narrow: FlagField {
                        text: @tr("Folder background");
                        enabled: !root.locked;
                        field: "background";
                        value: OpenWithState.show-background;
                        serial: OpenWithState.options-serial;
                    }
                    if !root.narrow: FlagField {
                        text: @tr("Desktop");
                        enabled: !root.locked;
                        field: "desktop";
                        value: OpenWithState.show-desktop;
                        serial: OpenWithState.options-serial;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.narrow: HorizontalLayout {
                    spacing: Tokens.s4;
                    FlagField {
                        text: @tr("Folder background");
                        enabled: !root.locked;
                        field: "background";
                        value: OpenWithState.show-background;
                        serial: OpenWithState.options-serial;
                    }
                    FlagField {
                        text: @tr("Desktop");
                        enabled: !root.locked;
                        field: "desktop";
                        value: OpenWithState.show-desktop;
                        serial: OpenWithState.options-serial;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Hairline { }
        VerticalLayout {
            padding: Tokens.s3;
            spacing: Tokens.s2;
            HorizontalLayout {
                spacing: Tokens.s3;
                Segmented {
                    width: 240px;
                    options: [@tr("Preview"), @tr("Generated .nss")];
                    selected: root.bottom-tab;
                    changed(i) => { root.bottom-tab = i; }
                }
                if root.bottom-tab == 0 && !root.narrow: Segmented {
                    width: 300px;
                    options: [@tr("A file"), @tr("A folder"), @tr("Right-click target" => "Background")];
                    selected: OpenWithState.preview-kind;
                    changed(i) => { OpenWithState.set-preview-kind(i); }
                }
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    text: root.bottom-tab == 0 ? @tr("Approximate") : @tr("Save writes {}", OpenWithState.file-label);
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                    overflow: elide;
                }
            }
            // A narrow window: the preview's target on its own row.
            if root.bottom-tab == 0 && root.narrow: HorizontalLayout {
                alignment: start;
                Segmented {
                    width: 300px;
                    options: [@tr("A file"), @tr("A folder"), @tr("Right-click target" => "Background")];
                    selected: OpenWithState.preview-kind;
                    changed(i) => { OpenWithState.set-preview-kind(i); }
                }
            }
            if root.bottom-tab == 0: Rectangle {
                height: max(120px, max(OpenWithState.preview.length, OpenWithState.flyout.length) * 32px + 40px);
                border-radius: Tokens.radius-sm;
                background: Tokens.dark ? #1C1C1C : #E9E9E9;
                clip: true;
                // Nothing of ours shows: said next to Explorer's own items.
                if OpenWithState.preview-empty != "": Text {
                    x: main.x + main.width + Tokens.s4;
                    y: main.y + 8px;
                    width: parent.width - self.x - Tokens.s4;
                    text: OpenWithState.preview-empty;
                    color: Tokens.text-3;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                main := PreviewMenu {
                    x: Tokens.s4;
                    y: Tokens.s3;
                    visible: OpenWithState.preview.length > 0;
                    rows: OpenWithState.preview;
                }
                if OpenWithState.flyout.length > 0: PreviewMenu {
                    x: main.x + main.width - 2px;
                    y: main.y;
                    rows: OpenWithState.flyout;
                }
            }
            if root.bottom-tab == 1: Rectangle {
                height: min(320px, max(120px, OpenWithState.code.length * CodeColors.row-height + 16px));
                border-radius: Tokens.radius-sm;
                background: Tokens.layer-2;
                code := ListView {
                    width: 100%;
                    height: 100%;
                    content-width: max(self.visible-width, 56px + OpenWithState.code-columns * CodeColors.column-width + Tokens.s6);
                    for line in OpenWithState.code: CodeRow {
                        width: code.content-width;
                        line: line;
                        font: EditorState.mono-font;
                    }
                }
            }
        }
    }

    SectionHead {
        title: @tr("Other apps' menu items");
        caption: @tr("Items other programs put in the menu themselves, such as VLC or 7-Zip. Switch one off to hide it in Shell's menu; the program and the registry stay as they are. The items of apps in the list above go with their app's switch, and Windows' own items aren't listed.");
    }
    ListSurface {
        if !OpenWithState.others-loaded || OpenWithState.others.length == 0: Text {
            height: 52px;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: OpenWithState.others-loaded ? @tr("No other program adds items to the menu for files, folders or drives.") : @tr("Reading the registry…");
            color: Tokens.text-3;
        }
        for o[i] in OpenWithState.others: VerticalLayout {
            if i > 0: Hairline { }
            // "Leftovers from uninstalled programs" over the first ones, "Other items" over the rest.
            if o.section != "": HorizontalLayout {
                padding-left: Tokens.s4;
                padding-right: Tokens.s4;
                padding-top: Tokens.s2;
                spacing: Tokens.s3;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: o.section;
                        font-size: Tokens.caption + 1px;
                        font-weight: 600;
                        color: Tokens.text-2;
                    }
                    if o.leftover: Text {
                        text: @tr("Their program is gone, so these items do nothing. Hiding one adds a remove() rule; the registry stays as it is.");
                        font-size: Tokens.caption;
                        color: Tokens.text-3;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
                if o.leftover && OpenWithState.others-leftovers > 1: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Hide all {}", OpenWithState.others-leftovers);
                        enabled: !root.locked;
                        clicked => { OpenWithState.hide-leftovers(); }
                    }
                }
            }
            OtherItem {
                entry: o;
                index: i;
                locked: root.locked;
            }
        }
        if OpenWithState.others-hidden > 0: VerticalLayout {
            Hairline { }
            HorizontalLayout {
                padding-left: Tokens.s4;
                padding-right: Tokens.s4;
                height: 36px;
                Text {
                    vertical-alignment: center;
                    text: @tr("Switched off: {0}. Each is a remove() rule in {1}, after the Open in items.", OpenWithState.others-hidden, OpenWithState.file-label);
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    overflow: elide;
                }
            }
        }
    }

    if OpenWithState.develop-found: SectionHead {
        title: @tr("Develop menu");
    }
    if OpenWithState.develop-found: ListSurface {
        HorizontalLayout {
            padding-left: Tokens.s4;
            padding-right: Tokens.s4;
            padding-top: Tokens.s3;
            padding-bottom: Tokens.s3;
            spacing: Tokens.s3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text {
                    text: @tr("Hide Develop › Editors");
                    font-weight: 600;
                    color: Tokens.text;
                }
                Text {
                    text: OpenWithState.develop-locked ? @tr("develop.nss has its own VS Code and Notepad items, shown while Shift is held. It's read-only here.") : @tr("develop.nss has its own VS Code and Notepad items. They only show while Shift is held, so they're left alone by default. Turn this on to keep your editors in one place; the lines are commented out, not deleted.");
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    on: OpenWithState.develop-hidden;
                    enabled: !root.locked && !OpenWithState.develop-locked;
                    label: @tr("Hide Develop › Editors");
                    toggled(on) => { OpenWithState.set-flag("hide-develop", on); }
                }
            }
        }
    }
}
