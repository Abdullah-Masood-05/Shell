import { Button, CheckBox, ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState } from "../types.slint";
import { EditorState } from "../editor-types.slint";
import { OpenWithState, OpenWithRow, OpenWithPreviewRow } from "../openwith-types.slint";
import { Banner } from "../components/banner.slint";
import { PageHeader } from "../components/page-header.slint";
import { Link, Segmented } from "../components/controls.slint";
import { Toggle } from "../components/toggle.slint";
import { CodeColors, CodeRow } from "../components/code.slint";
import { PageFrame } from "page-frame.slint";

global Mdl {
    // Segoe MDL2 Assets (on every Windows 10/11)
    out property <string> family: "Segoe MDL2 Assets";
    out property <string> app: "\u{E7AC}";      // OpenWith
    out property <string> chevron: "\u{E76C}";
}

component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> caption;
    spacing: Tokens.s3;
    padding-top: Tokens.s2;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: end;
        Text {
            text: root.title;
            font-size: Tokens.body-large;
            font-weight: 600;
            color: Tokens.text;
        }
        if root.caption != "": Text {
            text: root.caption;
            font-size: Tokens.caption + 1px;
            color: Tokens.text-2;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: end;
        @children
    }
}

component ListSurface inherits Rectangle {
    background: Tokens.layer;
    border-radius: Tokens.radius-card;
    border-width: 1px;
    border-color: Tokens.stroke;
    VerticalLayout {
        padding-top: Tokens.s1;
        padding-bottom: Tokens.s1;
        @children
    }
}

component Hairline inherits Rectangle {
    height: 1px;
    background: Tokens.stroke;
}

// The program's icon, or a neutral glyph when it has none we can read.
component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> dim;
    width: 20px;
    height: 20px;
    if root.has-icon: Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        opacity: root.dim ? 0.45 : 1;
    }
    if !root.has-icon: Text {
        text: Mdl.app;
        font-family: Mdl.family;
        font-size: 16px;
        color: root.dim ? Tokens.text-3 : Tokens.text-2;
    }
}

// Label on the left, control on the right.
component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> hint-warning;
    spacing: Tokens.s3;
    VerticalLayout {
        width: 112px;
        alignment: start;
        padding-top: 7px;
        Text {
            text: root.label;
            color: Tokens.text-2;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        @children
        if root.hint != "": Text {
            text: root.hint;
            font-size: Tokens.caption;
            color: root.hint-warning ? Tokens.warning : Tokens.text-3;
            wrap: word-wrap;
        }
    }
}

// Fields reload from the model only when `serial` changes (a new selection),
// so typing is never fought by the round trip to C++.
component TextField inherits LineEdit {
    in property <string> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.text = root.value; }
    init => { self.text = root.value; }
    edited(t) => { OpenWithState.set-text(root.field, t); }
}

component FlagField inherits CheckBox {
    in property <bool> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.checked = root.value; }
    init => { self.checked = root.value; }
    toggled => { OpenWithState.set-flag(root.field, self.checked); }
}

component ChoiceField inherits ComboBox {
    in property <int> value;
    in property <int> serial;
    in property <string> field;
    changed serial => { self.current-index = root.value; }
    init => { self.current-index = root.value; }
    selected => { OpenWithState.set-choice(root.field, self.current-index); }
}

component Mono inherits Text {
    font-family: EditorState.mono-font;
    font-size: Tokens.caption + 1px;
}

// One app: icon, name, where the program is; Locate… when it's missing,
// else the on/off switch. Clicking the row opens its editor below.
component AppItem inherits Rectangle {
    in property <OpenWithRow> entry;
    in property <bool> selected;
    in property <bool> locked;
    callback clicked();
    callback toggled(on: bool);
    callback locate();

    height: 52px;
    background: root.selected ? Tokens.selected : ta.has-hover ? Tokens.hover : transparent;
    animate background { duration: Tokens.fast; }
    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-description: root.entry.detail;
    accessible-item-selected: root.selected;

    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: Tokens.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Tokens.s4;
        padding-right: Tokens.s4;
        spacing: Tokens.s3;
        VerticalLayout {
            alignment: center;
            AppIcon {
                icon: root.entry.icon;
                has-icon: root.entry.has-icon;
                dim: !root.entry.found;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: Tokens.s2;
                Text {
                    text: root.entry.name;
                    font-weight: 600;
                    color: root.entry.found ? Tokens.text : Tokens.text-3;
                    overflow: elide;
                }
                if root.entry.custom: Text {
                    text: "Added by you";
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.entry.problem != "" && root.entry.found: Text {
                text: root.entry.problem;
                font-size: Tokens.caption;
                color: Tokens.warning;
                overflow: elide;
            }
            if root.entry.problem == "" || !root.entry.found: Mono {
                text: root.entry.detail;
                font-size: Tokens.caption;
                color: Tokens.text-3;
                overflow: elide;
            }
        }
        if !root.entry.found: VerticalLayout {
            alignment: center;
            Button {
                text: "Locate…";
                enabled: !root.locked;
                clicked => { root.locate(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                on: root.entry.enabled;
                enabled: !root.locked && root.entry.found;
                label: "Show " + root.entry.name + " in the menu";
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

// The selected app's settings, under its row.
component AppEditor inherits Rectangle {
    in property <bool> locked;
    background: Tokens.layer-2;

    VerticalLayout {
        padding-left: Tokens.s4 + 20px + Tokens.s3;
        padding-right: Tokens.s4;
        padding-top: Tokens.s3;
        padding-bottom: Tokens.s4;
        spacing: Tokens.s3;

        FormRow {
            label: "Name";
            hint: OpenWithState.submenu ? "Shown in the submenu as is." : "Shown as \"Open in " + OpenWithState.form.name + "\".";
            TextField {
                field: "name";
                value: OpenWithState.form.name;
                serial: OpenWithState.form-serial;
                enabled: !root.locked;
                placeholder-text: "Zed";
            }
        }
        FormRow {
            label: "Program";
            HorizontalLayout {
                spacing: Tokens.s2;
                TextField {
                    horizontal-stretch: 1;
                    field: "exe";
                    value: OpenWithState.form.exe;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: "C:\\Program Files\\App\\app.exe";
                }
                Button {
                    text: "Browse…";
                    enabled: !root.locked;
                    clicked => { OpenWithState.browse-program(); }
                }
            }
        }
        FormRow {
            label: "Arguments";
            hint: "{path} the selected item, quoted · {paths} every selected item · {dir} its folder · {name} its name";
            TextField {
                field: "args";
                value: OpenWithState.form.args;
                serial: OpenWithState.form-serial;
                enabled: !root.locked;
                placeholder-text: "{path}";
            }
        }
        FormRow {
            label: "Icon";
            HorizontalLayout {
                spacing: Tokens.s2;
                TextField {
                    horizontal-stretch: 1;
                    field: "icon";
                    value: OpenWithState.form.icon;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: "The program's own icon";
                }
                Button {
                    text: "Browse…";
                    enabled: !root.locked;
                    clicked => { OpenWithState.browse-icon(); }
                }
            }
        }
        FormRow {
            label: "Shows for";
            HorizontalLayout {
                spacing: Tokens.s2;
                ChoiceField {
                    width: 260px;
                    enabled: !root.locked;
                    model: ["Everything the menu shows on", "Files only", "Folders only", "Files with these extensions"];
                    field: "scope";
                    value: OpenWithState.form.scope;
                    serial: OpenWithState.form-serial;
                }
                if OpenWithState.form.scope == 3: TextField {
                    horizontal-stretch: 1;
                    field: "extensions";
                    value: OpenWithState.form.extensions;
                    serial: OpenWithState.form-serial;
                    enabled: !root.locked;
                    placeholder-text: ".py .js .md";
                }
            }
        }
        FormRow {
            label: "";
            FlagField {
                text: "Run as administrator";
                enabled: !root.locked;
                field: "admin";
                value: OpenWithState.form.admin;
                serial: OpenWithState.form-serial;
            }
        }

        // Test: the exact command line, nothing is started.
        HorizontalLayout {
            spacing: Tokens.s2;
            padding-left: 112px + Tokens.s3;
            Button {
                text: "Test";
                clicked => { OpenWithState.test(); }
            }
            Button {
                text: "Move up";
                enabled: OpenWithState.can-up && !root.locked;
                clicked => { OpenWithState.move-up(); }
            }
            Button {
                text: "Move down";
                enabled: OpenWithState.can-down && !root.locked;
                clicked => { OpenWithState.move-down(); }
            }
            if OpenWithState.form.custom: Button {
                text: "Remove";
                enabled: !root.locked;
                clicked => { OpenWithState.remove(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if OpenWithState.test-shown: Rectangle {
            border-radius: Tokens.radius-control;
            background: Tokens.layer;
            border-width: 1px;
            border-color: Tokens.stroke;
            VerticalLayout {
                padding: Tokens.s3;
                spacing: Tokens.s2;
                Text {
                    text: "Clicking the item would run (nothing was started):";
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                }
                for line in OpenWithState.test-lines: VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: line.label;
                        font-size: Tokens.caption;
                        font-weight: 600;
                        color: Tokens.text-3;
                    }
                    Mono {
                        text: line.command;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                }
                if OpenWithState.test-note != "": Text {
                    text: OpenWithState.test-note;
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// One row of the preview menu, sized like Shell's default theme.
component PreviewItem inherits Rectangle {
    in property <OpenWithPreviewRow> entry;
    property <bool> native: root.entry.kind == "native" || root.entry.kind == "native-menu";
    height: root.entry.kind == "sep" ? 9px : 32px;
    if root.entry.kind == "sep": Rectangle {
        x: 12px;
        y: 4px;
        width: root.width - 24px;
        height: 1px;
        background: Tokens.stroke-strong;
    }
    if root.entry.kind != "sep": Rectangle {
        x: 4px;
        width: root.width - 8px;
        height: root.height - 2px;
        border-radius: Tokens.radius-control;
        background: root.entry.open ? Tokens.hover.with-alpha(Tokens.dark ? 0.12 : 0.07) : transparent;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                if root.entry.kind == "menu": Image {
                    source: Icons.open-with;
                    width: 16px;
                    height: 16px;
                    colorize: Tokens.text;
                }
                if root.entry.kind != "menu": Rectangle {
                    width: 16px;
                    height: 16px;
                    if root.entry.has-icon: Image {
                        source: root.entry.icon;
                        width: 16px;
                        height: 16px;
                    }
                }
            }
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.entry.title;
                overflow: elide;
                color: root.native ? Tokens.text-3 : Tokens.text;
            }
            if root.entry.kind == "menu" || root.entry.kind == "native-menu": Text {
                vertical-alignment: center;
                text: Mdl.chevron;
                font-family: Mdl.family;
                font-size: 10px;
                color: Tokens.text-2;
            }
        }
    }
}

component PreviewMenu inherits Rectangle {
    in property <[OpenWithPreviewRow]> rows;
    width: 220px;
    height: list.preferred-height;
    background: Tokens.dark ? #2C2C2C : #F9F9F9;
    border-radius: Tokens.radius-card;
    border-width: 1px;
    border-color: Tokens.stroke-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    list := VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        for r in root.rows: PreviewItem {
            entry: r;
        }
    }
}

export component OpenWithPage inherits PageFrame {
    property <bool> locked: OpenWithState.shared-config || !OpenWithState.loaded;
    property <int> bottom-tab: 0;
    init => { OpenWithState.activated(); }

    PageHeader {
        title: "Open with";
        description: "Open the selected file or folder in your editor or terminal from the right-click menu.";
        busy: OpenWithState.saving;
        busy-label: "Checking and saving…";
        Button {
            text: "Discard";
            enabled: OpenWithState.dirty && !OpenWithState.saving;
            clicked => { OpenWithState.discard(); }
        }
        Button {
            text: "Save";
            primary: true;
            enabled: OpenWithState.dirty && !OpenWithState.saving && !root.locked;
            clicked => { OpenWithState.save(); }
        }
    }

    if OpenWithState.shared-config: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "info";
        title: "This is the shared config in the install folder";
        text: "It's read-only here, and Program Files is never written to. Create a personal copy in %APPDATA% to add apps to the menu.";
        action-label: "Create personal config";
        action-enabled: !AppState.busy && AppState.cli-available;
        action => { OpenWithState.create-user-config(); }
    }
    if OpenWithState.import-off: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "warning";
        title: "These items are turned off";
        text: "shell.nss imports this file, but the line is commented out. Turn \"Open with\" back on in Context Menus to see them.";
        action-label: "Open Context Menus";
        action => { OpenWithState.open-context-menus(); }
    }
    if OpenWithState.first-run && OpenWithState.loaded && !OpenWithState.shared-config: Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "info";
        title: "Not in your menu yet";
        text: OpenWithState.found-count == 0 ? "None of the listed apps were found on this PC. Use Locate… or Add app, then Save." : "The editors found on this PC are switched on below; terminals and Notepad are off because the Terminal and Develop menus have them. Save to add them to the menu.";
    }
    if OpenWithState.notice != "": Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "warning";
        title: "Part of the file can't be shown here";
        text: OpenWithState.notice;
    }
    if OpenWithState.load-error != "": Banner {
        height: self.preferred-height; // never squeezed when the page scrolls
        kind: "error";
        title: "Couldn't read the Open with items";
        text: OpenWithState.load-error;
    }

    SectionHead {
        title: "Apps";
        caption: !OpenWithState.loaded ? "Looking for installed apps…" : "Found " + OpenWithState.found-count + " of " + OpenWithState.preset-count + " known apps on this PC. An item stays hidden while its program is missing.";
        Button {
            text: "Add app";
            enabled: !root.locked;
            clicked => { OpenWithState.add-custom(); }
        }
    }
    ListSurface {
        if OpenWithState.rows.length == 0: Text {
            height: 52px;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: OpenWithState.loaded ? "No apps." : "Looking for installed apps…";
            color: Tokens.text-3;
        }
        // Presets that weren't found stay folded away until asked for (or selected).
        for r[i] in OpenWithState.rows: row := VerticalLayout {
            property <bool> folded: !r.found && !r.custom && !OpenWithState.show-missing && i != OpenWithState.selected;
            if i > 0 && !row.folded: Hairline { }
            if !row.folded: AppItem {
                entry: r;
                selected: i == OpenWithState.selected;
                locked: root.locked;
                clicked => { OpenWithState.select(i == OpenWithState.selected ? -1 : i); }
                toggled(on) => { OpenWithState.toggle(i, on); }
                locate => { OpenWithState.locate(i); }
            }
            if i == OpenWithState.selected: AppEditor {
                locked: root.locked;
            }
        }
        if OpenWithState.missing-count > 0: VerticalLayout {
            Hairline { }
            HorizontalLayout {
                padding-left: Tokens.s4;
                padding-top: Tokens.s3;
                padding-bottom: Tokens.s2;
                Link {
                    font-size: Tokens.caption + 1px;
                    text: OpenWithState.show-missing ? "Hide the apps that weren't found" : "Show " + OpenWithState.missing-count + (OpenWithState.missing-count == 1 ? " more app that wasn't found on this PC" : " more apps that weren't found on this PC");
                    activated => { OpenWithState.show-missing = !OpenWithState.show-missing; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    SectionHead {
        title: "In the menu";
        caption: OpenWithState.options-problem != "" ? OpenWithState.options-problem : "Where the items show, and whether they're grouped in a submenu.";
    }
    ListSurface {
        VerticalLayout {
            padding-left: Tokens.s4;
            padding-right: Tokens.s4;
            padding-top: Tokens.s3;
            padding-bottom: Tokens.s3;
            spacing: Tokens.s3;
            FormRow {
                label: "Layout";
                hint: OpenWithState.submenu ? "One submenu at the top of the menu, with each app inside it." : "Each app is its own \"Open in …\" item at the top of the menu, next to Explorer's \"Open\" items.";
                FlagField {
                    text: "Group in an \"Open in\" submenu";
                    enabled: !root.locked;
                    field: "submenu";
                    value: OpenWithState.submenu;
                    serial: OpenWithState.options-serial;
                }
            }
            if OpenWithState.submenu: FormRow {
                label: "Submenu title";
                hint: "Windows already has an \"Open with\" item on files, so a different title tells them apart.";
                TextField {
                    field: "title";
                    value: OpenWithState.title;
                    serial: OpenWithState.options-serial;
                    enabled: !root.locked;
                    placeholder-text: "Open in";
                }
            }
            FormRow {
                label: "Shows on";
                HorizontalLayout {
                    spacing: Tokens.s4;
                    FlagField {
                        text: "Files";
                        enabled: !root.locked;
                        field: "files";
                        value: OpenWithState.show-files;
                        serial: OpenWithState.options-serial;
                    }
                    FlagField {
                        text: "Folders";
                        enabled: !root.locked;
                        field: "folders";
                        value: OpenWithState.show-folders;
                        serial: OpenWithState.options-serial;
                    }
                    FlagField {
                        text: "Folder background";
                        enabled: !root.locked;
                        field: "background";
                        value: OpenWithState.show-background;
                        serial: OpenWithState.options-serial;
                    }
                    FlagField {
                        text: "Desktop";
                        enabled: !root.locked;
                        field: "desktop";
                        value: OpenWithState.show-desktop;
                        serial: OpenWithState.options-serial;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Hairline { }
        VerticalLayout {
            padding: Tokens.s3;
            spacing: Tokens.s2;
            HorizontalLayout {
                spacing: Tokens.s3;
                Segmented {
                    width: 240px;
                    options: ["Preview", "Generated .nss"];
                    selected: root.bottom-tab;
                    changed(i) => { root.bottom-tab = i; }
                }
                if root.bottom-tab == 0: Segmented {
                    width: 300px;
                    options: ["A file", "A folder", "Background"];
                    selected: OpenWithState.preview-kind;
                    changed(i) => { OpenWithState.set-preview-kind(i); }
                }
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    text: root.bottom-tab == 0 ? "Approximate" : "Save writes " + OpenWithState.file-label;
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                    overflow: elide;
                }
            }
            if root.bottom-tab == 0: Rectangle {
                height: max(120px, max(OpenWithState.preview.length, OpenWithState.flyout.length) * 32px + 40px);
                border-radius: Tokens.radius-control;
                background: Tokens.dark ? #1C1C1C : #E9E9E9;
                clip: true;
                // Nothing of ours shows: said next to Explorer's own items.
                if OpenWithState.preview-empty != "": Text {
                    x: main.x + main.width + Tokens.s4;
                    y: main.y + 8px;
                    width: parent.width - self.x - Tokens.s4;
                    text: OpenWithState.preview-empty;
                    color: Tokens.text-3;
                    wrap: word-wrap;
                }
                main := PreviewMenu {
                    x: Tokens.s4;
                    y: Tokens.s3;
                    visible: OpenWithState.preview.length > 0;
                    rows: OpenWithState.preview;
                }
                if OpenWithState.flyout.length > 0: PreviewMenu {
                    x: main.x + main.width - 2px;
                    y: main.y;
                    rows: OpenWithState.flyout;
                }
            }
            if root.bottom-tab == 1: Rectangle {
                height: min(320px, max(120px, OpenWithState.code.length * CodeColors.row-height + 16px));
                border-radius: Tokens.radius-control;
                background: Tokens.layer-2;
                code := ListView {
                    width: 100%;
                    height: 100%;
                    content-width: max(self.visible-width, 56px + OpenWithState.code-columns * CodeColors.column-width + Tokens.s6);
                    for line in OpenWithState.code: CodeRow {
                        width: code.content-width;
                        line: line;
                        font: EditorState.mono-font;
                    }
                }
            }
        }
    }

    if OpenWithState.develop-found: SectionHead {
        title: "Develop menu";
    }
    if OpenWithState.develop-found: ListSurface {
        HorizontalLayout {
            padding-left: Tokens.s4;
            padding-right: Tokens.s4;
            padding-top: Tokens.s3;
            padding-bottom: Tokens.s3;
            spacing: Tokens.s3;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text {
                    text: "Hide Develop › Editors";
                    font-weight: 600;
                    color: Tokens.text;
                }
                Text {
                    text: OpenWithState.develop-locked ? "develop.nss has its own VS Code and Notepad items, shown while Shift is held. It's read-only here." : "develop.nss has its own VS Code and Notepad items. They only show while Shift is held, so they're left alone by default. Turn this on to keep your editors in one place; the lines are commented out, not deleted.";
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    on: OpenWithState.develop-hidden;
                    enabled: !root.locked && !OpenWithState.develop-locked;
                    label: "Hide Develop › Editors";
                    toggled(on) => { OpenWithState.set-flag("hide-develop", on); }
                }
            }
        }
    }
}
