import { AboutSlint } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState } from "../types.slint";
import { Card, KeyValue } from "../components/card.slint";
import { PageHeader } from "../components/page-header.slint";
import { AppButton, Link, Segmented } from "../components/controls.slint";
import { PageFrame } from "page-frame.slint";
import { UpdateState } from "../update-state.slint";
import { ProgressBar } from "../components/update-banner.slint";
import { ToggleSwitch, RowDivider } from "../components/theme-controls.slint";

// A setting with a one-line explanation and a switch on the right.
component PrefSwitch inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    in property <bool> on;
    callback toggled(on: bool);
    spacing: Tokens.s4;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: Tokens.body;
            color: Tokens.text;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
        Text {
            text: root.hint;
            font-size: Tokens.caption;
            color: Tokens.text-3;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }
    ToggleSwitch {
        on: root.on;
        label: root.label;
        toggled(v) => { root.toggled(v); }
    }
}

export component PreferencesPage inherits PageFrame {
    PageHeader {
        title: @tr("Preferences");
        description: @tr("How this app looks, updates, machine-wide registration, and about.");
        busy: AppState.busy;
        busy-label: AppState.busy-label;
    }

    Card {
        icon: Icons.moon;
        heading: @tr("App theme");
        description: @tr("System follows the Windows app mode and changes with it.");
        HorizontalLayout {
            alignment: start;
            Segmented {
                width: 300px;
                options: [@tr("System"), @tr("Light"), @tr("Dark")];
                selected: AppState.theme-mode;
                changed(i) => { AppState.set-theme(i); }
            }
        }
    }

    Card {
        icon: Icons.language;
        heading: @tr("Language");
        description: @tr("Auto follows the Windows display language, which is {} now. A change applies right away.", AppState.language-auto-name);
        HorizontalLayout {
            alignment: start;
            Segmented {
                width: max(400px, self.min-width);
                min-option-width: 96px;
                options: AppState.language-options;
                option-fonts: AppState.language-option-fonts;
                selected <=> AppState.language-index;
                changed(i) => { AppState.set-language(i); }
            }
        }
        // For translators: show the app in a .po file for this session.
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.s3;
            Link {
                text: @tr("Test a translation file…");
                activated => { AppState.test-translation(); }
            }
            Text {
                text: @tr("For translators: shows the app in a .po file until you stop it or close the app.");
                font-size: Tokens.caption;
                color: Tokens.text-3;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }

    Card {
        icon: Icons.person;
        heading: @tr("All users on this PC");
        description: @tr("Registering Shell for everyone on this PC needs administrator rights. Everything else in this app works without them.");
        KeyValue {
            key: @tr("All users");
            value: !AppState.status.loaded ? "—" : AppState.status.machine-registered ? @tr("Registered") : @tr("Not registered");
        }
        KeyValue {
            key: @tr("Just you");
            value: !AppState.status.loaded ? "—" : AppState.status.user-registered ? @tr("Registered") : @tr("Not registered");
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.s2;
            AppButton {
                text: AppState.status.machine-registered ? @tr("Unregister for all users") : @tr("Register for all users");
                icon: AppState.shield-icon;
                icon-size: 16px;
                enabled: !AppState.busy && AppState.cli-available && AppState.status.loaded;
                clicked => { AppState.action(AppState.status.machine-registered ? "unregister-machine" : "register-machine"); }
            }
        }
    }

    Card {
        icon: Icons.download;
        heading: @tr("Updates");
        description: @tr("New versions come from this project's GitHub releases and are checked against their SHA-256 sums before anything is installed.");
        KeyValue {
            key: @tr("Version");
            value: UpdateState.per-user-app ? @tr("{}  ·  app updated for you; Shell core {} for all users", UpdateState.current-version, UpdateState.installed-release)
                : UpdateState.install-kind == "msi" ? @tr("{}  ·  installed for all users (MSI)", UpdateState.current-version)
                : UpdateState.install-kind == "portable" ? @tr("{}  ·  portable copy", UpdateState.current-version)
                : UpdateState.current-version;
        }
        HorizontalLayout {
            spacing: Tokens.s3;
            Text {
                text: @tr("Channel");
                width: 132px;
                font-size: Tokens.body;
                color: Tokens.text-2;
                vertical-alignment: center;
            }
            Segmented {
                width: 220px;
                min-option-width: 100px;
                options: [@tr("Stable"), @tr("Beta")];
                selected: UpdateState.channel;
                changed(i) => { UpdateState.set-channel(i); }
            }
            Text {
                horizontal-stretch: 1;
                text: UpdateState.channel == 1 ? @tr("Pre-releases too") : @tr("Releases only");
                font-size: Tokens.caption;
                color: Tokens.text-3;
                vertical-alignment: center;
            }
        }
        RowDivider { }
        PrefSwitch {
            label: @tr("Check for updates automatically");
            hint: @tr("When the app starts, at most once a day.");
            on: UpdateState.auto-check;
            toggled(v) => { UpdateState.set-auto-check(v); }
        }
        PrefSwitch {
            label: @tr("Download and install updates automatically");
            hint: @tr("Updates download, are verified and install in the background without administrator rights; you pick when to restart. An update that changes the Shell core for all users is only announced, because it needs administrator approval.");
            on: UpdateState.auto-install;
            toggled(v) => { UpdateState.set-auto-install(v); }
        }
        RowDivider { }
        HorizontalLayout {
            spacing: Tokens.s3;
            VerticalLayout {
                alignment: start;
                padding-top: 1px;
                Image {
                    property <string> kind: UpdateState.state == "error" ? "error" : UpdateState.state == "up-to-date" ? "ok" : "info";
                    source: UpdateState.offered ? Icons.download : Icons.status(self.kind);
                    width: 16px;
                    height: 16px;
                    colorize: UpdateState.offered ? Tokens.accent : Tokens.status-color(self.kind);
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: UpdateState.state == "checking" ? @tr("Checking for updates…")
                        : UpdateState.state == "available" ? @tr("Version {} is available", UpdateState.latest-version)
                        : UpdateState.state == "downloading" ? @tr("Downloading {}…  {}", UpdateState.latest-version, UpdateState.progress-text)
                        : UpdateState.state == "ready" ? @tr("Version {} is downloaded and verified", UpdateState.latest-version)
                        : UpdateState.state == "installing" ? @tr("Installing {}…", UpdateState.latest-version)
                        : UpdateState.message != "" ? UpdateState.message
                        : @tr("Not checked yet");
                    font-size: Tokens.body;
                    color: UpdateState.state == "error" ? Tokens.danger : Tokens.text;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                if UpdateState.offered && UpdateState.message != "": Text {
                    text: UpdateState.message;
                    font-size: Tokens.caption;
                    color: UpdateState.message-kind == "error" ? Tokens.danger : Tokens.text-2;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                Text {
                    text: @tr("Last checked: {}", UpdateState.last-checked);
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Tokens.s2;
                    if UpdateState.state == "available" || UpdateState.state == "ready": AppButton {
                        text: UpdateState.needs-admin ? @tr("Install with administrator approval")
                            : UpdateState.state == "ready" ? (UpdateState.update-path == "app" ? @tr("Restart now") : @tr("Restart to update"))
                            : @tr("Download and install");
                        primary: true;
                        icon: UpdateState.needs-admin ? AppState.shield-icon : Icons.download;
                        colorize-icon: !UpdateState.needs-admin;
                        clicked => { UpdateState.install(); }
                    }
                    if UpdateState.state == "downloading": AppButton {
                        text: @tr("Cancel");
                        clicked => { UpdateState.cancel(); }
                    }
                    AppButton {
                        text: @tr("Check now");
                        icon: Icons.refresh;
                        colorize-icon: true;
                        enabled: UpdateState.state != "checking" && UpdateState.state != "downloading" && UpdateState.state != "installing";
                        clicked => { UpdateState.check-now(); }
                    }
                }
            }
        }
        if UpdateState.state == "downloading": ProgressBar {
            value: UpdateState.progress;
        }
    }

    Card {
        icon: Icons.info;
        heading: @tr("About");
        HorizontalLayout {
            spacing: Tokens.s4;
            Image {
                source: Icons.logo;
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Nilesoft Shell Pro";
                    font-size: Tokens.body-large;
                    font-weight: 600;
                    color: Tokens.text;
                }
                Text {
                    text: @tr("Version {}", AppState.app-version) + (AppState.status.version != "" && AppState.status.version != AppState.app-version ? "  ·  shell.exe " + AppState.status.version : "");
                    color: Tokens.text-2;
                }
                Text {
                    text: @tr("© Nilesoft Ltd. and contributors. MIT License.");
                    font-size: Tokens.caption;
                    color: Tokens.text-3;
                }
            }
        }
        HorizontalLayout {
            spacing: Tokens.s5;
            alignment: start;
            Link {
                text: "nilesoft.org";
                activated => { AppState.open-url("https://nilesoft.org"); }
            }
            Link {
                text: @tr("Documentation");
                activated => { AppState.open-url("https://nilesoft.org/docs"); }
            }
            // This build is the Nilesoft Shell Pro fork: its own source and issue tracker.
            Link {
                text: @tr("Source code");
                activated => { AppState.open-url("https://github.com/Abdullah-Masood-05/Shell"); }
            }
            Link {
                text: @tr("Report an issue");
                activated => { AppState.open-url("https://github.com/Abdullah-Masood-05/Shell/issues"); }
            }
        }
        Rectangle {
            height: 1px;
            background: Tokens.stroke;
        }
        Text {
            text: @tr("Third-party software");
            font-weight: 600;
            color: Tokens.text;
        }
        Text {
            text: @tr("Built with Slint (Royalty-free license 2.0). JSON for Modern C++ by Niels Lohmann (MIT). Fluent UI System Icons by Microsoft (MIT).");
            font-size: Tokens.caption + 1px;
            color: Tokens.text-2;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
        HorizontalLayout {
            alignment: start;
            AboutSlint {
                width: 280px;
            }
        }
    }
}
