// Design tokens (docs/settings-app/DESIGN.md, "Look"). `dark` is set from C++ (the app
// theme preference and AppsUseLightTheme).
//
// Dark is a blue-tinted palette built on #101823, the content background; light is its
// counterpart with a soft blue tint. The accent is the app's own blue, not the Windows
// accent (the menu preview still uses the Windows accent, as Shell does).
// Text contrast (WCAG): text >= 12:1, text-2 >= 5.9:1, text-3 >= 4.7:1 on every surface;
// white on accent-fill >= 4.5:1.

export global Tokens {
    in-out property <bool> dark: true;

    // Surfaces, back to front
    out property <color> sidebar: dark ? #0C121B : #EAEFF7;
    out property <color> bg: dark ? #101823 : #F3F6FB;          // the window and the content area
    out property <color> content: bg;
    out property <color> layer: dark ? #152031 : #FFFFFF;       // cards
    out property <color> layer-2: dark ? #1A2638 : #F5F8FC;     // fields, tiles and wells inside cards
    out property <color> layer-3: dark ? #1F2D42 : #EBF0F7;     // hovered tiles
    out property <color> stroke: dark ? #FFFFFF14 : #0F172A14;
    out property <color> stroke-strong: dark ? #FFFFFF26 : #0F172A29;
    out property <color> scrim: dark ? #050A12A6 : #0F172A59;
    out property <color> shadow: dark ? #00000066 : #0F172A26;

    // Text
    out property <color> text: dark ? #E5E7EB : #0F172A;
    out property <color> text-2: dark ? #94A3B8 : #475569;
    out property <color> text-3: dark ? #8391A6 : #5B6B82;

    // Accent: lines, icons and links use `accent`; filled controls `accent-fill` with `on-accent` text.
    out property <color> accent: dark ? #4F8CFF : #2563EB;
    out property <color> accent-fill: dark ? #2F6FEB : #2563EB;
    out property <color> accent-fill-hover: dark ? #3573EC : #1D4ED8;
    out property <color> accent-fill-pressed: dark ? #2A63D6 : #1E40AF;
    out property <color> on-accent: #FFFFFF;
    out property <color> accent-soft: accent.with-alpha(dark ? 0.16 : 0.10);   // selected nav item, chips
    out property <color> accent-border: accent.with-alpha(dark ? 0.55 : 0.45);

    // Interaction overlays
    out property <color> hover: dark ? #FFFFFF0B : #0F172A0A;
    out property <color> pressed: dark ? #FFFFFF07 : #0F172A06;
    out property <color> selected: dark ? #FFFFFF12 : #0F172A0F;
    out property <color> focus-ring: dark ? #E5E7EB : #0F172AE4;

    // Status
    out property <color> success: dark ? #6CCB5F : #0F7B0F;
    out property <color> warning: dark ? #FCE100 : #9D5D00;
    out property <color> danger: dark ? #FF99A4 : #C42B1C;
    out property <color> success-bg: dark ? #393D1B : #DFF6DD;
    out property <color> warning-bg: dark ? #433519 : #FFF4CE;
    out property <color> danger-bg: dark ? #442726 : #FDE7E9;
    out property <color> info-bg: dark ? #1A2C4A : #E5EEFD;

    // 4 px grid
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 20px;
    out property <length> s6: 24px;
    out property <length> s8: 32px;
    out property <length> s10: 40px;

    // Corner radius: barely rounded boxes. xs for chips, tags and inner
    // segments; sm for buttons, inputs, nav and list rows; md for tiles and
    // panels; lg for cards and dialogs. Round shapes (toggles, dots, slider
    // thumbs, radios, avatars) use self.height / 2 instead.
    out property <length> radius-xs: 2px;
    out property <length> radius-sm: 2px;
    out property <length> radius-md: 3px;
    out property <length> radius-lg: 3px;

    // Type ramp (Segoe UI Variable)
    out property <length> caption: 12px;
    out property <length> body: 14px;
    out property <length> heading: 16px;      // card titles
    out property <length> body-large: 18px;
    out property <length> subtitle: 20px;
    out property <length> title: 28px;
    out property <string> mono: "Cascadia Mono";

    out property <duration> fast: 120ms;
    out property <duration> normal: 200ms;

    public pure function status-color(kind: string) -> color {
        if (kind == "ok") { return success; }
        if (kind == "warning") { return warning; }
        if (kind == "error") { return danger; }
        if (kind == "info") { return accent; }
        return text-3;
    }
    public pure function status-bg(kind: string) -> color {
        if (kind == "ok") { return success-bg; }
        if (kind == "warning") { return warning-bg; }
        if (kind == "error") { return danger-bg; }
        if (kind == "info") { return info-bg; }
        return layer-2;
    }
}
