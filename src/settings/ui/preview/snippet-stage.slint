// The Snippets page's preview stage: what one snippet adds to the menu, the way
// RubicBG screenshots his snippets. The real menu at 1:1 on the wallpaper (a light scrim
// over it), the snippet's part hovered and its submenu open, Windows' own rows faded.
// The menus are drawn by MenuSurface (menu-preview.slint), like the Appearance preview.

import { PreviewTheme, PreviewItem, PreviewMenu } from "preview-types.slint";
import { MenuSurface } from "menu-preview.slint";
import { Tokens } from "../theme/tokens.slint";

// The wallpaper and the scrim, or a plain layer when there's no wallpaper.
component Backdrop inherits Rectangle {
    in property <image> wallpaper;
    in property <bool> dark;
    background: Tokens.layer-2;
    if root.wallpaper.width > 0: Image {
        width: 100%;
        height: 100%;
        source: root.wallpaper;
        image-fit: cover;
    }
    Rectangle {
        background: root.dark ? Tokens.stage-scrim-dark : Tokens.stage-scrim-light;
    }
}

// "Right-click a .zip file": where the menu shows, at the stage's top-left.
component ContextChip inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> dark;
    in property <string> icon-font;
    property <color> ink: root.dark ? Tokens.stage-ink-dark : Tokens.stage-ink-light;
    out property <length> natural-width: row.preferred-width;
    height: 24px;
    border-radius: self.height / 2;
    background: root.dark ? Tokens.stage-chip-dark : Tokens.stage-chip-light;
    border-width: 1px;
    border-color: root.dark ? Tokens.stage-chip-stroke-dark : Tokens.stage-chip-stroke-light;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: root.icon-font;
            font-size: 12px;
            color: root.ink;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Tokens.caption;
            color: root.ink;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A menu-shaped placeholder while the preview is made: two rows, a separator, two rows.
component Skeleton inherits Rectangle {
    in property <bool> dark;
    in property <bool> pulse: true;
    property <color> bone: root.dark ? Tokens.stage-bone-dark : Tokens.stage-bone-light;
    property <[length]> bars: [92px, 120px, 104px, 72px];
    width: 200px;
    height: 4px + 4 * 28px + 9px + 4px;
    border-radius: 8px;
    background: root.dark ? Tokens.stage-skeleton-dark : Tokens.stage-skeleton-light;
    border-width: 1px;
    border-color: root.dark ? #FFFFFF14 : #0F172A14;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000040;
    // 0.45 to 0.9 and back over 1.1 s.
    property <float> glow: root.pulse ? 0.675 - 0.225 * cos(animation-tick() / 1.1s * 360deg) : 0.6;
    for w[i] in root.bars: Rectangle {
        x: 0;
        y: 4px + i * 28px + (i >= 2 ? 9px : 0px);
        height: 28px;
        opacity: root.glow;
        Rectangle {
            x: 12px;
            y: 6px;
            width: 16px;
            height: 16px;
            border-radius: 3px;
            background: root.bone;
        }
        Rectangle {
            x: 40px;
            y: 9px;
            width: w;
            height: 10px;
            border-radius: 5px;
            background: root.bone;
        }
    }
    Rectangle {
        x: 4px;
        y: 4px + 2 * 28px + 4px;
        width: parent.width - 8px;
        height: 1px;
        background: root.bone;
        opacity: root.glow;
    }
}

export component SnippetStage inherits Rectangle {
    in property <PreviewTheme> t;
    in property <PreviewMenu> menu;
    in property <[PreviewMenu]> subs;
    in property <image> wallpaper;
    in property <image> blurred;
    in property <string> icon-font;
    in property <bool> dark;            // the preview's Light/Dark
    in property <string> caption;       // "Right-click a .zip file"
    in property <string> caption-glyph;
    // menu | loading | error. Loading: a skeleton after 150 ms. Error: a faded menu of
    // Windows' own items (the reason is said under the stage).
    in property <string> mode: "menu";

    property <length> edge: 12px;
    property <length> menu-edge: 8px;   // the menus may come a little closer to the sides
    property <length> top-room: 48px;   // the chip
    property <length> bottom-room: 28px;
    property <length> gap: Tokens.stage-gap;
    property <bool> showing-menu: root.mode == "menu";

    // Hover: the snippet's first menu is open at first.
    property <int> hovered: root.menu.open;
    changed menu => { root.hovered = root.menu.open; }
    property <int> open-sub: root.hovered >= 0 && root.hovered < root.menu.items.length ? root.menu.items[root.hovered].sub : -1;
    property <bool> has-sub: root.showing-menu && root.open-sub >= 0 && root.open-sub < root.subs.length;
    // The submenu shown at first decides the layout, so the menu doesn't move when
    // another row is hovered.
    property <int> first-sub: root.menu.open >= 0 && root.menu.open < root.menu.items.length ? root.menu.items[root.menu.open].sub : -1;
    property <bool> has-first-sub: root.showing-menu && root.first-sub >= 0 && root.first-sub < root.subs.length;

    // Each menu at most stage-menu-max wide; when the pair still doesn't fit, both give
    // up width: the main menu its spare room first, then the labels elide.
    property <length> avail: root.width - 2 * root.menu-edge;
    property <length> main-want: min(Tokens.stage-menu-max, main.natural-width);
    property <length> sub-want: min(Tokens.stage-menu-max, probe.natural-width);
    property <length> share: root.avail - root.gap;
    // Short of room, the main menu gives up its spare width first (down to its tight
    // width), then the submenu's labels elide.
    property <length> main-tight: min(root.main-want, main.tight-width);
    property <length> main-cap: !root.has-first-sub ? min(root.main-want, root.avail)
        : root.main-want + root.gap + root.sub-want <= root.share + root.gap ? root.main-want
        : max(min(root.main-tight, root.share - 120px), min(root.main-want, root.share - root.sub-want));
    property <length> sub-cap: !root.has-first-sub ? Tokens.stage-menu-max
        : max(120px, min(root.sub-want, root.share - root.main-cap));
    property <length> pair-width: main.width + (root.has-first-sub ? root.gap + probe.width : 0px);

    // Where the first submenu's top goes, relative to the main menu's.
    property <length> first-sub-dy: root.has-first-sub ? root.menu.items[root.menu.open].y - root.t.pad-top - root.t.border-size : 0px;
    property <length> content-height: !root.showing-menu ? 0px
        : max(root.menu.height, root.has-first-sub ? root.first-sub-dy + probe.height : 0px);
    out property <length> wanted-height: root.showing-menu
        ? clamp(root.top-room + root.content-height + root.bottom-room, Tokens.stage-min, Tokens.stage-max)
        : Tokens.stage-min;
    property <bool> overflow-y: root.showing-menu && root.top-room + root.content-height + root.bottom-room > Tokens.stage-max;
    property <bool> overflow-x: root.showing-menu && root.pair-width > root.avail;

    height: root.wanted-height;
    clip: true;
    border-radius: Tokens.radius-md;

    Backdrop {
        wallpaper: root.wallpaper;
        dark: root.dark;
    }

    // The menus, centred under the chip.
    property <length> menus-x: max(root.menu-edge, (root.width - root.pair-width) / 2);
    property <length> menus-y: root.top-room + max(0px, (root.height - root.top-room - root.bottom-room - root.content-height) / 2);

    // Measures the first submenu (never shown).
    probe := MenuSurface {
        visible: false;
        snippet: true;
        t: root.t;
        menu: root.has-first-sub ? root.subs[root.first-sub] : { items: [], height: 0px, open: -1 };
        icon-font: root.icon-font;
        cap-width: root.sub-cap;
    }

    main := MenuSurface {
        visible: root.showing-menu;
        x: root.menus-x;
        y: root.menus-y;
        snippet: true;
        outline: true;
        cap-width: root.main-cap;
        t: root.t;
        menu: root.menu;
        icon-font: root.icon-font;
        blurred: root.blurred;
        backdrop-x: self.x;
        backdrop-y: self.y;
        backdrop-width: root.width;
        backdrop-height: root.height;
        hovered <=> root.hovered;
    }

    // To the right of its row, a small gap from the menu, its first row level with it.
    if root.has-sub: MenuSurface {
        x: root.menus-x + main.width + root.gap;
        y: root.menus-y + root.menu.items[root.hovered].y - root.t.pad-top - root.t.border-size;
        snippet: true;
        cap-width: root.sub-cap;
        t: root.t;
        menu: root.subs[root.open-sub];
        icon-font: root.icon-font;
        blurred: root.blurred;
        backdrop-x: self.x;
        backdrop-y: self.y;
        backdrop-width: root.width;
        backdrop-height: root.height;
    }

    // A long menu: cut at the bottom and faded, with how many rows are left out.
    if root.overflow-y: Rectangle {
        y: root.height - 40px;
        height: 40px;
        background: @linear-gradient(180deg, transparent 0%, (root.dark ? Tokens.stage-fade-dark : Tokens.stage-fade-light) 100%);
    }
    if root.overflow-y && root.menu.hidden-count > 0: Rectangle {
        property <color> ink: root.dark ? Tokens.stage-ink-dark : Tokens.stage-ink-light;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 8px;
        height: 22px;
        width: more.preferred-width + 20px;
        border-radius: self.height / 2;
        background: root.dark ? Tokens.stage-chip-dark : Tokens.stage-chip-light;
        border-width: 1px;
        border-color: root.dark ? Tokens.stage-chip-stroke-dark : Tokens.stage-chip-stroke-light;
        more := Text {
            text: @tr("+{} more", root.menu.hidden-count);
            font-size: Tokens.caption;
            color: parent.ink;
        }
    }
    // Too wide even with the labels cut: cut at the right edge, faded.
    if root.overflow-x: Rectangle {
        x: root.width - 24px;
        width: 24px;
        background: @linear-gradient(90deg, transparent 0%, (root.dark ? Tokens.stage-fade-dark : Tokens.stage-fade-light) 100%);
    }

    // Loading: the skeleton, after 150 ms (most previews are quicker).
    property <bool> skeleton-due;
    changed mode => { root.skeleton-due = false; }
    Timer {
        interval: 150ms;
        running: root.mode == "loading" && !root.skeleton-due;
        triggered => { root.skeleton-due = true; }
    }
    if root.mode == "loading" && root.skeleton-due: Skeleton {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        dark: root.dark;
    }

    // Error: a few of Windows' own items, faded; the reason is said under the stage.
    property <length> row-h: max(root.t.font-size, root.t.show-images ? root.t.image-size : 0px) + 12px;
    property <length> pad: root.t.pad-top + root.t.border-size;
    if root.mode == "error": MenuSurface {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        snippet: true;
        t: root.t;
        icon-font: root.icon-font;
        blurred: root.blurred;
        backdrop-x: self.x;
        backdrop-y: self.y;
        backdrop-width: root.width;
        backdrop-height: root.height;
        menu: {
            items: [
                { label: @tr("Open"), glyph: "\u{E8E5}", sub: -1, y: root.pad, h: root.row-h },
                { label: @tr("Copy"), glyph: "\u{E8C8}", sub: -1, y: root.pad + root.row-h, h: root.row-h },
                { label: @tr("Properties"), glyph: "\u{E946}", sub: -1, y: root.pad + 2 * root.row-h, h: root.row-h },
            ],
            height: 2 * root.pad + 3 * root.row-h,
            open: -1,
        };
    }

    if root.caption != "": ContextChip {
        x: root.edge;
        y: root.edge;
        width: min(self.natural-width, root.width - 2 * root.edge);
        text: root.caption;
        glyph: root.caption-glyph;
        dark: root.dark;
        icon-font: root.icon-font;
    }
}
