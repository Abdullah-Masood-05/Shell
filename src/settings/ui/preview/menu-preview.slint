// A mock of a Nilesoft Shell menu, drawn from a PreviewTheme. Approximate by
// design: the real menu is drawn by shell.dll with GDI and DWM effects.

import { PreviewTheme, PreviewItem, PreviewMenu } from "preview-types.slint";
import { Tokens } from "../theme/tokens.slint";

// The glyph font of `image=\uXXXX` (src/shared/Resource/Shell.ttf), for the Snippets preview.
import "../../res/nilesoft-shell.ttf";

// One menu: background (with blur/acrylic over what is behind it), rows,
// separators, chevrons, and a border on top.
export component MenuSurface inherits Rectangle {
    in property <PreviewTheme> t;
    in property <PreviewMenu> menu;
    in property <string> icon-font;
    // What is behind the menu: the blurred wallpaper laid out like the backdrop
    // (menu position inside it), or a flat colour (an Explorer window).
    in property <image> blurred;
    in property <length> backdrop-x;
    in property <length> backdrop-y;
    in property <length> backdrop-width;
    in property <length> backdrop-height;
    in property <bool> flat-backdrop;
    in property <color> flat-color;
    in-out property <int> hovered: -1;
    // Drawn smaller than the theme says (a narrow preview pane): every length times this.
    in property <float> zoom: 1;
    // The Snippets preview (snippet-stage.slint): rows that aren't the snippet's are
    // Windows' own, faded and not hoverable; the snippet's rows in this menu get an outline
    // (`outline`, the main menu only). The menu is at most `cap-width` wide; labels elide.
    in property <bool> snippet;
    in property <bool> outline;
    in property <length> cap-width: 100000px;

    // The menu's default font, Segoe UI; each language can name another one in its .po file,
    // because Slint's fallback for Chinese text in Segoe UI misses characters.
    property <string> default-family: @tr("Menu font family" => "Segoe UI");
    property <string> family: t.font-family != "" ? t.font-family : root.default-family;
    property <length> label-x: (t.item-pad-left * root.zoom) + (t.show-images ? (t.image-size * root.zoom) + (t.image-gap * root.zoom) : 0px);

    // The width at zoom 1, for placing the menus in the pane.
    out property <length> natural-width: max(t.min-width, t.pad-left + t.pad-right + t.item-mar-left + t.item-mar-right + t.item-pad-left + (t.show-images ? t.image-size + t.image-gap : 0px) + measure.preferred-width + t.font-size * 3 + t.item-pad-right);

    // Without the theme's minimum width and the spare room after the labels: as narrow as
    // the menu gets before a label is cut (the Snippets preview, when space is short).
    out property <length> tight-width: t.pad-left + t.pad-right + t.item-mar-left + t.item-mar-right + t.item-pad-left + (t.show-images ? t.image-size + t.image-gap : 0px) + measure.preferred-width + t.font-size * 0.72 + 20px + t.item-pad-right;
    // Where the open row's label ends: a submenu short of room may cover this menu up to
    // there, never the label itself.
    // (keys= text included).
    out property <length> open-label-end: t.pad-left + t.item-mar-left + root.label-x + open-label.preferred-width
        + (open-keys.text != "" ? root.keys-gap + open-keys.preferred-width : 0px) + 12px;
    // keys= text: a little smaller than the label, like Windows' shortcut column.
    property <length> keys-size: t.font-size * 0.92;
    property <length> keys-gap: 24px;

    width: min(root.natural-width, root.cap-width) * root.zoom;
    height: (root.menu.height * root.zoom);
    border-radius: (t.radius * root.zoom);
    drop-shadow-blur: t.shadow ? (t.shadow-size * root.zoom) * 3 : 0px;
    drop-shadow-offset-y: t.shadow ? (t.shadow-offset * root.zoom) : 0px;
    drop-shadow-color: t.shadow ? t.shadow-color : transparent;
    accessible-role: list;

    // Measures the widest label (never shown).
    Rectangle {
        width: 0px;
        height: 0px;
        clip: true;
        opacity: 0;
        open-label := Text {
            text: root.menu.open >= 0 && root.menu.open < root.menu.items.length ? root.menu.items[root.menu.open].label : "";
            font-size: t.font-size;
            font-family: root.family;
            font-weight: t.font-weight;
            font-italic: t.italic;
        }
        open-keys := Text {
            text: root.menu.open >= 0 && root.menu.open < root.menu.items.length ? root.menu.items[root.menu.open].keys : "";
            font-size: root.keys-size;
            font-family: root.family;
        }
        measure := VerticalLayout {
            for it in root.menu.items: HorizontalLayout {
                Text {
                    text: it.label;
                    font-size: t.font-size;
                    font-family: root.family;
                    font-weight: t.font-weight;
                    font-italic: t.italic;
                }
                if it.keys != "": Rectangle {
                    width: root.keys-gap;
                }
                if it.keys != "": Text {
                    text: it.keys;
                    font-size: root.keys-size;
                    font-family: root.family;
                }
            }
        }
    }

    Rectangle {
        border-radius: (t.radius * root.zoom);
        clip: true;

        if t.effect >= 2 && !root.flat-backdrop: Image {
            x: -root.backdrop-x;
            y: -root.backdrop-y;
            width: root.backdrop-width;
            height: root.backdrop-height;
            source: root.blurred;
            image-fit: cover;
        }
        if t.effect >= 2 && root.flat-backdrop: Rectangle {
            background: root.flat-color;
        }
        // Acrylic (ACCENT_ENABLE_ACRYLICBLURBEHIND): a faint layer of the tint's own
        // colour under the tint itself; see theme::acrylicLayer. No fixed grey: the
        // real menu is as see-through as its tint.
        if t.effect >= 3: Rectangle {
            background: t.acrylic;
        }
        if t.effect >= 2: Rectangle {
            background: t.tint;
        }
        Rectangle {
            background: t.background;
        }
        // theme.background.gradient, sampled at three points (src/ThemeModel.cpp).
        if t.gradient: Rectangle {
            background: t.gradient-radial
                ? @radial-gradient(circle, t.gradient-0 0%, t.gradient-1 50%, t.gradient-2 100%)
                : @linear-gradient(t.gradient-angle, t.gradient-0 0%, t.gradient-1 50%, t.gradient-2 100%);
        }

        for it[i] in root.menu.items: Rectangle {
            x: (t.pad-left * root.zoom);
            y: (it.y * root.zoom);
            width: parent.width - (t.pad-left * root.zoom) - (t.pad-right * root.zoom);
            height: (it.h * root.zoom);
            // Windows' own rows around the snippet's (the Snippets preview).
            property <bool> ghost: root.snippet && (it.ghost || !it.own);
            property <bool> selected: i == root.hovered && !it.separator && !self.ghost;
            // The snippet's rows in the main menu: one outline around each run of them.
            // A run starts or ends at a row the data marks (group-first/-last), or where the
            // row before or after isn't the snippet's. A separator belongs to a run only
            // between two of its rows, so a run never ends in a separator's line and a
            // separator between two runs keeps them apart (one outline each).
            property <PreviewItem> prev: i > 0 ? root.menu.items[i - 1] : { own: false };
            property <PreviewItem> next: i + 1 < root.menu.items.length ? root.menu.items[i + 1] : { own: false };
            property <PreviewItem> prev2: i > 1 ? root.menu.items[i - 2] : { own: false };
            property <PreviewItem> next2: i + 2 < root.menu.items.length ? root.menu.items[i + 2] : { own: false };
            property <bool> prev-own: self.prev.own && !self.prev.ghost;
            property <bool> next-own: self.next.own && !self.next.ghost;
            // A separator inside a run: the snippet's rows on both sides, no run ending before it.
            property <bool> inner-sep: it.separator && self.prev-own && self.next-own && !self.prev.separator && !self.next.separator
                && !self.prev.group-last && !self.next.group-first;
            property <bool> grouped: root.outline && !self.ghost && (!it.separator || self.inner-sep);
            // The row before is in this run: one of the snippet's, or an inner separator with one before it.
            property <bool> joins-prev: self.prev-own && !it.group-first && !self.prev.group-last
                && (!self.prev.separator || (self.prev2.own && !self.prev2.ghost && !self.prev2.group-last));
            property <bool> joins-next: self.next-own && !it.group-last && !self.next.group-first
                && (!self.next.separator || (self.next2.own && !self.next2.ghost && !self.next2.group-first));
            property <bool> group-top: !it.separator && !self.joins-prev;
            property <bool> group-bottom: !it.separator && !self.joins-next;

            if it.separator: Rectangle {
                x: (t.sep-mar-left * root.zoom);
                y: (t.sep-mar-top * root.zoom);
                width: parent.width - (t.sep-mar-left * root.zoom) - (t.sep-mar-right * root.zoom);
                height: (t.sep-size * root.zoom);
                background: t.sep-color;
                opacity: ghost ? 0.5 : 1;
            }
            // The outline around the snippet's rows: each row draws its slice of one
            // rounded rectangle (the parts beyond the run's ends are clipped away), 2 px in
            // from the menu's edges.
            if grouped: Rectangle {
                x: -(t.pad-left * root.zoom) + 2px;
                width: parent.width + (t.pad-left * root.zoom) + (t.pad-right * root.zoom) - 4px;
                clip: true;
                Rectangle {
                    property <length> over: 24px;
                    y: group-top ? 0 : -self.over;
                    height: parent.height + (group-top ? 0 : self.over) + (group-bottom ? 0 : self.over);
                    border-width: 1px;
                    border-color: Tokens.accent.with-alpha(0.7);
                    border-radius: (t.item-radius * root.zoom) + 2px;
                }
            }
            if !it.separator: Rectangle {
                x: (t.item-mar-left * root.zoom);
                y: (t.item-mar-top * root.zoom);
                width: parent.width - (t.item-mar-left * root.zoom) - (t.item-mar-right * root.zoom);
                height: parent.height - (t.item-mar-top * root.zoom) - (t.item-mar-bottom * root.zoom);
                border-radius: (t.item-radius * root.zoom);
                background: !selected ? transparent : it.disabled ? t.back-dis-sel : t.back-sel;
                accessible-role: list-item;
                accessible-label: it.label;
                // Windows' own rows (Snippets preview): drawn as they are, but faded.
                opacity: ghost ? 0.38 : 1;
                // A row of Windows' own is never "disabled" here: faded is enough.
                property <bool> dis: it.disabled && !ghost;
                property <color> ink: dis || it.placeholder ? t.text-dis : selected ? t.text-sel : t.text;
                property <length> chevron-room: it.sub >= 0 ? (t.font-size * root.zoom) * 0.72 + 12px : 0px;
                property <length> keys-room: it.keys != "" ? keys.preferred-width + root.keys-gap * root.zoom : 0px;

                // Icons on whole pixels, so they stay sharp.
                if t.show-images && it.has-icon: Image {
                    x: round((t.item-pad-left * root.zoom) / 1px) * 1px;
                    y: round((parent.height - self.height) / 2 / 1px) * 1px;
                    width: (t.image-size * root.zoom);
                    height: (t.image-size * root.zoom);
                    source: it.icon;
                    image-fit: contain;
                    opacity: dis ? 0.45 : 1;
                }
                if t.show-images && !it.has-icon && it.glyph != "": Text {
                    x: round((t.item-pad-left * root.zoom) / 1px) * 1px;
                    width: (t.image-size * root.zoom);
                    height: parent.height;
                    text: it.glyph;
                    font-family: it.glyph-font != "" ? it.glyph-font : root.icon-font;
                    font-size: (t.image-size * root.zoom) * 0.94;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: dis ? t.text-dis : it.glyph-color != transparent ? it.glyph-color : selected ? t.icon-sel : t.icon;
                }
                label := Text {
                    x: root.label-x;
                    width: parent.width - self.x - (t.item-pad-right * root.zoom) - max((t.font-size * root.zoom) * 1.5, chevron-room + keys-room);
                    height: parent.height;
                    text: it.label;
                    font-family: root.family;
                    font-size: (t.font-size * root.zoom);
                    font-weight: t.font-weight;
                    font-italic: t.italic || it.placeholder;
                    vertical-alignment: center;
                    overflow: elide;
                    color: ink;
                }
                // The accelerator's underline (&x in the title) under that letter: the
                // label's text before it says where. Not when the label is cut short.
                if it.accel-char != "" && label.preferred-width <= label.width + 0.5px: Rectangle {
                    x: label.x + accel-before.preferred-width;
                    y: round((parent.height / 2 + (t.font-size * root.zoom) * 0.414) / 1px) * 1px + 1px;
                    width: accel-char.preferred-width;
                    height: 1px;
                    background: ink;
                }
                Rectangle {
                    width: 0;
                    height: 0;
                    clip: true;
                    accel-before := Text {
                        text: it.accel-before;
                        font-family: root.family;
                        font-size: (t.font-size * root.zoom);
                        font-weight: t.font-weight;
                        font-italic: t.italic || it.placeholder;
                    }
                    accel-char := Text {
                        text: it.accel-char;
                        font-family: root.family;
                        font-size: (t.font-size * root.zoom);
                        font-weight: t.font-weight;
                        font-italic: t.italic || it.placeholder;
                    }
                }
                // keys= on the right, before the chevron, dimmed like Windows' shortcuts.
                keys := Text {
                    visible: it.keys != "";
                    x: parent.width - (t.item-pad-right * root.zoom) - chevron-room - self.width;
                    width: self.preferred-width;
                    height: parent.height;
                    text: it.keys;
                    font-family: root.family;
                    font-size: root.keys-size * root.zoom;
                    vertical-alignment: center;
                    color: ink.with-alpha(0.55);
                }
                if it.sub >= 0: Text {
                    x: parent.width - (t.item-pad-right * root.zoom) - self.width;
                    height: parent.height;
                    text: "\u{E76C}";
                    font-family: root.icon-font;
                    font-size: (t.font-size * root.zoom) * 0.72;
                    vertical-alignment: center;
                    color: dis ? t.text-dis : selected ? t.chevron-sel : t.chevron;
                }
            }
            TouchArea {
                changed has-hover => {
                    if (self.has-hover && !it.separator && !ghost) {
                        root.hovered = i;
                    }
                }
            }
        }
    }

    // The border is drawn over the rows, like the core does.
    Rectangle {
        border-radius: (t.radius * root.zoom);
        border-width: (t.border-size * root.zoom);
        border-color: t.border-color;
    }
}

// The small three-row menu on a theme card.
export component MiniMenu inherits Rectangle {
    in property <PreviewTheme> t;
    in property <string> icon-font;
    in property <image> blurred;

    property <string> family: t.font-family != "" ? t.font-family : @tr("Menu font family" => "Segoe UI");
    property <[string]> labels: [@tr("Explorer menu" => "View"), @tr("Sort by"), @tr("Refresh")];
    property <[string]> glyphs: ["\u{E8A9}", "\u{E8CB}", "\u{E72C}"];

    width: 104px;
    height: 3 * 20px + 8px;
    border-radius: min(t.radius, 8px);
    drop-shadow-blur: t.shadow ? 6px : 0px;
    drop-shadow-offset-y: t.shadow ? 1px : 0px;
    drop-shadow-color: t.shadow ? t.shadow-color : transparent;

    Rectangle {
        border-radius: parent.border-radius;
        clip: true;
        if t.effect >= 2: Image {
            width: 100%;
            height: 100%;
            source: root.blurred;
            image-fit: cover;
        }
        // Acrylic (ACCENT_ENABLE_ACRYLICBLURBEHIND): a faint layer of the tint's own
        // colour under the tint itself; see theme::acrylicLayer. No fixed grey: the
        // real menu is as see-through as its tint.
        if t.effect >= 3: Rectangle {
            background: t.acrylic;
        }
        if t.effect >= 2: Rectangle {
            background: t.tint;
        }
        Rectangle {
            background: t.background;
        }
        if t.gradient: Rectangle {
            background: t.gradient-radial
                ? @radial-gradient(circle, t.gradient-0 0%, t.gradient-1 50%, t.gradient-2 100%)
                : @linear-gradient(t.gradient-angle, t.gradient-0 0%, t.gradient-1 50%, t.gradient-2 100%);
        }
        for label[i] in root.labels: Rectangle {
            x: 4px;
            y: 4px + i * 20px;
            width: parent.width - 8px;
            height: 20px;
            border-radius: min(t.item-radius, 4px);
            background: i == 1 ? t.back-sel : transparent;
            Text {
                x: 6px;
                width: 12px;
                text: root.glyphs[i];
                font-family: root.icon-font;
                font-size: 10px;
                horizontal-alignment: center;
                color: i == 1 ? t.icon-sel : t.icon;
            }
            Text {
                x: 24px;
                text: label;
                font-family: root.family;
                font-size: 10px;
                color: i == 1 ? t.text-sel : t.text;
            }
            if i < 2: Text {
                x: parent.width - 12px;
                text: "\u{E76C}";
                font-family: root.icon-font;
                font-size: 7px;
                color: i == 1 ? t.chevron-sel : t.chevron;
            }
        }
    }
    Rectangle {
        border-radius: parent.border-radius;
        border-width: t.border-size > 0px ? 1px : 0px;
        border-color: t.border-color;
    }
}

// A mock File Explorer window, behind the menu in the Explorer context.
component ExplorerWindow inherits Rectangle {
    in property <bool> dark;
    property <color> chrome: dark ? #202020 : #EEF4F9;
    property <color> body: dark ? #191919 : #FFFFFF;
    property <color> ink: dark ? #FFFFFF : #1A1A1A;
    property <color> ink-2: dark ? #FFFFFF99 : #00000099;
    property <color> line: dark ? #FFFFFF14 : #0000000F;
    property <color> sel: dark ? #FFFFFF1A : #CCE8FF;
    property <[string]> files: [@tr("Documents"), @tr("Pictures"), @tr("Projects"), "report.docx", "budget.xlsx", "notes.txt", "photo.jpg"];

    background: body;
    border-radius: 8px;
    border-width: 1px;
    border-color: line;
    clip: true;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000050;

    Rectangle {
        height: 76px;
        y: 0;
        background: chrome;
        Text {
            x: 14px;
            y: 10px;
            text: @tr("Home");
            font-size: 12px;
            color: ink;
        }
        Rectangle {
            x: 12px;
            y: 40px;
            width: parent.width - 24px;
            height: 26px;
            border-radius: 4px;
            background: body;
            Text {
                x: 10px;
                text: @tr("This PC") + "  ›  " + @tr("Documents");
                font-size: 11px;
                color: ink-2;
            }
        }
    }
    for f[i] in root.files: Rectangle {
        x: 12px;
        y: 88px + i * 28px;
        width: parent.width - 24px;
        height: 26px;
        border-radius: 4px;
        background: i == 3 ? sel : transparent;
        Text {
            x: 10px;
            text: i < 3 ? "\u{E8B7}" : "\u{E8A5}";
            font-family: "Segoe Fluent Icons";
            font-size: 13px;
            color: i < 3 ? #E8B33A : ink-2;
        }
        Text {
            x: 34px;
            text: f;
            font-size: 12px;
            color: ink;
        }
    }
}

// The whole preview: wallpaper (or an Explorer window), the menu and one
// submenu that follows the hovered item.
export component PreviewPane inherits Rectangle {
    in property <PreviewTheme> t;
    in property <int> context;          // 0 desktop, 1 File Explorer
    in property <PreviewMenu> menu;
    in property <[PreviewMenu]> subs;
    in property <image> wallpaper;
    in property <image> blurred;
    in property <string> icon-font;
    in property <bool> dark;            // the simulated Windows mode (Explorer window colours)

    property <int> hovered: menu.open;
    property <int> open-sub: hovered >= 0 && hovered < menu.items.length ? menu.items[hovered].sub : -1;
    property <bool> explorer: root.context == 1;
    changed context => { root.hovered = root.menu.open; }

    clip: true;
    background: #1B2A44;
    border-radius: Tokens.radius-md;

    Image {
        width: 100%;
        height: 100%;
        source: root.wallpaper;
        image-fit: cover;
    }

    if root.explorer: ExplorerWindow {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        dark: root.dark;
    }

    // Where the menus go, like Windows places a submenu: to the right of its item, or
    // flipped to the left of the menu when the right side has no room. When neither
    // side has room (a narrow pane), the pair moves left as far as it must and, if it
    // still doesn't fit, is drawn smaller. The submenu never covers the menu's labels.
    property <bool> has-sub: root.open-sub >= 0 && root.open-sub < root.subs.length;
    property <length> edge: 4px;
    property <length> overlap: 4px;
    property <length> natural-x: root.explorer ? min(64px, max(16px, root.width - main.natural-width * 2 - 8px)) : 16px;
    property <bool> fits-right: root.natural-x + main.natural-width - root.overlap + sub.natural-width <= root.width - root.edge;
    property <bool> fits-left: root.natural-x + root.overlap - sub.natural-width >= root.edge;
    property <bool> flip: root.has-sub && !root.fits-right && root.fits-left;
    property <bool> squeeze: root.has-sub && !root.fits-right && !root.fits-left;
    property <length> pair-width: main.natural-width + sub.natural-width - root.overlap;
    property <float> zoom: root.squeeze ? clamp((root.width - 2 * root.edge) / max(1px, root.pair-width), 0.6, 1) : 1;

    main := MenuSurface {
        x: root.squeeze ? max(root.edge, min(root.natural-x, root.width - root.edge - root.pair-width * root.zoom)) : root.natural-x;
        y: root.explorer ? 100px : 20px;
        zoom: root.zoom;
        t: root.t;
        menu: root.menu;
        icon-font: root.icon-font;
        blurred: root.blurred;
        backdrop-x: self.x;
        backdrop-y: self.y;
        backdrop-width: root.width;
        backdrop-height: root.height;
        flat-backdrop: root.explorer;
        flat-color: root.dark ? #191919 : #FFFFFF;
        hovered <=> root.hovered;
    }

    // Always there (hidden without a submenu), so the placement above can measure it.
    sub := MenuSurface {
        visible: root.has-sub;
        x: root.flip ? main.x + root.overlap - self.width : main.x + main.width - root.overlap * root.zoom;
        y: !root.has-sub ? main.y : min(main.y + (root.menu.items[root.hovered].y - root.t.pad-top) * root.zoom, max(0px, root.height - self.height - 8px));
        zoom: root.zoom;
        t: root.t;
        menu: root.has-sub ? root.subs[root.open-sub] : { items: [], height: 0px, open: -1 };
        icon-font: root.icon-font;
        blurred: root.blurred;
        backdrop-x: self.x;
        backdrop-y: self.y;
        backdrop-width: root.width;
        backdrop-height: root.height;
        flat-backdrop: root.explorer;
        flat-color: root.dark ? #191919 : #FFFFFF;
    }}
