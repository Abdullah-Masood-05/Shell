import { ListView } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppButton } from "controls.slint";
import { CloseGlyph } from "banner.slint";
import { CodeColors } from "code.slint";
import { DiffLine } from "diff-line.slint";
import { BackupsState } from "../backups-types.slint";
import { ConfigUpdateState } from "../config-update-state.slint";

// Home, after an update: the menu files the user changed, which the update left alone.
// Each one can be compared with the new version, or replaced by it (backed up first).
export component KeptFilesNotice inherits Rectangle {
    min-height: content.preferred-height;
    preferred-height: content.preferred-height;
    border-radius: Tokens.radius-lg;
    border-width: 1px;
    border-color: Tokens.stroke;
    background: Tokens.status-bg("info");
    animate background { duration: Tokens.normal; }

    content := HorizontalLayout {
        padding-left: Tokens.s4;
        padding-right: Tokens.s2;
        padding-top: Tokens.s3;
        padding-bottom: Tokens.s3;
        spacing: Tokens.s3;

        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Image {
                source: Icons.status("info");
                width: 18px;
                height: 18px;
                colorize: Tokens.status-color("info");
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.s2;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: ConfigUpdateState.kept-title;
                    font-weight: 600;
                    font-size: Tokens.body;
                    color: Tokens.text;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
                Text {
                    text: ConfigUpdateState.kept-text;
                    font-size: Tokens.body;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                    min-height: self.preferred-height;
                }
            }
            for path in ConfigUpdateState.kept-files: HorizontalLayout {
                spacing: Tokens.s2;
                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    text: path;
                    font-family: BackupsState.mono-font;
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text;
                    overflow: elide;
                }
                AppButton {
                    text: @tr("Compare");
                    enabled: !ConfigUpdateState.working;
                    clicked => { ConfigUpdateState.compare(path); }
                }
                AppButton {
                    text: @tr("Use the new version");
                    enabled: !ConfigUpdateState.working;
                    clicked => { ConfigUpdateState.take(path); }
                }
            }
        }
        VerticalLayout {
            alignment: start;
            CloseGlyph {
                clicked => { ConfigUpdateState.dismiss-kept(); }
            }
        }
    }
}

// Your copy of a menu file next to the new version, as a line diff. Esc closes it.
export component CompareDialog inherits Rectangle {
    background: Tokens.scrim;

    // Swallow clicks outside the card.
    TouchArea { }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                ConfigUpdateState.close-compare();
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        width: min(960px, root.width - 64px);
        height: min(640px, root.height - 64px);
        background: Tokens.layer;
        border-radius: Tokens.radius-lg;
        border-width: 1px;
        border-color: Tokens.stroke-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: Tokens.shadow;
        drop-shadow-offset-y: 8px;

        VerticalLayout {
            padding: Tokens.s6;
            spacing: Tokens.s3;
            Text {
                text: ConfigUpdateState.compare-title;
                font-size: Tokens.subtitle;
                font-weight: 600;
                color: Tokens.text;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            Text {
                text: ConfigUpdateState.compare-summary;
                color: Tokens.text-2;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: Tokens.stroke;
                clip: true;
                if ConfigUpdateState.compare-lines.length == 0: Text {
                    text: ConfigUpdateState.compare-loading ? @tr("Comparing…") : @tr("No differences.");
                    color: Tokens.text-3;
                }
                diff := ListView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-width: max(self.visible-width, 96px + ConfigUpdateState.compare-max-columns * CodeColors.column-width);
                    for r in ConfigUpdateState.compare-lines: DiffLine {
                        width: diff.content-width;
                        entry: r;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.s2;
                AppButton {
                    text: @tr("Close");
                    clicked => { ConfigUpdateState.close-compare(); }
                }
                AppButton {
                    text: @tr("Use the new version");
                    primary: true;
                    enabled: !ConfigUpdateState.working && !ConfigUpdateState.compare-loading;
                    clicked => { ConfigUpdateState.take(ConfigUpdateState.compare-path); }
                }
            }
        }
    }
}
