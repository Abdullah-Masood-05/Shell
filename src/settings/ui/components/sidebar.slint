import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { AppState, NavEntry, Pages } from "../types.slint";
import { NavItem } from "nav-item.slint";
import { UpdateState } from "../update-state.slint";
import { UpdateNavHint } from "update-banner.slint";

// Grouped navigation: logo and version on top, the pages in the middle, the status
// line and Preferences at the bottom. Up/Down/Home/End move between pages when the
// sidebar has keyboard focus (Tab into it).
export component Sidebar inherits Rectangle {
    in property <[NavEntry]> entries: [
        { page: Pages.home, label: @tr("Home"), icon: Icons.home, header: "" },
        { page: Pages.appearance, label: @tr("Appearance"), icon: Icons.appearance, header: @tr("Customize") },
        { page: Pages.behavior, label: @tr("Behavior"), icon: Icons.behavior, header: "" },
        { page: Pages.rules, label: @tr("Rules & Filters"), icon: Icons.rules, header: "" },
        { page: Pages.menus, label: @tr("Context Menus"), icon: Icons.menus, header: @tr("Menus") },
        { page: Pages.menumap, label: @tr("Menu map"), icon: Icons.menu-map, header: "" },
        { page: Pages.builder, label: @tr("Menu Builder"), icon: Icons.builder, header: "" },
        { page: Pages.openwith, label: @tr("Open with"), icon: Icons.open-with, header: "" },
        { page: Pages.snippets, label: @tr("Snippets"), icon: Icons.snippets, header: "" },
        { page: Pages.editor, label: @tr("Config Editor"), icon: Icons.editor, header: @tr("Advanced") },
        { page: Pages.backups, label: @tr("Backups"), icon: Icons.backups, header: "" },
    ];
    // Pages are numbered in sidebar order; the arrow keys walk 0..last (Preferences).
    property <int> last-page: Pages.preferences;

    background: Tokens.sidebar;
    animate background { duration: Tokens.normal; }

    // The hairline between the sidebar and the content.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tokens.stroke;
    }

    function go(page: int) {
        AppState.page = page;
    }
    // Menu map (page 10) sits between Context Menus and Menu Builder; Open with
    // (page 9) and Snippets (page 11) between Menu Builder and Config Editor.
    function next(page: int) -> int {
        if (page == Pages.menus) { return Pages.menumap; }
        if (page == Pages.menumap) { return Pages.builder; }
        if (page == Pages.builder) { return Pages.openwith; }
        if (page == Pages.openwith) { return Pages.snippets; }
        if (page == Pages.snippets) { return Pages.editor; }
        return min(root.last-page, page + 1);
    }
    function previous(page: int) -> int {
        if (page == Pages.builder) { return Pages.menumap; }
        if (page == Pages.menumap) { return Pages.menus; }
        if (page == Pages.editor) { return Pages.snippets; }
        if (page == Pages.snippets) { return Pages.openwith; }
        if (page == Pages.openwith) { return Pages.builder; }
        return max(0, page - 1);
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.go(root.previous(AppState.page));
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.go(root.next(AppState.page));
                return accept;
            }
            if (event.text == Key.Home) {
                root.go(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.go(root.last-page);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding-left: Tokens.s3;
            padding-right: Tokens.s3;
            padding-top: Tokens.s5;
            padding-bottom: Tokens.s3;
            spacing: 2px;

            // Header: logo, name, version.
            HorizontalLayout {
                padding-left: Tokens.s2;
                padding-bottom: Tokens.s5;
                spacing: Tokens.s3;
                Image {
                    source: Icons.logo;
                    width: 36px;
                    height: 36px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Nilesoft Shell Pro";
                        font-size: 15px;
                        font-weight: 600;
                        color: Tokens.text;
                    }
                    Text {
                        text: @tr("Version {}", AppState.app-version);
                        font-size: Tokens.caption;
                        color: Tokens.text-3;
                    }
                }
            }

            for entry in root.entries: VerticalLayout {
                spacing: 2px;
                if entry.header != "": HorizontalLayout {
                    padding-left: Tokens.s3;
                    padding-top: Tokens.s3;
                    Text {
                        text: entry.header;
                        height: 28px;
                        vertical-alignment: center;
                        font-size: Tokens.caption;
                        font-weight: 600;
                        color: Tokens.text-3;
                    }
                }
                NavItem {
                    icon: entry.icon;
                    label: entry.label;
                    selected: AppState.page == entry.page;
                    show-focus: fs.has-focus && AppState.page == entry.page;
                    clicked => {
                        fs.focus();
                        root.go(entry.page);
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            if UpdateState.offered: UpdateNavHint {
                clicked => {
                    fs.focus();
                    root.go(Pages.home);
                }
            }

            // Shell's state: a coloured dot and one line (Home has the details).
            HorizontalLayout {
                padding-left: Tokens.s3;
                padding-right: Tokens.s3;
                padding-bottom: Tokens.s3;
                spacing: 10px;
                accessible-role: text;
                accessible-label: status-text.text;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Tokens.status-color(AppState.status.loaded ? AppState.status.health-kind : "neutral");
                        opacity: AppState.busy ? 0.4 : 1.0;
                        animate background { duration: Tokens.normal; }
                        animate opacity { duration: 600ms; easing: ease-in-out; }
                    }
                }
                status-text := Text {
                    horizontal-stretch: 1;
                    text: AppState.busy ? AppState.busy-label : AppState.status.loaded ? AppState.status.pill-text : @tr("Checking status…");
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            NavItem {
                icon: Icons.preferences;
                label: @tr("Preferences");
                selected: AppState.page == Pages.preferences;
                show-focus: fs.has-focus && AppState.page == Pages.preferences;
                clicked => {
                    fs.focus();
                    root.go(Pages.preferences);
                }
            }
        }
    }
}
