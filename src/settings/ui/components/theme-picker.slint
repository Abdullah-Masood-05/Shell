// The five theme cards (Auto, Modern, Classic, White, Black), each a real mini
// menu drawn with that theme over the wallpaper. Used by the Appearance page and
// the first-run dialog. One radio group: Tab focuses it, the arrow keys move the
// selection, a click picks a card.

import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { PreviewTheme } from "../preview/preview-types.slint";
import { MiniMenu } from "../preview/menu-preview.slint";
import { AppearanceState } from "../pages/appearance-state.slint";

// Names and one-line descriptions of the five themes (ThemeModel.cpp has the values).
export global ThemeInfo {
    out property <[string]> names: [@tr("Theme name" => "Auto"), @tr("Theme name" => "Modern"), @tr("Theme name" => "Classic"), @tr("Theme name" => "White"), @tr("Theme name" => "Black")];
    out property <[string]> tags: [
        @tr("Like Windows' own menu"),
        @tr("Rounded · roomy"),
        @tr("Compact · blue highlight"),
        @tr("Always light"),
        @tr("Always dark"),
    ];
    out property <[string]> about: [
        @tr("Copies Windows' own menu, light or dark as Dark mode says."),
        @tr("Rounded menu and items with roomy rows, light or dark as Dark mode says."),
        @tr("Compact rows with a blue highlight, light or dark as Dark mode says."),
        @tr("The Modern shape, always light."),
        @tr("The Modern shape, always dark."),
    ];
}

component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <string> caption;
    in property <PreviewTheme> t;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> focused;     // the group has keyboard focus and this is its current card
    callback clicked;

    height: root.caption != "" ? 136px : 114px;
    border-radius: Tokens.radius-lg;
    border-width: root.selected || root.focused ? 2px : 1px;
    border-color: root.focused ? Tokens.focus-ring : root.selected ? Tokens.accent : ta.has-hover && root.enabled ? Tokens.stroke-strong : Tokens.stroke;
    background: root.selected ? Tokens.accent-soft.mix(Tokens.layer-2, 0.5) : ta.has-hover && root.enabled ? Tokens.layer-3 : Tokens.layer-2;
    opacity: root.enabled ? 1 : 0.6;
    animate background, border-color { duration: Tokens.fast; easing: ease-out; }
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-description: root.caption;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    VerticalLayout {
        padding: 5px;
        spacing: 6px;
        Rectangle {
            height: 78px;
            border-radius: Tokens.radius-sm;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: AppearanceState.wallpaper;
                image-fit: cover;
            }
            MiniMenu {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                t: root.t;
                icon-font: AppearanceState.icon-font;
                blurred: AppearanceState.wallpaper-blurred;
            }
        }
        VerticalLayout {
            padding-left: 5px;
            padding-right: 3px;
            spacing: 1px;
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1;
                    text: root.label;
                    font-size: 13px;
                    font-weight: 600;
                    color: Tokens.text;
                    vertical-alignment: center;
                }
                if root.selected: Image {
                    source: Icons.ok;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.accent;
                }
            }
            if root.caption != "": Text {
                text: root.caption;
                font-size: Tokens.caption;
                color: Tokens.text-2;
                overflow: elide;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component ThemePicker inherits FocusScope {
    // `enabled` (FocusScope's own): false greys the cards out and takes them out of the tab order.
    in property <int> selected;          // 0 auto .. 4 black
    in property <bool> one-row;          // five in a row; else three and two
    callback picked(index: int);

    // Keyboard position: the selection, or the first card when nothing is selected.
    property <int> cursor: root.selected >= 0 && root.selected < 5 ? root.selected : 0;

    accessible-role: groupbox;
    accessible-label: @tr("Theme");

    function pick(i: int) {
        if (root.enabled && i >= 0 && i < 5) {
            root.picked(i);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
            root.pick(root.cursor - 1);
            return accept;
        }
        if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
            root.pick(root.cursor + 1);
            return accept;
        }
        if (event.text == Key.Home) {
            root.pick(0);
            return accept;
        }
        if (event.text == Key.End) {
            root.pick(4);
            return accept;
        }
        if (event.text == " " || event.text == Key.Return) {
            root.pick(root.cursor);
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        spacing: Tokens.s2;
        HorizontalLayout {
            spacing: Tokens.s2;
            for i in (root.one-row ? 5 : 3): ThemeCard {
                horizontal-stretch: 1;
                label: ThemeInfo.names[i];
                caption: root.one-row ? "" : ThemeInfo.tags[i];
                t: AppearanceState.card-themes[i];
                selected: root.selected == i;
                enabled: root.enabled;
                focused: root.has-focus && root.cursor == i;
                clicked => {
                    root.focus();
                    root.pick(i);
                }
            }
        }
        if !root.one-row: HorizontalLayout {
            spacing: Tokens.s2;
            for i in 2: ThemeCard {
                horizontal-stretch: 1;
                label: ThemeInfo.names[i + 3];
                caption: ThemeInfo.tags[i + 3];
                t: AppearanceState.card-themes[i + 3];
                selected: root.selected == i + 3;
                enabled: root.enabled;
                focused: root.has-focus && root.cursor == i + 3;
                clicked => {
                    root.focus();
                    root.pick(i + 3);
                }
            }
            // Keeps the second row's cards the size of the first row's.
            Rectangle {
                horizontal-stretch: 1;
            }
        }
    }
}
