// The unsaved-changes footer ("N unsaved changes · Discard · Save") with the
// result of the last save, and the "use a personal config" prompt.

import { Spinner } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { SaveState } from "../save-state.slint";
import { CloseGlyph } from "banner.slint";
import { AppButton } from "controls.slint";

export component SaveFooter inherits Rectangle {
    property <bool> has-changes: SaveState.unsaved > 0;
    property <bool> has-result: SaveState.result-kind != "";

    height: SaveState.footer-height;
    clip: true;
    background: Tokens.layer;
    animate height { duration: Tokens.normal; easing: ease-out; }

    Rectangle {
        y: 0;
        height: 1px;
        background: Tokens.stroke;
    }

    HorizontalLayout {
        padding-left: Tokens.s6;
        padding-right: Tokens.s4;
        height: 56px;
        y: 0;
        spacing: Tokens.s3;

        // Unsaved count
        if root.has-changes || SaveState.saving: HorizontalLayout {
            spacing: Tokens.s2;
            if SaveState.saving: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 18px;
                    height: 18px;
                    indeterminate: true;
                }
            }
            if !SaveState.saving: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Tokens.warning;
                }
            }
            Text {
                text: SaveState.saving ? SaveState.saving-label : SaveState.unsaved == 1 ? "1 unsaved change" : SaveState.unsaved + " unsaved changes";
                font-weight: 600;
                color: Tokens.text;
                vertical-alignment: center;
            }
        }

        // Result of the last save
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.s2;
            if root.has-result && !SaveState.saving: VerticalLayout {
                alignment: center;
                Image {
                    source: Icons.status(SaveState.result-kind);
                    width: 16px;
                    height: 16px;
                    colorize: Tokens.status-color(SaveState.result-kind);
                }
            }
            if root.has-result && !SaveState.saving: Text {
                horizontal-stretch: 1;
                text: SaveState.result-text;
                color: SaveState.result-kind == "error" ? Tokens.danger : Tokens.text-2;
                vertical-alignment: center;
                overflow: elide;
            }
            if !root.has-result || SaveState.saving: Rectangle {
                horizontal-stretch: 1;
            }
        }

        if root.has-changes: VerticalLayout {
            alignment: center;
            AppButton {
                text: "Discard";
                enabled: !SaveState.saving;
                clicked => { SaveState.discard(); }
            }
        }
        if root.has-changes: VerticalLayout {
            alignment: center;
            AppButton {
                text: "Save  (Ctrl+S)";
                primary: true;
                enabled: !SaveState.saving;
                clicked => { SaveState.save(); }
            }
        }
        if !root.has-changes && root.has-result && !SaveState.saving: VerticalLayout {
            alignment: center;
            CloseGlyph {
                clicked => { SaveState.dismiss-result(); }
            }
        }
    }
}

// Shown when a save would write to the shared config in the install folder.
export component UserConfigPrompt inherits Rectangle {
    background: Tokens.scrim;
    TouchArea { }  // modal: swallow clicks

    Rectangle {
        width: min(480px, root.width - 48px);
        height: body.preferred-height;
        background: Tokens.layer;
        border-radius: Tokens.radius-lg;
        border-width: 1px;
        border-color: Tokens.stroke-strong;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Tokens.shadow;
        accessible-role: groupbox;
        accessible-label: "Use a personal config";

        body := VerticalLayout {
            padding: Tokens.s6;
            spacing: Tokens.s3;
            Text {
                text: "Use a personal config?";
                font-size: Tokens.subtitle;
                font-weight: 600;
                color: Tokens.text;
            }
            Text {
                text: "Shell is reading the shared config in its install folder, which this app never changes. Create a personal copy in %APPDATA%\\Nilesoft\\Shell (shell.exe -config:init); your changes are then saved there. It is kept per user and survives updates.";
                color: Tokens.text-2;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.s2;
                padding-top: Tokens.s2;
                AppButton {
                    text: "Cancel";
                    clicked => { SaveState.cancel-user-config(); }
                }
                AppButton {
                    text: "Create and save";
                    primary: true;
                    clicked => { SaveState.create-user-config(); }
                }
            }
        }
    }
}
