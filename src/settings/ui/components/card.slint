import { Tokens } from "../theme/tokens.slint";
import { AppButton } from "controls.slint";

// A card: a raised surface with an optional header row (icon, title, description and
// an action button on the right). Children are stacked vertically under it.
export component Card inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <image> icon;
    in property <string> action-label;
    in property <image> action-icon;
    in property <bool> action-enabled: true;
    in property <length> inner-padding: Tokens.s5;
    in property <length> inner-spacing: Tokens.s3;
    callback action();

    background: Tokens.layer;
    border-radius: Tokens.radius-card;
    border-width: 1px;
    border-color: Tokens.stroke;
    animate background { duration: Tokens.normal; }

    VerticalLayout {
        padding: root.inner-padding;
        spacing: root.inner-spacing;

        if root.heading != "": HorizontalLayout {
            spacing: Tokens.s3;
            padding-bottom: 2px;
            if root.icon.width > 0: VerticalLayout {
                alignment: start;
                padding-top: 1px;
                Image {
                    source: root.icon;
                    width: 20px;
                    height: 20px;
                    colorize: Tokens.text-2;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.heading;
                    font-size: Tokens.heading;
                    font-weight: 600;
                    color: Tokens.text;
                    accessible-role: text;
                }
                if root.description != "": Text {
                    text: root.description;
                    font-size: Tokens.caption;
                    color: Tokens.text-2;
                    wrap: word-wrap;
                }
            }
            if root.action-label != "": VerticalLayout {
                alignment: start;
                AppButton {
                    text: root.action-label;
                    icon: root.action-icon;
                    colorize-icon: true;
                    enabled: root.action-enabled;
                    clicked => { root.action(); }
                }
            }
        }
        @children
    }
}

// A label/value row used inside cards.
export component KeyValue inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <bool> mono;
    in property <color> value-color: Tokens.text;
    spacing: Tokens.s3;

    Text {
        text: root.key;
        width: 132px;
        font-size: Tokens.body;
        color: Tokens.text-2;
        vertical-alignment: top;
    }
    Text {
        text: root.value;
        horizontal-stretch: 1;
        font-size: root.mono ? Tokens.caption + 1px : Tokens.body;
        font-family: root.mono ? Tokens.mono : "";
        color: root.value-color;
        overflow: elide;
        vertical-alignment: center;
    }
}

// Section title between cards.
export component SectionTitle inherits Text {
    font-size: Tokens.heading;
    font-weight: 600;
    color: Tokens.text;
}
