import { Spinner } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";

// Breadcrumb ("Nilesoft Shell Pro / Home"), page title, description, and actions on the right
// (the children). Shows a spinner while an action is running. When the window is too narrow
// for the actions next to the description, they go under it (laid out by hand, like
// ActionHeader: a layout can't move a child from one row to another).
export component PageHeader inherits Rectangle {
    in property <string> section: "Nilesoft Shell Pro";
    in property <string> title;
    in property <string> description;
    in property <bool> busy;
    in property <string> busy-label;

    property <length> gap: Tokens.s4;
    property <bool> stacked: actions.preferred-width > 0 && root.width - actions.preferred-width - root.gap < 360px;
    property <length> row-height: max(text-col.min-height, actions.preferred-height);

    height: root.stacked ? text-col.min-height + Tokens.s3 + actions.preferred-height : root.row-height;

    text-col := VerticalLayout {
        x: 0px;
        y: root.stacked ? 0px : (root.row-height - self.height) / 2;
        width: root.stacked || actions.preferred-width == 0 ? root.width : root.width - actions.preferred-width - root.gap;
        height: self.min-height;
        spacing: Tokens.s1;

        // A quiet breadcrumb: where the page sits, not a second title.
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            padding-bottom: 2px;
            Text {
                text: root.section;
                font-size: Tokens.caption + 1px;
                color: Tokens.text-3;
            }
            Text {
                text: "\u{E76C}";
                font-family: "Segoe Fluent Icons";
                font-size: 8px;
                color: Tokens.text-3;
                vertical-alignment: center;
            }
            Text {
                text: root.title;
                font-size: Tokens.caption + 1px;
                color: Tokens.text-2;
            }
        }
        Text {
            text: root.title;
            font-size: Tokens.title;
            font-weight: 600;
            color: Tokens.text;
            accessible-role: text;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: Tokens.body;
            color: Tokens.text-2;
            wrap: word-wrap;
            min-height: self.preferred-height;
        }
    }

    actions := HorizontalLayout {
        x: root.stacked ? 0px : root.width - self.width;
        y: root.stacked ? text-col.min-height + Tokens.s3 : (root.row-height - self.height) / 2;
        width: min(self.preferred-width, root.width);
        height: self.preferred-height;
        spacing: Tokens.s4;

        if root.busy: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Tokens.s2;
                Spinner {
                    width: 20px;
                    height: 20px;
                    indeterminate: true;
                }
                Text {
                    text: root.busy-label;
                    vertical-alignment: center;
                    font-size: Tokens.caption + 1px;
                    color: Tokens.text-2;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Tokens.s2;
                @children
            }
        }
    }
}
