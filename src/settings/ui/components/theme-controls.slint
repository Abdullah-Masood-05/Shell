// Controls for editing theme keys: a labelled row with the override dot and a
// reset link, chips, a radius picker, sliders, a colour field with an HSV
// picker, palette swatches, a font picker and a padding/margin pair.
//
// Controls take their value through an `in` property and report edits through
// a callback; C++ validates and sends the new value back. Widgets that keep
// their own copy (the slider while dragging, SpinBox, LineEdit) are re-synced
// with `changed`.

import { LineEdit, SpinBox, ListView } from "std-widgets.slint";
import { Tokens } from "../theme/tokens.slint";
import { Icons } from "../theme/icons.slint";
import { ThemeField } from "../pages/appearance-state.slint";
import { AppState, Pages } from "../types.slint";
import { EditorState } from "../editor-types.slint";
import { Link } from "controls.slint";
import { Toggle } from "toggle.slint";

// Opens a file at a line in the Config Editor page.
export global EditorLink {
    public function open(file: string, line: int) {
        EditorState.open-at(file, line);
        AppState.page = Pages.editor;
    }
}

// The label column: name, override dot, where the value comes from, reset.
export component FieldLabel inherits VerticalLayout {
    in property <string> label;
    in property <ThemeField> field;
    in property <string> hint;
    in property <bool> strong;  // a card title
    callback reset();

    spacing: 2px;
    alignment: center;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.label;
            font-size: Tokens.body;
            font-weight: root.strong ? 600 : 400;
            color: root.field.locked ? Tokens.text-3 : Tokens.text;
            vertical-alignment: center;
        }
        if root.field.overridden || root.field.pending: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.field.overridden ? Tokens.accent : transparent;
                border-width: root.field.overridden ? 0px : 1.5px;
                border-color: Tokens.accent;
                accessible-role: text;
                accessible-label: root.field.overridden ? "Set by this app" : "Reset pending";
            }
        }
        if (root.field.overridden || root.field.pending) && !root.field.locked: Rectangle {
            width: reset-row.preferred-width + 8px;
            border-radius: Tokens.radius-sm;
            background: reset-ta.has-hover ? Tokens.hover : transparent;
            accessible-role: button;
            accessible-label: "Reset " + root.label + " to the file's value";
            accessible-action-default => { root.reset(); }
            reset-row := HorizontalLayout {
                x: 4px;
                spacing: 3px;
                alignment: center;
                Image {
                    source: Icons.restart;
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    colorize: Tokens.accent;
                }
                Text {
                    text: "Reset";
                    font-size: Tokens.caption;
                    color: Tokens.accent;
                    vertical-alignment: center;
                }
            }
            reset-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.reset(); }
            }
        }
    }
    Text {
        text: root.field.locked ? "Set by an expression · " + root.field.origin : root.hint != "" ? root.hint : root.field.origin;
        font-size: Tokens.caption;
        color: Tokens.text-3;
        wrap: word-wrap;
    }
    if root.field.locked && root.field.source-file != "": HorizontalLayout {
        alignment: start;
        Link {
            text: "Edit in Config Editor";
            font-size: Tokens.caption;
            activated => { EditorLink.open(root.field.source-file, root.field.source-line); }
        }
    }
    if root.field.error != "": Text {
        text: root.field.error;
        font-size: Tokens.caption;
        color: Tokens.danger;
        wrap: word-wrap;
    }
}

// Label on the left, control on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <ThemeField> field;
    in property <string> hint;
    in property <length> control-width: 220px;
    callback reset();

    spacing: Tokens.s4;
    padding-top: Tokens.s1;
    padding-bottom: Tokens.s1;

    FieldLabel {
        horizontal-stretch: 1;
        label: root.label;
        field: root.field;
        hint: root.hint;
        reset => { root.reset(); }
    }
    HorizontalLayout {
        width: root.control-width;
        alignment: end;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Label above, control below at full width.
export component SettingBlock inherits VerticalLayout {
    in property <string> label;
    in property <ThemeField> field;
    in property <string> hint;
    callback reset();

    spacing: Tokens.s2;
    padding-top: Tokens.s1;
    padding-bottom: Tokens.s1;

    FieldLabel {
        label: root.label;
        field: root.field;
        hint: root.hint;
        reset => { root.reset(); }
    }
    @children
}

// A thin divider between rows of a card.
export component RowDivider inherits Rectangle {
    height: 1px;
    background: Tokens.stroke;
}

// A group of choices in one well; the chosen one is filled with the accent.
export component ChipGroup inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback changed(index: int);

    height: 32px;
    min-width: row.min-width;
    border-radius: Tokens.radius-sm;
    background: Tokens.dark ? Tokens.sidebar : Tokens.layer-3;
    border-width: 1px;
    border-color: Tokens.stroke;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: tab-list;

    row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            min-width: label.preferred-width + 16px;
            horizontal-stretch: 1;
            border-radius: Tokens.radius-xs;
            background: i == root.selected ? Tokens.accent-fill : ta.has-hover && root.enabled ? Tokens.hover : transparent;
            animate background { duration: Tokens.fast; easing: ease-out; }
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.selected;
            accessible-action-default => { if (root.enabled) { root.changed(i); } }
            label := Text {
                text: option;
                font-size: 13px;
                font-weight: i == root.selected ? 600 : 400;
                color: i == root.selected ? Tokens.on-accent : ta.has-hover && root.enabled ? Tokens.text : Tokens.text-2;
            }
            ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { root.changed(i); }
            }
        }
    }
}

// The 0..4 radius step as five tiles showing 0/4/8/12/16 px corners.
export component RadiusSteps inherits HorizontalLayout {
    in property <int> selected;
    in property <bool> enabled: true;
    callback changed(step: int);

    property <[int]> px: [0, 4, 8, 12, 16];
    spacing: Tokens.s2;
    alignment: start;
    accessible-role: tab-list;

    for r[i] in root.px: Rectangle {
        width: 50px;
        height: 50px;
        border-radius: Tokens.radius-md;
        border-width: i == root.selected ? 2px : 1px;
        border-color: i == root.selected ? Tokens.accent : ta.has-hover ? Tokens.stroke-strong : Tokens.stroke;
        background: i == root.selected ? Tokens.accent-soft : Tokens.layer-2;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: tab;
        accessible-label: r + " pixels";
        accessible-item-selected: i == root.selected;
        accessible-action-default => { if (root.enabled) { root.changed(i); } }

        // A corner drawn at the real radius.
        Rectangle {
            x: 12px;
            y: 10px;
            width: 30px;
            height: 22px;
            clip: true;
            Rectangle {
                width: 44px;
                height: 36px;
                border-top-left-radius: r * 1px;
                border-width: 2px;
                border-color: i == root.selected ? Tokens.accent : Tokens.text-2;
            }
        }
        Text {
            y: parent.height - 15px;
            text: r + " px";
            font-size: 10px;
            color: i == root.selected ? Tokens.text : Tokens.text-2;
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.changed(i); }
        }
    }
}

// A slider with its value on the right. Reports whole steps. Drawn here rather
// than with the std Slider so it takes the app's accent.
export component ValueSlider inherits HorizontalLayout {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <string> unit;
    in property <bool> enabled: true;
    // The core picks the value (auto): `value` is its resolved default, shown as
    // "Auto (≈N)". Nothing is written until the user moves the slider, and then
    // even a move to the same number counts, so auto can be pinned to it.
    in property <bool> auto-value;
    callback changed(value: float);

    // The value shown while dragging; the model's value wins whenever it changes.
    property <float> shown: root.value;
    property <bool> touched;
    changed value => { root.shown = root.value; root.touched = false; }
    changed auto-value => { root.touched = false; }

    spacing: Tokens.s3;

    function set(v: float) {
        let s = clamp(Math.round(v / root.step) * root.step, root.minimum, root.maximum);
        if (s != root.shown || (root.auto-value && !root.touched)) {
            root.shown = s;
            root.touched = true;
            root.changed(s);
        }
    }

    track := Rectangle {
        horizontal-stretch: 1;
        min-width: 96px;
        height: 24px;
        property <length> knob: 18px;
        property <float> ratio: root.maximum > root.minimum ? clamp((root.shown - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
        opacity: root.enabled ? 1 : 0.5;

        accessible-role: slider;
        accessible-value: root.shown;
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-value-step: root.step;
        accessible-enabled: root.enabled;
        accessible-action-increment => { root.set(root.shown + root.step); }
        accessible-action-decrement => { root.set(root.shown - root.step); }

        // Rail and fill
        Rectangle {
            x: track.knob / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - track.knob;
            height: 4px;
            border-radius: 2px;
            background: Tokens.stroke-strong;
        }
        Rectangle {
            x: track.knob / 2;
            y: (parent.height - self.height) / 2;
            width: track.ratio * (parent.width - track.knob);
            height: 4px;
            border-radius: 2px;
            background: root.enabled ? Tokens.accent-fill : Tokens.text-3;
        }
        // Thumb: a light disc with an accent centre that grows under the pointer.
        Rectangle {
            x: track.ratio * (parent.width - track.knob);
            y: (parent.height - self.height) / 2;
            width: track.knob;
            height: track.knob;
            border-radius: self.width / 2;
            background: #FFFFFF;
            border-width: 1px;
            border-color: Tokens.stroke-strong;
            drop-shadow-blur: 4px;
            drop-shadow-color: Tokens.shadow;
            Rectangle {
                width: ta.pressed ? 8px : ta.has-hover ? 12px : 10px;
                height: self.width;
                border-radius: self.width / 2;
                background: root.enabled ? Tokens.accent-fill : Tokens.text-3;
                animate width { duration: Tokens.fast; easing: ease-out; }
            }
            if fs.has-focus: Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: self.width / 2;
                border-width: 2px;
                border-color: Tokens.focus-ring;
            }
        }

        fs := FocusScope {
            enabled: root.enabled;
            key-pressed(event) => {
                if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                    root.set(root.shown - root.step);
                    return accept;
                }
                if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                    root.set(root.shown + root.step);
                    return accept;
                }
                if (event.text == Key.Home) {
                    root.set(root.minimum);
                    return accept;
                }
                if (event.text == Key.End) {
                    root.set(root.maximum);
                    return accept;
                }
                return reject;
            }
        }
        ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            function at(x: length) {
                root.set(root.minimum + clamp((x - track.knob / 2) / (track.width - track.knob), 0, 1) * (root.maximum - root.minimum));
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    fs.focus();
                    self.at(self.mouse-x);
                }
            }
            moved => {
                if (self.pressed) {
                    self.at(self.mouse-x);
                }
            }
        }
    }
    Text {
        width: root.auto-value && !root.touched ? 92px : 56px;
        text: root.auto-value && !root.touched ? "Auto (≈" + root.shown + root.unit + ")" : root.shown + root.unit;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: Tokens.text-2;
        font-size: Tokens.body;
    }
}

// Two whole numbers: horizontal and vertical (padding, margin).
export component BoxField inherits HorizontalLayout {
    in property <float> horizontal;
    in property <float> vertical;
    in property <int> maximum: 40;
    in property <bool> enabled: true;
    callback changed(horizontal: float, vertical: float);

    spacing: Tokens.s2;
    changed horizontal => { h.value = root.horizontal; }
    changed vertical => { v.value = root.vertical; }

    Text {
        text: "↔";
        color: Tokens.text-2;
        vertical-alignment: center;
    }
    h := SpinBox {
        width: 96px;
        minimum: 0;
        maximum: root.maximum;
        value: root.horizontal;
        enabled: root.enabled;
        edited(x) => { root.changed(x, v.value); }
    }
    Text {
        text: "↕";
        color: Tokens.text-2;
        vertical-alignment: center;
    }
    v := SpinBox {
        width: 96px;
        minimum: 0;
        maximum: root.maximum;
        value: root.vertical;
        enabled: root.enabled;
        edited(x) => { root.changed(h.value, x); }
    }
}

// An on/off switch that follows its `on` value: a click asks for the change and
// C++ sends the new value back (see Toggle).
export component ToggleSwitch inherits HorizontalLayout {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(on: bool);

    alignment: end;
    VerticalLayout {
        alignment: center;
        Toggle {
            on: root.on;
            enabled: root.enabled;
            label: root.label;
            toggled(v) => { root.toggled(v); }
        }
    }
}

// A checkerboard behind translucent swatches.
component Checker inherits Rectangle {
    clip: true;
    background: #FFFFFF;
    for i in 240: Rectangle {
        x: mod(i, 40) * 6px;
        y: floor(i / 40) * 6px;
        width: 6px;
        height: 6px;
        background: mod(i + floor(i / 40), 2) == 0 ? #CCCCCC : #FFFFFF;
    }
}

// Saturation/value square, hue strip and (optionally) alpha strip.
export component ColorPicker inherits VerticalLayout {
    in-out property <float> hue;
    in-out property <float> sat;
    in-out property <float> val;
    in-out property <float> alpha: 1;
    in property <bool> show-alpha;
    in property <color> initial;  // read once: the popup's content is created on show()
    callback changed(value: color);

    init => {
        root.hue = root.initial.to-hsv().hue;
        root.sat = root.initial.to-hsv().saturation;
        root.val = root.initial.to-hsv().value;
        root.alpha = root.show-alpha ? root.initial.to-hsv().alpha : 1;
    }
    padding: Tokens.s3;
    spacing: Tokens.s3;

    function emit() { root.changed(hsv(root.hue, root.sat, root.val, root.alpha)); }

    sv := Rectangle {
        height: 150px;
        border-radius: Tokens.radius-sm;
        background: hsv(root.hue, 1, 1);
        Rectangle {
            border-radius: Tokens.radius-sm;
            background: @linear-gradient(90deg, #FFFFFF 0%, #FFFFFF00 100%);
        }
        Rectangle {
            border-radius: Tokens.radius-sm;
            background: @linear-gradient(0deg, #000000 0%, #00000000 100%);
        }
        Rectangle {
            x: root.sat * parent.width - 8px;
            y: (1 - root.val) * parent.height - 8px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 2px;
            border-color: #FFFFFF;
            background: hsv(root.hue, root.sat, root.val);
            drop-shadow-blur: 3px;
            drop-shadow-color: #00000080;
        }
        sv-ta := TouchArea {
            mouse-cursor: crosshair;
            function pick() {
                root.sat = clamp(self.mouse-x / self.width, 0, 1);
                root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                root.emit();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.pick();
                }
            }
            moved => { self.pick(); }
        }
    }
    Rectangle {
        height: 14px;
        border-radius: 7px;
        background: @linear-gradient(90deg, #FF0000 0%, #FFFF00 16.67%, #00FF00 33.33%, #00FFFF 50%, #0000FF 66.67%, #FF00FF 83.33%, #FF0000 100%);
        Rectangle {
            x: root.hue / 360 * (parent.width - 14px);
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #FFFFFF;
            background: hsv(root.hue, 1, 1);
            drop-shadow-blur: 3px;
            drop-shadow-color: #00000080;
        }
        TouchArea {
            mouse-cursor: pointer;
            function pick() {
                root.hue = clamp(self.mouse-x / self.width, 0, 1) * 359.9;
                root.emit();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.pick();
                }
            }
            moved => { self.pick(); }
        }
    }
    if root.show-alpha: Rectangle {
        height: 14px;
        border-radius: 7px;
        clip: true;
        Checker {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            background: @linear-gradient(90deg, hsv(root.hue, root.sat, root.val, 0) 0%, hsv(root.hue, root.sat, root.val, 1) 100%);
        }
        Rectangle {
            x: root.alpha * (parent.width - 14px);
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #FFFFFF;
            drop-shadow-blur: 3px;
            drop-shadow-color: #00000080;
        }
        TouchArea {
            mouse-cursor: pointer;
            function pick() {
                root.alpha = clamp(self.mouse-x / self.width, 0, 1);
                root.emit();
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    self.pick();
                }
            }
            moved => { self.pick(); }
        }
    }
}

// Swatch (opens the picker) and a hex box.
export component ColorField inherits HorizontalLayout {
    in property <color> value;
    in property <string> hex;           // the value as #RRGGBB[AA]
    in property <bool> show-alpha;
    in property <bool> enabled: true;
    callback changed(value: color);
    callback hex-entered(text: string);

    spacing: Tokens.s2;
    alignment: end;
    changed hex => { hex-edit.text = root.hex; }

    swatch := Rectangle {
        width: 32px;
        height: 32px;
        border-radius: Tokens.radius-sm;
        border-width: 1px;
        border-color: swatch-ta.has-hover && root.enabled ? Tokens.stroke-strong : Tokens.stroke;
        clip: true;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: button;
        accessible-label: "Pick a colour";
        accessible-action-default => { if (root.enabled) { popup.show(); } }
        Checker {
            width: 100%;
            height: 100%;
        }
        Rectangle {
            background: root.value;
        }
        swatch-ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { popup.show(); }
        }
    }
    hex-edit := LineEdit {
        width: 116px;
        text: root.hex;
        enabled: root.enabled;
        placeholder-text: "#RRGGBB";
        font-size: Tokens.body;
        accepted(t) => { root.hex-entered(t); }
    }

    popup := PopupWindow {
        x: swatch.x + swatch.width - 252px;
        y: swatch.y + swatch.height + 6px;
        width: 252px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tokens.layer;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.stroke-strong;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Tokens.shadow;
            ColorPicker {
                initial: root.value;
                show-alpha: root.show-alpha;
                changed(c) => { root.changed(c); }
            }
        }
    }
}

// The font family: a button in the font itself, opening a searchable list.
export component FontPicker inherits Rectangle {
    in property <string> value;
    in property <string> placeholder: "Segoe UI (menu default)";
    in property <[string]> fonts;
    in property <bool> enabled: true;
    callback filter(text: string);
    callback picked(name: string);

    height: 32px;
    border-radius: Tokens.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Tokens.stroke-strong : Tokens.stroke;
    background: Tokens.layer-2;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-label: "Font family";
    accessible-value: root.value;

    Text {
        x: 10px;
        width: parent.width - 36px;
        text: root.value != "" ? root.value : root.placeholder;
        font-family: root.value;
        font-size: Tokens.body;
        color: root.value != "" ? Tokens.text : Tokens.text-2;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 24px;
        text: "\u{E70D}";
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: Tokens.text-2;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.filter("");
            popup.show();
        }
    }

    popup := PopupWindow {
        y: root.height + 4px;
        width: root.width;
        height: 320px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tokens.layer;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.stroke-strong;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Tokens.shadow;
            VerticalLayout {
                padding: Tokens.s2;
                spacing: Tokens.s2;
                search := LineEdit {
                    placeholder-text: "Search installed fonts";
                    edited(t) => { root.filter(t); }
                    init => { self.focus(); }
                }
                ListView {
                    for name in root.fonts: Rectangle {
                        height: 30px;
                        border-radius: Tokens.radius-sm;
                        background: name == root.value ? Tokens.selected : row-ta.has-hover ? Tokens.hover : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: name;
                            font-family: name;
                            font-size: Tokens.body;
                            color: Tokens.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.picked(name);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// One colour of a palette: swatch, name and hex. A click makes it the current one
// (the row under the palette edits it) and opens the colour picker.
export component PaletteSwatch inherits Rectangle {
    in property <string> label;
    in property <ThemeField> field;
    in property <bool> show-alpha;
    in property <bool> enabled: true;
    in property <bool> current;
    callback picked();
    callback changed(value: color);

    min-width: 112px;
    height: 52px;
    border-radius: Tokens.radius-sm;
    border-width: 1px;
    border-color: root.current ? Tokens.accent-border : ta.has-hover ? Tokens.stroke : transparent;
    background: root.current ? Tokens.layer-2 : ta.has-hover ? Tokens.hover : transparent;
    animate background, border-color { duration: Tokens.fast; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label + ", " + root.field.display;
    accessible-description: root.field.locked ? "Set by an expression" : "Pick a colour";
    accessible-action-default => {
        root.picked();
        if (root.enabled) { popup.show(); }
    }

    HorizontalLayout {
        padding-left: Tokens.s2;
        padding-right: Tokens.s2;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            swatch := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: Tokens.stroke-strong;
                clip: true;
                opacity: root.enabled ? 1 : 0.5;
                Checker {
                    width: 100%;
                    height: 100%;
                }
                Rectangle {
                    background: root.field.color;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 5px;
                Text {
                    text: root.label;
                    font-size: 13px;
                    color: root.field.locked ? Tokens.text-3 : Tokens.text;
                    overflow: elide;
                }
                if root.field.overridden || root.field.pending: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: root.field.overridden ? Tokens.accent : transparent;
                        border-width: root.field.overridden ? 0px : 1.5px;
                        border-color: Tokens.accent;
                    }
                }
            }
            Text {
                text: root.field.display;
                font-size: Tokens.caption;
                color: Tokens.text-3;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
            if (root.enabled) { popup.show(); }
        }
    }

    // Right-aligned with the swatch, so the last column's picker stays in the window.
    popup := PopupWindow {
        x: min(0px, root.width - 252px);
        y: root.height + 6px;
        width: 252px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Tokens.layer;
            border-radius: Tokens.radius-lg;
            border-width: 1px;
            border-color: Tokens.stroke-strong;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Tokens.shadow;
            ColorPicker {
                initial: root.field.color;
                show-alpha: root.show-alpha;
                changed(c) => { root.changed(c); }
            }
        }
    }
}
