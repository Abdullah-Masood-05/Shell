import { Tokens } from "../theme/tokens.slint";

// Sidebar entry. The selected one is filled with the soft accent and its icon turns
// accent; hover and selection fade in.
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> show-focus; // keyboard focus is on this entry
    callback clicked;

    height: 38px;
    border-radius: Tokens.radius-sm;
    background: root.selected ? Tokens.accent-soft : ta.pressed ? Tokens.pressed : ta.has-hover ? Tokens.hover : transparent;
    animate background { duration: Tokens.fast; easing: ease-out; }

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    // The accent pill on the left edge grows in on selection.
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? 18px : 0px;
        y: (root.height - self.height) / 2;
        border-radius: 1.5px;
        background: Tokens.accent;
        animate height { duration: Tokens.normal; easing: ease-out; }
    }

    // The icon sits on whole physical pixels wherever the row is (the list scrolls, and
    // at 125 % or 175 % a logical pixel isn't a whole one), and its colour never changes:
    // the accent copy fades in over the plain one. Icons drawn at fractional positions
    // and recoloured on every frame of a fade came out in pieces after hovering
    // (2.2.0, 2.2.1).
    property <length> icon-size: round(20px / 1phx) * 1phx;
    property <length> icon-x: round((root.absolute-position.x + Tokens.s3) / 1phx) * 1phx - root.absolute-position.x;
    property <length> icon-y: round((root.absolute-position.y + (root.height - 20px) / 2) / 1phx) * 1phx - root.absolute-position.y;
    Image {
        x: root.icon-x;
        y: root.icon-y;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: Tokens.text-2;
        opacity: root.selected ? 0 : 1;
        animate opacity { duration: Tokens.fast; }
    }
    Image {
        x: root.icon-x;
        y: root.icon-y;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: Tokens.accent;
        opacity: root.selected ? 1 : 0;
        animate opacity { duration: Tokens.fast; }
    }

    HorizontalLayout {
        padding-left: Tokens.s3;
        padding-right: Tokens.s3;
        spacing: Tokens.s3;

        Rectangle { width: 20px; } // the icon's place
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: Tokens.body;
            font-weight: root.selected ? 600 : 400;
            color: root.selected || ta.has-hover ? Tokens.text : Tokens.text.mix(Tokens.text-2, 0.6);
            overflow: elide;
            animate color { duration: Tokens.fast; }
        }
    }

    if root.show-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: Tokens.focus-ring;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
