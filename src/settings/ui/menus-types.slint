// Context Menus and Menu Builder data shared with C++
// (src/ContextMenusController.cpp, src/MenuBuilderController.cpp).

import { CodeLine } from "editor-types.slint";

// One `import` line of the root shell.nss.
export struct ModuleRow {
    title: string,
    file: string,              // the import path as written ("imports/goto.nss")
    description: string,
    enabled: bool,
    changed: bool,             // differs from the file on disk
    locked: bool,
    lock-reason: string,
    path: string,              // absolute path of the root (for "open")
    line: int,
    own: bool,                 // the user's own file (not shipped): can be removed
}

// One entry of the taskbar menu's Apps submenu (imports/settings-app-taskbar.nss).
export struct TaskbarRow {
    kind: string,              // app | sep | other (written by hand, kept as is)
    title: string,
    detail: string,            // the program and its arguments, or the hand-written text
    enabled: bool,
    changed: bool,
    icon: image,
    has-icon: bool,
    problem: string,           // "The program isn't there", or ""
}

// The selected app, for the form under the list.
export struct TaskbarForm {
    kind: string,              // app | sep | other | "" (nothing selected)
    title: string,
    program: string,
    args: string,
    admin: bool,
    builtin: bool,             // one of the four apps Shell ships
}

// One app in the "Add an installed app" list.
export struct InstalledRow {
    name: string,
    detail: string,
    section: string,           // a heading to show above this row, or ""
    icon: image,
    has-icon: bool,
    added: bool,               // already in the list
}

// One modify(...)/remove(...) rule. `group` starts a new file section.
export struct RuleRow {
    group: string,             // the file label on the first rule of a file, else ""
    summary: string,           // one sentence: what it does to which items, and when
    where: string,
    enabled: bool,
    changed: bool,
    toggleable: bool,
    complex: bool,
    note: string,
    path: string,
    line: int,
}

export global MenusState {
    in property <bool> loaded;
    in property <string> load-error;
    in property <bool> shared-config;
    in property <[ModuleRow]> modules;
    in property <[RuleRow]> rules;
    in property <string> rules-caption;
    in property <int> dirty-count;
    in property <bool> saving;

    // Removing one of your own modules: the question.
    in property <int> remove-index: -1;    // the module asked about, -1 = no question
    in property <string> remove-title;
    in property <string> remove-file;      // "" = the file can't be deleted from here
    in-out property <bool> remove-delete;  // also delete the file

    // The taskbar menu's Apps submenu.
    in property <[TaskbarRow]> taskbar-rows;
    in property <int> taskbar-selected: -1;
    in property <TaskbarForm> taskbar-form;
    in property <int> taskbar-serial;      // bumped when the form must reload its fields
    in property <bool> taskbar-can-up;
    in property <bool> taskbar-can-down;
    in property <bool> taskbar-custom;     // the list is saved in its file (else: Shell's four)
    in property <bool> taskbar-is-default; // the list is Shell's four, as shipped
    in property <bool> taskbar-locked;     // read-only here
    in property <string> taskbar-error;    // the file doesn't read: it isn't written over
    in property <string> taskbar-notice;   // the taskbar menu doesn't use the list, and why
    in property <string> taskbar-file;     // the file's path, for "open"
    in property <string> taskbar-nss;      // imports/taskbar.nss's path, for "open"
    in property <[InstalledRow]> installed;
    in property <bool> installed-loading;
    in-out property <bool> picker-shown;
    in property <string> picker-filter;

    callback activated();
    callback toggle-module(index: int, on: bool);
    callback toggle-rule(index: int, on: bool);
    callback open-in-editor(path: string, line: int);
    callback save();
    callback discard();
    callback create-user-config();

    callback add-module();
    callback ask-remove-module(index: int);
    callback remove-module();              // the one asked about (remove-index)
    callback cancel-remove-module();

    callback taskbar-select(index: int);
    callback taskbar-toggle(index: int, on: bool);
    callback taskbar-move(delta: int);
    callback taskbar-remove();
    callback taskbar-set-text(field: string, value: string);
    callback taskbar-set-admin(on: bool);
    callback taskbar-browse();             // a new app from a file
    callback taskbar-browse-program();     // another program for the selected app
    callback taskbar-add-separator();
    callback taskbar-open-picker();
    callback taskbar-filter(text: string);
    callback taskbar-pick(index: int);
    callback taskbar-reset();              // back to Shell's four apps
}

// One row of the builder tree.
export struct BuilderRow {
    depth: int,
    kind: string,              // menu | item | separator
    title: string,
    glyph: string,             // a Nilesoft.Shell glyph, or ""
    summary: string,
}

// The selected entry, for the properties panel.
export struct BuilderNode {
    kind: string,              // menu | item | separator | "" (nothing selected)
    title: string,
    image: string,             // raw .nss
    glyph: string,
    location: int,             // menus::Location
    extensions: string,
    type: string,
    find: string,
    where: string,
    mode: int,                 // 0 default, 1 single, 2 multiple, 3 multi_unique, 4 multi_single, 5 none
    cmd: string,
    args: string,
    admin: bool,
    window: int,               // 0 normal, 1 hidden, 2 minimized, 3 maximized
    keys: string,
    tip: string,
    sep: int,                  // 0 none, 1 before, 2 after, 3 both
    extra: string,             // other properties, verbatim
}

// One row of the preview menu.
export struct PreviewRow {
    kind: string,              // menu | item | separator
    title: string,
    glyph: string,
    keys: string,
    selected: bool,
    open: bool,                // the menu whose flyout is shown
}

export global BuilderState {
    in property <bool> loaded;
    in property <string> load-error;
    in property <bool> shared-config;
    in property <string> notice;           // warnings from reading the file
    in property <bool> import-off;         // the file is imported but turned off
    in property <[BuilderRow]> rows;
    in property <int> selected: -1;
    in property <BuilderNode> node;
    in property <int> node-serial;         // bumped when the form must reload its fields
    in property <bool> can-up;
    in property <bool> can-down;
    in property <bool> can-indent;
    in property <bool> can-outdent;
    in property <[PreviewRow]> preview;
    in property <[PreviewRow]> flyout;
    in property <int> flyout-at: -1;       // index in `preview` of the open menu
    in property <int> flyout-offset;       // px from the top of the menu to that row
    in property <[CodeLine]> code;
    in property <int> code-columns: 60;
    in property <string> file-label;
    in property <[string]> glyphs;         // U+E000.. in the Nilesoft.Shell font
    in property <bool> dirty;
    in property <bool> saving;

    callback activated();
    callback select(index: int);
    callback add(kind: string);
    callback remove();
    callback duplicate();
    callback move-up();
    callback move-down();
    callback indent();
    callback outdent();
    callback set-text(field: string, value: string);
    callback set-flag(field: string, value: bool);
    callback set-choice(field: string, value: int);
    callback pick-glyph(index: int);       // -1: no icon
    pure callback glyph-code(index: int) -> string;  // "\uE0F3"
    callback save();
    callback discard();
    callback create-user-config();
    callback open-context-menus();
}
