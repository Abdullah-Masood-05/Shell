// Generated by CMake from res/settings.rc.in. The version comes from src/shared/Resource.h.
#include <winres.h>

#define IDI_APP 1

IDI_APP ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/app.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/res/settings.manifest"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SHELL_VERSION_MAJOR@,@SHELL_VERSION_MINOR@,@SHELL_VERSION_BUILD@,@SHELL_VERSION_REV@
 PRODUCTVERSION @SHELL_VERSION_MAJOR@,@SHELL_VERSION_MINOR@,@SHELL_VERSION_BUILD@,@SHELL_VERSION_REV@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nilesoft"
            VALUE "FileDescription", "Nilesoft Shell Pro"
            VALUE "FileVersion", "@SHELL_VERSION@"
            VALUE "InternalName", "NilesoftShellPro"
            VALUE "LegalCopyright", "Copyright (C) 2021-@SHELL_VERSION_YEAR@ Nilesoft Ltd."
            VALUE "OriginalFilename", "NilesoftShellPro.exe"
            VALUE "ProductName", "Nilesoft Shell Pro"
            VALUE "ProductVersion", "@SETTINGS_FULL_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
