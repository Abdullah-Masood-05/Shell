# Embeds presets/themes/*.nss into ThemePresetsData.inc (included by src/ThemePresets.cpp).
# Each file becomes one raw string literal; the files are configure dependencies, so
# editing, adding or removing a preset re-runs this on the next build.

set(THEME_PRESETS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/presets/themes")
set(THEME_PRESETS_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")

file(GLOB _preset_files CONFIGURE_DEPENDS "${THEME_PRESETS_DIR}/*.nss")
list(SORT _preset_files)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_preset_files})

set(_entries "")
foreach(_file IN LISTS _preset_files)
    get_filename_component(_id "${_file}" NAME_WE)
    # Without a UTF-8 BOM, with LF line endings.
    file(READ "${_file}" _bom LIMIT 3 HEX)
    if(_bom STREQUAL "efbbbf")
        file(READ "${_file}" _text OFFSET 3)
    else()
        file(READ "${_file}" _text)
    endif()
    string(REPLACE "\r" "" _text "${_text}")
    string(FIND "${_text}" ")nsspreset\"" _clash)
    if(NOT _clash EQUAL -1)
        message(FATAL_ERROR "${_file}: contains the raw string delimiter )nsspreset\"")
    endif()
    string(LENGTH "${_text}" _length)
    if(_length GREATER 16000)
        message(FATAL_ERROR "${_file}: a preset must stay under 16000 characters")
    endif()
    string(APPEND _entries "    { \"${_id}\", R\"nsspreset(${_text})nsspreset\" },\n")
endforeach()
if(_entries STREQUAL "")
    message(FATAL_ERROR "no theme presets in ${THEME_PRESETS_DIR}")
endif()

file(CONFIGURE OUTPUT "${THEME_PRESETS_GENERATED_DIR}/ThemePresetsData.inc" CONTENT
"// Generated by cmake/ThemePresets.cmake from presets/themes/*.nss. Do not edit.
#pragma once

struct EmbeddedPreset
{
    const char *id;
    const char *text;
};

constexpr EmbeddedPreset kEmbeddedPresets[] = {
@_entries@};
" @ONLY)
