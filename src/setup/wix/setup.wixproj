<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputPath>..\..\bin\</OutputPath>
    <TargetName>setup-$(Platform.ToLower().Replace('win32', 'x86'))</TargetName>
  </PropertyGroup>

  <!--
    The app, Nilesoft Shell Pro (NilesoftShellPro.exe), is built by CMake (src/settings),
    not by this solution. It goes into the x64 and ARM64 packages; ARM64 ships the x64 exe,
    which runs under emulation. Win32 has no app: its Start menu entry opens shell.exe.

    It is included only when the exe exists, so the core and the MSI still build on a
    machine without Rust or the Slint build; the build then prints a warning. CI and
    release builds pass -p:RequireAppExe=true, which turns the warning into an error
    so a package can't silently ship without it.

    Override the location with -p:AppExe=<path to NilesoftShellPro.exe>.
  -->
  <PropertyGroup>
    <AppExe Condition="'$(AppExe)' == ''">$(MSBuildThisFileDirectory)..\..\bin\NilesoftShellPro.exe</AppExe>
    <AppPlatform Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">true</AppPlatform>
    <IncludeApp Condition="'$(AppPlatform)' == 'true' and Exists('$(AppExe)')">true</IncludeApp>
    <DefineConstants Condition="'$(IncludeApp)' == 'true'">$(DefineConstants);AppExe=$(AppExe)</DefineConstants>
  </PropertyGroup>

  <Target Name="CheckAppExe" BeforeTargets="BeforeBuild" Condition="'$(AppPlatform)' == 'true' and '$(IncludeApp)' != 'true'">
    <Error Condition="'$(RequireAppExe)' == 'true'"
           Text="NilesoftShellPro.exe not found at '$(AppExe)'. Build it first (src\settings: cmake --preset x64-release, then cmake --build --preset x64-release; see src\settings\README.md) or pass -p:AppExe=&lt;path&gt;." />
    <Warning Condition="'$(RequireAppExe)' != 'true'"
             Text="NilesoftShellPro.exe not found at '$(AppExe)': building $(TargetName).msi WITHOUT the app. To include it, build src\settings first (see src\settings\README.md) and rebuild." />
  </Target>
</Project>
